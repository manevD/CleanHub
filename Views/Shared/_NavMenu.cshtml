@using CleanHub.Entities
@{
    var c = (ViewContext.RouteData.Values["controller"] as string ?? string.Empty).ToLowerInvariant();
    var a = (ViewContext.RouteData.Values["action"] as string ?? string.Empty).ToLowerInvariant();

    string On(string controller, params string[] actions) =>
        c == controller && (actions.Length == 0 || actions.Contains(a)) ? "is-active" : string.Empty;

    bool Open(string controller, params string[] actions) =>
        c == controller && (actions.Length == 0 || actions.Contains(a));

    var openBook = Open("bookfinancial");
    var openCreate = Open("documents", "create", "createforcustomer", "createcostforbuilding");
    var openBills = Open("documents", "index", "edit") || Open("invoices");
    var openCardsBuildings = Open("cards", "buildings", "buildingsfinance", "buildingsreserve", "buildinginvoice1200", "buildingsinvoice1200");
    var openCardsCustomers = Open("cards", "customers", "customersreserve");
}
<aside class="sidebar" id="sidebar" aria-label="Главна навигација">
    <div class="sidebar-brand">
        <a asp-action="Index" asp-controller="Buildings" class="brand-link">
            <img src="~/src/logo3.png" alt="Марти Хигиена" class="brand-logo" width="136" height="55" />
        </a>
        <button type="button" class="icon-btn sidebar-close" data-sidebar-close aria-label="Затвори">
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
        </button>
    </div>

    <nav class="side-nav">
        <span class="nav-label">Главно</span>

        <a asp-action="Index" asp-controller="Buildings" class="nav-item @On("buildings")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
            <span>Објекти</span>
        </a>
        <a asp-action="Index" asp-controller="Customers" class="nav-item @On("customers")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            <span>Партнери</span>
        </a>
        <a asp-action="Index" asp-controller="Products" class="nav-item @On("products")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
            <span>Продукти</span>
        </a>

        <span class="nav-label">Финансии</span>

        <details class="nav-group" open="@(openBook ? "open" : null)">
            <summary class="nav-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /><path d="M9 12h6M9 16h4" /></svg>
                <span>Книжења</span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="nav-sub">
                <a asp-action="Index" asp-controller="BookFinancial" asp-route-id="0" class="@On("bookfinancial", "index", "costs")">Книжења увид</a>
                @* ДЕМО: исклучено — за вклучување тргни го коментарот
                <a asp-action="LastInvoice" asp-controller="BookFinancial" class="@On("bookfinancial", "lastinvoice")">Залепи завршна</a>
                *@
            </div>
        </details>

        <a asp-action="Index" asp-controller="OnlinePayments" class="nav-item @On("onlinepayments")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /><path d="M16 15h2" /><path d="M6 15h4" /></svg>
            <span>Онлајн уплати</span>
            <span class="nav-badge" title="Треба да се постават">поставување</span>
        </a>

        <details class="nav-group" open="@(openCreate ? "open" : null)">
            <summary class="nav-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                <span>Креирај фактура</span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="nav-sub">
                <a asp-action="Create" asp-controller="Documents" asp-route-id="0">Збирна</a>
                <a asp-action="Create" asp-controller="Documents" asp-route-id="1">Поединечна</a>
                <a asp-action="CreateCostForBuilding" asp-controller="Documents" class="@On("documents", "createcostforbuilding")">Трошок</a>
                <a asp-action="CreateForCustomer" asp-controller="Documents" class="@On("documents", "createforcustomer")">Поединечна за станар</a>
            </div>
        </details>

        <details class="nav-group" open="@(openBills ? "open" : null)">
            <summary class="nav-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
                <span>Сметки</span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="nav-sub">
                <a asp-action="Index" asp-controller="Documents" class="@On("documents", "index", "edit")">По документ</a>
                <a asp-action="Index" asp-controller="Invoices" asp-route-id="@((int)InvoiceTyp.Energy)" class="@On("invoices")">Струја</a>
            </div>
        </details>

        <details class="nav-group" open="@(openCardsBuildings || openCardsCustomers ? "open" : null)">
            <summary class="nav-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /><line x1="6" y1="15" x2="10" y2="15" /></svg>
                <span>Картици</span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="nav-sub">
                <span class="nav-sub-label">Објекти</span>
                <a asp-action="Buildings" asp-controller="Cards" class="@On("cards", "buildings")">Картица на згради</a>
                <a asp-action="BuildingsFinance" asp-controller="Cards" class="@On("cards", "buildingsfinance")">Финансова картица</a>
                <a asp-action="BuildingsReserve" asp-controller="Cards" class="@On("cards", "buildingsreserve")">1201 Резервен фонд</a>
                <a asp-action="BuildingInvoice1200" asp-controller="Cards" class="@On("cards", "buildinginvoice1200")">1200 сите станари</a>
                <a asp-action="BuildingsInvoice1200" asp-controller="Cards" class="@On("cards", "buildingsinvoice1200")">1200 сите згради</a>
                <span class="nav-sub-label">Станари</span>
                <a asp-action="Customers" asp-controller="Cards" class="@On("cards", "customers")">1200</a>
                <a asp-action="CustomersReserve" asp-controller="Cards" class="@On("cards", "customersreserve")">1201</a>
            </div>
        </details>

        <span class="nav-label">AI алатки <span class="nav-badge">нов</span></span>

        <a asp-action="Assistant" asp-controller="Ai" class="nav-item @On("ai", "assistant")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z" /><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" /></svg>
            <span>Прашај ја апликацијата</span>
        </a>
        <a asp-action="Reminders" asp-controller="Ai" class="nav-item @On("ai", "reminders")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
            <span>Потсетници за долг</span>
        </a>
        <a asp-action="Anomalies" asp-controller="Ai" class="nav-item @On("ai", "anomalies")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            <span>Извештај за грешки</span>
        </a>
        <a asp-action="AnnualReport" asp-controller="Ai" class="nav-item @On("ai", "annualreport")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="17" x2="8" y2="13" /><line x1="12" y1="17" x2="12" y2="11" /><line x1="16" y1="17" x2="16" y2="15" /></svg>
            <span>Годишен извештај</span>
        </a>
    </nav>

    <div class="sidebar-foot">
        <button type="button" class="nav-cta" data-bs-toggle="modal" data-bs-target="#globalPayModal">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
            <span>Плати сметка</span>
        </button>
        <a asp-action="Help" asp-controller="Home" class="nav-item @On("home", "help")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            <span>Помош</span>
        </a>
    </div>
</aside>
