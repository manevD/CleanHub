@using CleanHub.Models
@{
    Layout = "_LandingLayout";
}
        <!-- Херо -->
        <section class="lp-hero">
            <div class="lp-wrap lp-hero-in">
                <div class="lp-hero-text">
                    <p class="lp-eyebrow">Чисто · Сигурно · Професионално</p>
                    <h1>Професионално чистење за вашата зграда и бизнис</h1>
                    <p class="lp-lead">Влезови во згради, канцеларии, локали и излози — и миење на високи и тешко достапни стакла со корпа до <strong>21 метар</strong>.</p>
                    <div class="lp-cta">
                        <a class="lp-btn lp-btn-primary lp-btn-lg" href="@LandingServices.PhoneHref">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
                            @LandingServices.Phone
                        </a>
                        <a class="lp-btn lp-btn-ghost lp-btn-lg" href="#pred-potoa">Види пред / потоа</a>
                    </div>
                    <ul class="lp-points">
                        <li>Флексибилни термини</li>
                        <li>Еднократно или договорно</li>
                        <li>Без траги и без заматување</li>
                    </ul>
                </div>
                <div class="lp-hero-media">
                    <img src="~/img/landing/worker.jpg" alt="Работник на Але Сауба мие стаклена врата" loading="eager" />
                    <div class="lp-badge-card">
                        <img src="~/img/landing/logo.png" alt="" width="54" height="54" />
                        <span><strong>Est. 2026</strong><small>Але Сауба – Ѓоргиеви</small></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Услуги -->
        <section class="lp-section" id="uslugi">
            <div class="lp-wrap">
                <h2 class="lp-h2">Со што се занимаваме</h2>
                <p class="lp-sub">Од влезот во зградата до излогот на вашиот локал.</p>
                <div class="lp-services">
                    @foreach (var s in LandingServices.All)
                    {
                        <a class="lp-service" href="/uslugi/@s.Slug">
                            <span class="lp-ico lp-ico-@s.Icon"><partial name="_LandingIcon" model="s.Slug" /></span>
                            <h3>@s.Title</h3>
                            <p>@s.Short</p>
                            <span class="lp-more">Повеќе за услугата →</span>
                        </a>
                    }
                </div>
            </div>
        </section>

        <!-- Пред / потоа -->
        <section class="lp-section lp-section-alt" id="pred-potoa">
            <div class="lp-wrap lp-ba-grid">
                <div>
                    <h2 class="lp-h2">Пред и потоа</h2>
                    <p class="lp-sub">Повлечете ја линијата лево–десно и видете ја разликата.</p>
                    <ul class="lp-check">
                        <li>Миење од двете страни</li>
                        <li>Висококвалитетна опрема</li>
                        <li>Професионален пристап</li>
                        <li>Долгорочна соработка</li>
                    </ul>
                </div>

                <div class="ba" id="beforeAfter" style="--pos: 50%">
                    <img class="ba-img" src="~/img/landing/after.jpg" alt="Излог по чистење" draggable="false" />
                    <div class="ba-before" aria-hidden="true">
                        <img class="ba-img" src="~/img/landing/before.jpg" alt="" draggable="false" />
                    </div>
                    <span class="ba-label ba-label-l">Пред</span>
                    <span class="ba-label ba-label-r">Потоа</span>
                    <div class="ba-handle" aria-hidden="true"><span></span></div>
                    <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Пред и потоа — повлечете лево или десно" />
                </div>
            </div>
        </section>

        <!-- Високи стакла -->
        <section class="lp-section">
            <div class="lp-wrap lp-split">
                <div class="lp-gallery">
                    <img src="~/img/landing/lift.jpg" alt="Миење стакла од корпа на висина" loading="lazy" />
                    <img src="~/img/landing/sigal.jpg" alt="Деловен објект со големи стакла" loading="lazy" />
                </div>
                <div>
                    <h2 class="lp-h2">Високи и тешко достапни стакла</h2>
                    <p class="lp-sub">Со корпа на висина <strong>до 21 метар</strong> — фасади, деловни објекти и згради, безбедно и без скелиња.</p>
                    <a class="lp-btn lp-btn-primary" href="/uslugi/visoki-stakla">Повеќе за високи стакла</a>
                    <a class="lp-btn lp-btn-ghost" href="@LandingServices.PhoneHref">Побарај понуда</a>
                </div>
            </div>
        </section>


@section Scripts {
    <script>
        // Пред / потоа: влечење со глувче/прст, тастатура преку range-полето
        (function () {
            const ba = document.getElementById('beforeAfter');
            if (!ba) return;
            const range = ba.querySelector('.ba-range');
            const set = v => { v = Math.max(0, Math.min(100, v)); ba.style.setProperty('--pos', v + '%'); range.value = v; };
            range.addEventListener('input', () => set(+range.value));
            let drag = false;
            const fromEvent = e => { const r = ba.getBoundingClientRect(); set(((e.clientX - r.left) / r.width) * 100); };
            ba.addEventListener('pointerdown', e => { drag = true; ba.setPointerCapture(e.pointerId); fromEvent(e); });
            ba.addEventListener('pointermove', e => { if (drag) fromEvent(e); });
            ['pointerup', 'pointercancel'].forEach(t => ba.addEventListener(t, () => { drag = false; }));

            // Кратка демонстрација кога ќе се појави на екранот
            if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
                const io = new IntersectionObserver(entries => {
                    if (!entries[0].isIntersecting) return;
                    io.disconnect();
                    const steps = [50, 25, 75, 50]; let i = 0;
                    ba.classList.add('ba-anim');
                    const t = setInterval(() => { if (drag || i >= steps.length) { clearInterval(t); ba.classList.remove('ba-anim'); return; } set(steps[i++]); }, 650);
                }, { threshold: .5 });
                io.observe(ba);
            }
        })();
    </script>
}
