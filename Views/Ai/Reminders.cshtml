@model CleanHub.ViewModels.AiRemindersViewModel
@using CleanHub.Services.Ai
@{
    ViewData["Title"] = "Потсетници за долг";
    var debtors = Model.Debtors;
    int Count(ReminderLevel l) => debtors.Count(d => d.Level == l);
    var selectedBuildingName = Model.Buildings?.FirstOrDefault(x => x.Selected)?.Text ?? "";
}
@Html.AntiForgeryToken()

<p class="page-lead">
    Станари со неплатени фактури. Нивото зависи од бројот на неплатени месеци:
    <span class="lvl lvl-1">Љубезно</span> 1 месец,
    <span class="lvl lvl-2">Потсетник</span> 2 месеци,
    <span class="lvl lvl-3">Опомена</span> 3 и повеќе.
    @if (!Model.AiEnabled)
    {
        <br /><span class="text-warning-soft">AI не е вклучен — пораките ќе се направат од готов шаблон.</span>
    }
</p>

<div class="stat-grid">
    <div class="stat-card"><span class="stat-label">Должници</span><span class="stat-value">@debtors.Count</span></div>
    <div class="stat-card"><span class="stat-label">Вкупен долг</span><span class="stat-value">@FinanceDataService.Money(debtors.Sum(d => d.UnpaidTotal))</span></div>
    <div class="stat-card"><span class="stat-label">Љубезно</span><span class="stat-value lvl-text-1">@Count(ReminderLevel.Polite)</span></div>
    <div class="stat-card"><span class="stat-label">Потсетник</span><span class="stat-value lvl-text-2">@Count(ReminderLevel.Reminder)</span></div>
    <div class="stat-card"><span class="stat-label">Опомена</span><span class="stat-value lvl-text-3">@Count(ReminderLevel.Warning)</span></div>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Reminders" class="toolbar">
            <div class="toolbar-field">
                <label class="form-label" for="buildingSearch">Објект</label>
                <div class="search-field">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    <input type="search" id="buildingSearch" class="form-control" list="buildingOptions" autocomplete="off"
                           placeholder="Пребарувај објект… (празно = сите)" value="@selectedBuildingName" />
                </div>
                <input type="hidden" id="buildingId" name="buildingId" value="@Model.BuildingId" />
                <datalist id="buildingOptions">
                    @if (Model.Buildings != null)
                    {
                        foreach (var b in Model.Buildings)
                        {
                            <option value="@b.Text" data-id="@b.Value"></option>
                        }
                    }
                </datalist>
            </div>
            <div class="toolbar-actions">
                <button type="button" class="btn btn-secondary" data-select="all">Избери ги сите</button>
                <button type="button" class="btn btn-secondary" data-select="3">Само опомени</button>
                <button type="button" class="btn btn-primary" id="btnGenerate">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z" /></svg>
                    Генерирај пораки
                </button>
            </div>
        </form>

        @if (debtors.Count == 0)
        {
            <div class="empty-state">Нема станари со неплатени фактури. 🎉</div>
        }
        else
        {
            <div class="list-toolbar">
                <div class="search-field list-search">
                    <input type="search" id="debtorSearch" class="form-control" placeholder="Пребарај станар, објект, телефон..." autocomplete="off" aria-label="Пребарај станар" />
                </div>
                <span class="text-muted small" id="debtorInfo"></span>
            </div>
            <div class="table-responsive">
                <table class="table" id="debtorsTable">
                    <thead>
                        <tr>
                            <th class="no-sort" style="width:36px"><input type="checkbox" class="form-check-input" id="checkAll" aria-label="Избери ги сите" /></th>
                            <th>Станар</th>
                            <th>Објект</th>
                            <th class="text-center">Месеци</th>
                            <th>Периоди</th>
                            <th class="text-end">Износ</th>
                            <th>Ниво</th>
                            <th>Контакт</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in debtors)
                        {
                            <tr data-level="@((int)d.Level)" data-search="@($"{d.CustomerInfo} {d.BuildingName} {d.PhoneNumber} {d.Email}".ToLowerInvariant())">
                                <td><input type="checkbox" class="form-check-input row-check" value="@d.CustomerId" aria-label="Избери @d.CustomerInfo" /></td>
                                <td><a href="/КартицаСтанари?customerId=@d.CustomerId" class="fw-semibold">@d.CustomerInfo</a></td>
                                <td>@d.BuildingName</td>
                                <td class="text-center">@d.UnpaidCount</td>
                                <td class="text-muted small">@string.Join(", ", d.Periods.Take(4))@(d.Periods.Count > 4 ? " …" : "")</td>
                                <td class="text-end fw-semibold">@FinanceDataService.Money(d.UnpaidTotal)</td>
                                <td><span class="lvl lvl-@((int)d.Level)">@FinanceDataService.LevelName(d.Level)</span></td>
                                <td class="text-nowrap">
                                    <span class="contact-dot @(string.IsNullOrWhiteSpace(d.Email) ? "is-off" : "")" title="@(d.Email ?? "Нема е-пошта")">@@</span>
                                    <span class="contact-dot @(string.IsNullOrWhiteSpace(d.PhoneNumber) ? "is-off" : "")" title="@(d.PhoneNumber ?? "Нема телефон")">☎</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="pager" id="debtorPager" aria-label="Страници"></nav>
        }
    </div>
</div>

<section id="messagesSection" class="mt-4" hidden>
    <div class="section-head">
        <h2 class="section-title m-0">Пораки за преглед</h2>
        <div class="d-flex gap-2 flex-wrap">
            <span class="text-muted small align-self-center" id="messagesInfo"></span>
            <button type="button" class="btn btn-success" id="btnSend">
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                Испрати е-пошта на сите означени
            </button>
            @if (Model.SmsEnabled)
            {
                <button type="button" class="btn btn-primary" id="btnSendSms">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                    Испрати SMS на сите означени
                </button>
            }
        </div>
    </div>
    <p class="text-muted small">Прегледајте ги и по потреба изменете ги пораките. „Е-пошта“ ја праќа само таа порака. Ако станарот нема е-пошта, внесете ја. „Viber“ ја копира целата порака и го отвора разговорот — само залепете (Ctrl+V).
        @if (Model.SmsEnabled)
        {
            <text>SMS се праќа преку Telnyx како <strong>@Model.SmsFrom</strong> — кратката порака, секогаш на латиница (поевтино); бројачот покажува колку SMS се наплаќаат.</text>
        }
        else
        {
            <text>Праќањето SMS преку Telnyx е исклучено во демото — копчето SMS ја отвора апликацијата за пораки на уредот.</text>
        }
    </p>
    <div id="messagesList" class="message-grid"></div>
    <nav class="pager" id="messagesPager" aria-label="Страници со пораки"></nav>
</section>

@section Scripts {
    <script>
        // Live пребарување на објект: при избор од листата веднаш се филтрира
        (function () {
            const search = document.getElementById('buildingSearch');
            const hidden = document.getElementById('buildingId');
            const options = Array.from(document.querySelectorAll('#buildingOptions option'));
            if (!search) return;
            const initial = hidden.value;

            function apply() {
                const text = search.value.trim().toLowerCase();
                const match = options.find(o => o.value.trim().toLowerCase() === text);
                const id = text === '' ? '' : (match ? match.getAttribute('data-id') : null);
                if (id === null || id === initial) return;
                hidden.value = id;
                search.form.submit();
            }

            search.addEventListener('input', () => { if (search.value.trim() !== '') apply(); });
            search.addEventListener('change', apply);
            search.addEventListener('search', apply); // копчето ✕ во полето го чисти филтерот
            search.addEventListener('keydown', e => {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                const text = search.value.trim().toLowerCase();
                if (text === '') { apply(); return; }
                const first = options.find(o => o.value.toLowerCase().includes(text));
                if (first) { search.value = first.value; apply(); }
            });
        })();

        // Едноставна пагинација: редовите остануваат во страната (изборот и праќањето работат за сите),
        // само се кријат оние што не се на тековната страна или не одговараат на пребарувањето.
        function mhPager(items, pagerEl, pageSize, onChange) {
            let page = 1, filtered = items();
            function pages() { return Math.max(1, Math.ceil(filtered.length / pageSize)); }
            function draw() {
                const all = items();
                if (page > pages()) page = pages();
                const start = (page - 1) * pageSize, end = start + pageSize;
                all.forEach(el => { el.hidden = true; });
                filtered.forEach((el, i) => { el.hidden = i < start || i >= end; });
                const n = pages();
                let html = '';
                if (n > 1) {
                    const btn = (p, label, dis, act) => '<button type="button" class="pager-btn' + (act ? ' is-active' : '') + '" data-page="' + p + '"' + (dis ? ' disabled' : '') + '>' + label + '</button>';
                    html += btn(page - 1, '‹', page === 1);
                    const show = new Set([1, n, page - 1, page, page + 1].filter(p => p >= 1 && p <= n));
                    let last = 0;
                    [...show].sort((a, b) => a - b).forEach(p => {
                        if (p - last > 1) html += '<span class="pager-gap">…</span>';
                        html += btn(p, p, false, p === page);
                        last = p;
                    });
                    html += btn(page + 1, '›', page === n);
                }
                pagerEl.innerHTML = html;
                if (onChange) onChange({ total: all.length, shown: filtered.length, from: filtered.length ? start + 1 : 0, to: Math.min(end, filtered.length) });
            }
            pagerEl.addEventListener('click', e => {
                const b = e.target.closest('[data-page]');
                if (!b || b.disabled) return;
                page = parseInt(b.dataset.page, 10);
                draw();
            });
            return {
                filter(fn) { filtered = items().filter(fn); page = 1; draw(); },
                refresh() { filtered = items(); page = 1; draw(); },
                redraw() { draw(); },
                visible() { return filtered; }
            };
        }

        (function () {
            const table = document.getElementById('debtorsTable');
            const checks = () => Array.from(document.querySelectorAll('.row-check'));
            const checkAll = document.getElementById('checkAll');
            const btnGenerate = document.getElementById('btnGenerate');
            const btnSend = document.getElementById('btnSend');
            const btnSendSms = document.getElementById('btnSendSms');
            const smsEnabled = @(Model.SmsEnabled ? "true" : "false");
            const section = document.getElementById('messagesSection');
            const list = document.getElementById('messagesList');
            const info = document.getElementById('messagesInfo');
            const esc = window.mhEscape;

            // Пребарување + страници за станарите (15 по страна)
            const debtorSearch = document.getElementById('debtorSearch');
            const debtorInfo = document.getElementById('debtorInfo');
            const rows = () => table ? Array.from(table.tBodies[0].rows) : [];
            const pager = table ? mhPager(rows, document.getElementById('debtorPager'), 15, s => {
                const sel = checks().filter(c => c.checked).length;
                debtorInfo.textContent = (s.shown ? s.from + '–' + s.to + ' од ' + s.shown : 'Нема резултати') +
                    (s.shown !== s.total ? ' (пребарано од ' + s.total + ')' : '') +
                    (sel ? ' · избрани: ' + sel : '');
            }) : null;
            const filteredChecks = () => pager ? pager.visible().map(r => r.querySelector('.row-check')).filter(Boolean) : checks();
            function updateInfo() { if (pager) pager.redraw(); }
            if (debtorSearch && pager) {
                let t;
                debtorSearch.addEventListener('input', () => {
                    clearTimeout(t);
                    t = setTimeout(() => {
                        const words = debtorSearch.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
                        pager.filter(r => words.every(w => (r.dataset.search || '').includes(w)));
                    }, 120);
                });
                pager.refresh();
            }
            if (table) table.addEventListener('change', e => { if (e.target.classList.contains('row-check')) updateInfo(); });

            // „Избери ги сите“ / „Само опомени“ важат за пребараните станари (сите страници)
            if (checkAll) checkAll.addEventListener('change', () => { filteredChecks().forEach(c => c.checked = checkAll.checked); updateInfo(); });
            document.querySelectorAll('[data-select]').forEach(btn => btn.addEventListener('click', () => {
                const mode = btn.getAttribute('data-select');
                filteredChecks().forEach(c => c.checked = mode === 'all' ? true : c.closest('tr').dataset.level === mode);
                updateInfo();
            }));

            function setBusy(btn, busy, text) {
                btn.disabled = busy;
                if (busy) { btn.dataset.label = btn.innerHTML; btn.innerHTML = '<span class="spinner"></span> ' + text; }
                else if (btn.dataset.label) { btn.innerHTML = btn.dataset.label; }
            }

            // Македонски број → меѓународен формат (+389...)
            function intlPhone(phone) {
                let p = (phone || '').replace(/[^\d+]/g, '');
                if (!p) return '';
                if (p.startsWith('00')) p = '+' + p.slice(2);
                else if (p.startsWith('389')) p = '+' + p;
                else if (p.startsWith('0')) p = '+389' + p.slice(1);
                else if (!p.startsWith('+')) p = '+389' + p;
                return p;
            }

            function smsLink(phone, text) {
                return 'sms:' + intlPhone(phone) + '?&body=' + encodeURIComponent(text);
            }

            function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
                return new Promise((resolve, reject) => {
                    const ta = document.createElement('textarea');
                    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
                    document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy') ? resolve() : reject(); } catch (e) { reject(e); } finally { ta.remove(); }
                });
            }

            // Кирилица → латиница (македонска транслитерација): SMS на латиница е до 2× поевтин
            const MK = { 'а':'a','б':'b','в':'v','г':'g','д':'d','ѓ':'gj','е':'e','ж':'zh','з':'z','ѕ':'dz','и':'i','ј':'j','к':'k','л':'l','љ':'lj','м':'m','н':'n','њ':'nj','о':'o','п':'p','р':'r','с':'s','т':'t','ќ':'kj','у':'u','ф':'f','х':'h','ц':'c','ч':'ch','џ':'dj','ш':'sh' };
            function toLatin(text) {
                return String(text || '')
                    .replace(/[„“”«»]/g, '"').replace(/[‘’]/g, "'").replace(/[–—]/g, '-').replace(/…/g, '...').replace(/№/g, 'br.').replace(/\u00A0/g, ' ')
                    .replace(/[\u0400-\u04FF]/g, ch => {
                    const low = ch.toLowerCase();
                    const t = MK[low];
                    if (t === undefined) return ch;
                    return ch === low ? t : t.charAt(0).toUpperCase() + t.slice(1);
                });
            }

            // Број на SMS делови: GSM-7 (латиница) 160/153 знаци, Unicode (кирилица) 70/67
            const GSM = /^[\n\r\x20-\x7E\x40£¥èéùìòÇØøÅåΔΦΓΛΩΠΨΣΘΞÆæßÉ¡ÄÖÑÜ§¿äöñüà€]*$/;
            function smsInfo(text) {
                text = String(text || '');
                if (!text) return { parts: 0, chars: 0, unicode: false };
                if (GSM.test(text)) {
                    const len = text.length + (text.match(/[\^{}\\\[~\]|€]/g) || []).length;
                    return { parts: len <= 160 ? 1 : Math.ceil(len / 153), chars: len, unicode: false };
                }
                const len = Array.from(text).length;
                return { parts: len <= 70 ? 1 : Math.ceil(len / 67), chars: len, unicode: true };
            }

            function setStatus(card, text, kind) {
                const st = card.querySelector('.msg-status');
                st.textContent = text;
                st.className = 'msg-status small' + (kind ? ' is-' + kind : '');
            }

            function itemFrom(card) {
                return {
                    customerId: parseInt(card.dataset.customerId, 10),
                    subject: card.querySelector('.msg-subject').value,
                    body: card.querySelector('.msg-body').value,
                    email: card.querySelector('.msg-email').value.trim(),
                    phoneNumber: card.querySelector('.msg-phone').value.trim(),
                    sms: card.querySelector('.msg-sms-text').value
                };
            }

            function applyResults(results, channel) {
                let ok = 0;
                results.forEach(r => {
                    const card = list.querySelector('.message-card[data-customer-id="' + r.customerId + '"]');
                    if (!card) return;
                    const label = channel === 'sms' ? 'SMS' : 'Е-пошта';
                    setStatus(card, r.sent ? label + ' пратено ✓' : label + ': ' + (r.error || 'Грешка'), r.sent ? 'ok' : 'err');
                    if (r.sent) {
                        ok++;
                        card.querySelector(channel === 'sms' ? '.sms-check' : '.send-check').checked = false;
                        card.classList.add('is-sent');
                    }
                });
                return ok;
            }

            function render(messages) {
                list.innerHTML = '';
                messages.forEach(m => {
                    const card = document.createElement('article');
                    card.className = 'message-card';
                    card.dataset.customerId = m.customerId;
                    const levelClass = m.level === 'Опомена' ? 3 : (m.level === 'Потсетник' ? 2 : 1);
                    const phone = intlPhone(m.phoneNumber);
                    card.innerHTML =
                        '<header class="message-head">' +
                            '<div><strong>' + esc(m.customerInfo) + '</strong> <span class="lvl lvl-' + levelClass + '">' + esc(m.level) + '</span>' +
                            (m.aiGenerated ? ' <span class="ai-chip">AI</span>' : ' <span class="ai-chip is-template">шаблон</span>') + '</div>' +
                            '<label class="form-check m-0" title="Вклучи во масовното праќање"><input type="checkbox" class="form-check-input send-check"> <span class="form-check-label small">за праќање</span></label>' +
                        '</header>' +
                        '<div class="msg-email-row"><input type="email" class="form-control form-control-sm msg-email" placeholder="Нема е-пошта — внесете адреса" aria-label="Е-пошта"></div>' +
                        '<input class="form-control form-control-sm msg-subject mb-2" aria-label="Наслов">' +
                        '<textarea class="form-control msg-body" rows="10" aria-label="Порака"></textarea>' +
                        '<div class="sms-box">' +
                            '<div class="sms-box-head">' +
                                '<label class="form-check m-0"><input type="checkbox" class="form-check-input sms-check"> <span class="form-check-label small fw-semibold">SMS</span></label>' +
                                '<input type="tel" class="form-control form-control-sm msg-phone" placeholder="Нема телефон — внесете број" aria-label="Телефон">' +
                            '</div>' +
                            '<textarea class="form-control form-control-sm msg-sms-text" rows="3" aria-label="SMS порака"></textarea>' +
                            '<div class="sms-box-foot">' +
                                '<span class="sms-counter small"></span>' +
                                '<span class="sms-latin-note small">латиница</span>' +
                                (smsEnabled ? '<button type="button" class="btn btn-sm btn-primary msg-sms-send">Прати SMS</button>' : '<a class="btn btn-sm btn-secondary msg-sms">Отвори SMS</a>') +
                            '</div>' +
                        '</div>' +
                        '<footer class="message-foot">' +
                            '<button type="button" class="btn btn-sm btn-primary msg-send">' +
                                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> Е-пошта</button>' +
                            '<button type="button" class="btn btn-sm btn-secondary msg-viber" title="' + (phone ? 'Ја копира пораката и го отвора Viber разговорот со ' + esc(phone) : 'Ја копира пораката и го отвора Viber') + '">Viber</button>' +
                            '<button type="button" class="btn btn-sm btn-ghost msg-copy">Копирај</button>' +
                            '<span class="msg-status small"></span>' +
                        '</footer>';

                    const emailInput = card.querySelector('.msg-email');
                    const sendCheck = card.querySelector('.send-check');
                    emailInput.value = m.email || '';
                    sendCheck.checked = !!m.email;
                    emailInput.addEventListener('input', () => { sendCheck.checked = emailInput.value.trim() !== ''; });
                    card.querySelector('.msg-subject').value = m.subject || '';
                    card.querySelector('.msg-body').value = m.body || '';

                    const phoneInput = card.querySelector('.msg-phone');
                    const smsText = card.querySelector('.msg-sms-text');
                    const smsCheck = card.querySelector('.sms-check');
                    phoneInput.value = m.phoneNumber || '';
                    smsText.value = m.sms || '';
                    smsCheck.checked = smsEnabled && !!m.phoneNumber;

                    const refreshSms = () => {
                        const info = smsInfo(toLatin(smsText.value)); // се праќа секогаш на латиница
                        const counter = card.querySelector('.sms-counter');
                        counter.textContent = info.chars + ' знаци · ' + info.parts + ' SMS' + (info.unicode ? ' (има посебни знаци)' : '');
                        counter.classList.toggle('is-costly', info.parts > 2);
                        const link = card.querySelector('.msg-sms');
                        if (link) link.href = phoneInput.value.trim() ? smsLink(phoneInput.value, smsText.value) : '#';
                    };
                    smsText.addEventListener('input', refreshSms);
                    phoneInput.addEventListener('input', () => { smsCheck.checked = smsEnabled && phoneInput.value.trim() !== ''; refreshSms(); });
                    // Ако се внесе кирилица, веднаш се претвора во латиница
                    smsText.addEventListener('blur', () => { const l = toLatin(smsText.value); if (l !== smsText.value) { smsText.value = l; refreshSms(); } });
                    refreshSms();

                    const smsSendBtn = card.querySelector('.msg-sms-send');
                    if (smsSendBtn) smsSendBtn.addEventListener('click', e => {
                        const item = itemFrom(card);
                        if (!item.phoneNumber) { setStatus(card, 'Внесете телефон', 'err'); phoneInput.focus(); return; }
                        item.sms = toLatin(item.sms);
                        const parts = smsInfo(item.sms).parts;
                        if (!confirm('Да се испрати SMS на ' + intlPhone(item.phoneNumber) + ' (' + parts + ' SMS)?')) return;
                        const btn = e.currentTarget;
                        setBusy(btn, true, 'Се праќа…');
                        mhPostJson('/Ai/SendSmsReminders', { items: [item] })
                            .then(r => applyResults(r, 'sms'))
                            .catch(err => setStatus(card, err.message, 'err'))
                            .finally(() => setBusy(btn, false));
                    });

                    card.querySelector('.msg-copy').addEventListener('click', () => {
                        copyText(card.querySelector('.msg-body').value)
                            .then(() => setStatus(card, 'Копирано ✓', 'ok'))
                            .catch(() => setStatus(card, 'Не може да се копира', 'err'));
                    });

                    // Viber не прима долг текст преку линк — затоа целата порака се копира,
                    // се отвора разговорот и само се залепува (Ctrl+V / држи → Залепи).
                    card.querySelector('.msg-viber').addEventListener('click', () => {
                        copyText(card.querySelector('.msg-body').value)
                            .then(() => {
                                setStatus(card, 'Копирано — во Viber залепете (Ctrl+V)', 'ok');
                                window.location.href = phone
                                    ? 'viber://chat?number=' + encodeURIComponent(phone)
                                    : 'viber://forward?text=';
                            })
                            .catch(() => setStatus(card, 'Не може да се копира', 'err'));
                    });

                    card.querySelector('.msg-send').addEventListener('click', e => {
                        const item = itemFrom(card);
                        if (!item.email) { setStatus(card, 'Внесете е-пошта', 'err'); emailInput.focus(); return; }
                        if (!confirm('Да се испрати пораката на ' + item.email + '?')) return;
                        const btn = e.currentTarget;
                        setBusy(btn, true, 'Се праќа…');
                        mhPostJson('/Ai/SendReminders', { items: [item] })
                            .then(applyResults)
                            .catch(err => setStatus(card, err.message, 'err'))
                            .finally(() => setBusy(btn, false));
                    });

                    list.appendChild(card);
                });

                const ai = messages.filter(m => m.aiGenerated).length;
                info.textContent = messages.length + ' пораки' + (ai ? ' · ' + ai + ' напишани со AI' : '');
                // Пораките по 6 на страна
                if (!list._pager) list._pager = mhPager(() => Array.from(list.querySelectorAll('.message-card')), document.getElementById('messagesPager'), 6);
                list._pager.refresh();
                section.hidden = false;
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            if (btnGenerate) btnGenerate.addEventListener('click', () => {
                const ids = checks().filter(c => c.checked).map(c => parseInt(c.value, 10));
                if (!ids.length) { alert('Изберете барем еден станар.'); return; }
                if (ids.length > 200) { alert('Максимум 200 станари одеднаш.'); return; }
                setBusy(btnGenerate, true, 'Се пишуваат пораките…');
                mhPostJson('/Ai/GenerateReminders', { customerIds: ids })
                    .then(render)
                    .catch(err => alert(err.message))
                    .finally(() => setBusy(btnGenerate, false));
            });

            if (btnSend) btnSend.addEventListener('click', () => {
                const cards = Array.from(list.querySelectorAll('.message-card'))
                    .filter(c => c.querySelector('.send-check').checked && c.querySelector('.msg-email').value.trim() !== '');
                if (!cards.length) { alert('Нема означени пораки со е-пошта.'); return; }
                if (!confirm('Да се испратат ' + cards.length + ' е-пораки?')) return;

                setBusy(btnSend, true, 'Се праќа…');
                mhPostJson('/Ai/SendReminders', { items: cards.map(itemFrom) })
                    .then(results => { info.textContent = 'Е-пошта пратени: ' + applyResults(results, 'email') + ' од ' + results.length; })
                    .catch(err => alert(err.message))
                    .finally(() => setBusy(btnSend, false));
            });

            if (btnSendSms) btnSendSms.addEventListener('click', () => {
                const cards = Array.from(list.querySelectorAll('.message-card'))
                    .filter(c => c.querySelector('.sms-check').checked && c.querySelector('.msg-phone').value.trim() !== '');
                if (!cards.length) { alert('Нема означени пораки со телефон.'); return; }
                const items = cards.map(itemFrom).map(i => Object.assign(i, { sms: toLatin(i.sms) }));
                const total = items.reduce((n, i) => n + smsInfo(i.sms).parts, 0);
                if (!confirm('Да се испратат SMS до ' + items.length + ' станари (вкупно ' + total + ' SMS)?')) return;

                setBusy(btnSendSms, true, 'Се праќа…');
                mhPostJson('/Ai/SendSmsReminders', { items })
                    .then(results => { info.textContent = 'SMS пратени: ' + applyResults(results, 'sms') + ' од ' + results.length; })
                    .catch(err => alert(err.message))
                    .finally(() => setBusy(btnSendSms, false));
            });
        })();
    </script>
}
