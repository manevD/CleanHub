@model CleanHub.ViewModels.BuildingViewModel

@{
    ViewData["Title"] = "Измени Објект";
}

<hr />
<div class="tab-content" id="animateLineContent-4">
    <div class="tab-pane fade show active" id="animated-underline-home" role="tabpanel" aria-labelledby="animated-underline-home-tab">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
                <form asp-action="Edit" class="section general-info">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="info">
                        <h6 class="">Информации за Објектот</h6>
                        <div class="row">
                            <div class="col-lg-11 mx-auto">
                                <div class="row">
                                    <div class="col-xl-10 col-lg-12 col-md-8 mt-md-0 mt-4">
                                        <div class="form">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Име на Објект</label>
                                                        <input asp-for="Name" class="form-control mb-3" />
                                                        <span asp-validation-for="Name" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Жиро Сметка</label>
                                                        <input asp-for="BankAccount" class="form-control mb-3" />
                                                        <span asp-validation-for="BankAccount" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <input type="submit" value="Зачувај" class="btn btn-primary" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
