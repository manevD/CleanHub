@inject Microsoft.Extensions.Options.IOptions<CleanHub.Config.SMTPConfig> SmtpOptions
@{
    var testRecipient = SmtpOptions.Value.TestRecipient;
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpperInvariant();
}
<header class="topbar">
    <button type="button" class="icon-btn topbar-menu" data-sidebar-open aria-label="Мени">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="14" y2="17" /></svg>
    </button>

    <div class="topbar-date" id="topbarDate"></div>

    @if (!string.IsNullOrWhiteSpace(testRecipient))
    {
        <span class="test-mode-pill" title="Сите е-пошти одат само на @testRecipient">
            ТЕСТ-РЕЖИМ · е-пошта → @testRecipient
        </span>
    }

    <div class="topbar-actions">
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Светла / темна тема" title="Светла / темна тема">
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>

        <div class="user-chip" title="@userName">
            <span class="avatar">@initial</span>
            <span class="user-name">@userName</span>
        </div>

        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Buildings", new { area = "" })" method="post" class="m-0">
            <button type="submit" class="btn btn-ghost btn-sm">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                <span>Одјави се</span>
            </button>
        </form>
    </div>
</header>
