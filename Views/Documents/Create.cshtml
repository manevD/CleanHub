@model CleanHub.ViewModels.DocumentViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var invoiceNotice = @Model.Company?.InvoiceNotice; // Safe navigation to handle null
    var plainTextNotice = string.IsNullOrEmpty(invoiceNotice)
        ? string.Empty
        : System.Text.RegularExpressions.Regex.Replace(invoiceNotice, "<.*?>", string.Empty);
    var routeId = @ViewBag.RouteId;
}
<div class="middle-content container-xxl p-0">
    <div class="row invoice layout-top-spacing layout-spacing">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="doc-container">
                <div class="row">
                    <div class="col-xl-9">
                        <div class="invoice-content">
                            <div class="invoice-detail-body">
                                <div class="invoice-detail-header">

                                    <div class="row justify-content-between">
                                        <div class="col-xl-5 invoice-address-company">

                                            <h4>Фирма:-</h4>

                                            <div class="invoice-address-company-fields">

                                                <div class="form-group row">
                                                    <label for="company-name" class="col-sm-3 col-form-label col-form-label-sm">Име</label>
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control form-control-sm" id="company-name" placeholder="Business Name" value="@Model.Company.Name">
                                                    </div>
                                                </div>

                                                <div class="form-group row">
                                                    <label for="company-email" class="col-sm-3 col-form-label col-form-label-sm">Е-Маил</label>
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control form-control-sm" id="company-email" placeholder="@Model.Company.Email" value="@Model.Company.Email">
                                                    </div>
                                                </div>

                                                <div class="form-group row">
                                                    <label for="company-address" class="col-sm-3 col-form-label col-form-label-sm">Адреса</label>
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control form-control-sm" id="company-address" placeholder="@Model.Company.Address" value="@Model.Company.Address">
                                                    </div>
                                                </div>

                                                <div class="form-group row">
                                                    <label for="company-phone" class="col-sm-3 col-form-label col-form-label-sm">Телефон</label>
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control form-control-sm" id="company-phone" placeholder="@Model.Company.PhoneNumber" value="@Model.Company.PhoneNumber">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xl-5 invoice-address-client">
                                            <h4>Сметка за:-</h4>
                                            <div class="invoice-address-client-fields">
                                                <div class="form-group row">
                                                    <label for="client-name" class="col-sm-3 col-form-label col-form-label-sm">Име</label>
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control form-control-sm" id="client-name" placeholder="Име на Фирмата/Станарот" value="@Model.Building?.Name">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (@Model?.Building != null)
                                {
                                    @Html.Partial("_BuildingProductsPartial", @Model)
                                }

                                <div class="invoice-detail-note">

                                    <div class="row">

                                        <div class="col-md-12 align-self-center">

                                            <div class="form-group row invoice-note">
                                                <label for="invoice-detail-notes" class="col-sm-12 col-form-label col-form-label-sm">Notes:</label>
                                                <div class="col-sm-12">
                                                    <textarea class="form-control" id="invoice-detail-notes" style="height: 200px;">
                                                        @plainTextNotice
                                                       </textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="invoice-actions">
                            <div class="invoice-action-currency">
                                <div class="form-group mb-0">
                                    <label>Објект</label>
                                    <div class="dropdown selectable-dropdown invoice-select">
                                        <form method="GET" asp-action="LoadBuildingProducts" asp-controller="Documents" asp-route-id="@routeId">
                                            <input type="hidden" name="id" value="@routeId" />
                                            <select id="buildingSelect" name="buildingId" class="form-control" onchange="this.form.submit()">
                                                @foreach (var building in Model?.Buildings)
                                                {
                                                    var isSelected = Model.Building != null && building.Id == Model.Building.Id;
                                                    <option value="@building.Id" selected="@isSelected">
                                                        @building.Name
                                                    </option>
                                                }
                                            </select>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="invoice-actions-btn">
                                <div class="invoice-action-btn">
                                    <div class="row">
                                        <div class="col-xl-12 col-md-4">
                                            <a href="javascript:void(0);" class="btn btn-success btn-download">Save</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
