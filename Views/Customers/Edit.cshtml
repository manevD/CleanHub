@model CleanHub.ViewModels.CustomerViewModel        

@{
    ViewData["Title"] = "Измени Партнер";
    var errors = ViewBag.Errors as List<string>;
    var showModal = ViewBag.ShowErrorModal ?? false;
}

@if (showModal && errors != null && errors.Any())
{
    @await Html.PartialAsync("Error", errors)
}
<hr />

<div class="tab-content" id="animateLineContent-4">
    <div class="tab-pane fade show active" id="animated-underline-home" role="tabpanel" aria-labelledby="animated-underline-home-tab">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
                <form class="section general-info" asp-action="Edit" id="customerForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="info">
                        <div class="row">
                            <div class="col-lg-11 mx-auto">
                                <div class="row">
                                    <div class="col-xl-10 col-lg-12 col-md-8 mt-md-0 mt-4">
                                        <div class="form">
                                            <div class="row">
                                                <h6 class="">Информации за Партнер</h6>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Информации</label>
                                                        <input asp-for="CustomerInfo" type="text" class="form-control mb-3" id="CustomerInformation" placeholder="Информации">
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Дејност</label>
                                                        <select asp-for="ActivityId" class="form-select mb-3" asp-items="ViewBag.ActivityId"></select>
                                                        <span asp-validation-for="ActivityId" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Адреса</label>
                                                        <input asp-for="Adress" type="text" class="form-control mb-3" id="Adress" placeholder="Адреса">
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Телефон</label>
                                                        <input asp-for="PhoneNumber" type="text" class="form-control mb-3" id="PhoneNumber" placeholder="Телефонски Број">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Е - Маил</label>
                                                        <input asp-for="Email" type="text" class="form-control mb-3" id="Email" placeholder="Е - Маил">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Веб</label>
                                                        <input asp-for="Web" type="text" class="form-control mb-3" id="Web" placeholder="Веб">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Објект </label>
                                                        <select asp-for="BuildingId" class="form-control mb-3" asp-items="ViewBag.BuildingId"></select>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Опис</label>
                                                        <input asp-for="PartnerOpis" class="form-control mb-3" id="PartnerOpis"/>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <label>Физичко Лице</label>
                                                        <input type="checkbox" class="form-check-input" id="PhysicalPerson"
                                                               name="PhysicalPerson" value="true" @(Model.PhysicalPerson == true ? "checked" : "")/>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="Inactive"
                                                               name="Inactive" value="true" @(Model.Inactive == true ? "checked" : "") />
                                                        <label class="form-check-label" for="Inactive">Неактивен</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="Garage"
                                                               name="Garage" value="true" @(Model.Garage == true ? "checked" : "") />
                                                        <label class="form-check-label">Со гаража</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label asp-for="InactiveDatum">Неактивен од</label>
                                                        <input asp-for="InactiveDatum" type="date" class="form-control mb-3" id="InactiveDatum" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label asp-for="ActiveDatum">Aктивен од</label>
                                                        <input asp-for="ActiveDatum" type="date" class="form-control mb-3" id="ActiveDatum" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label asp-for="Subscription">Во претплата</label>
                                                        <input asp-for="Subscription" type="number" class="form-control mb-3" id="Subscription" />
                                                    </div>
                                                </div>

                                                <div class="col-md-12 mt-1">
                                                    <div class="form-group text-end">
                                                        <input type="submit" value="Зачувај" class="btn btn-primary"/>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
              document.addEventListener('DOMContentLoaded', function () {
            var inactiveCheckbox = document.getElementById('Inactive');
            var inactiveDatumInput = document.getElementById('InactiveDatum');
            var activDatumInput = document.getElementById('ActiveDatum');   
            function toggleInactiveDatum() {
                inactiveDatumInput.readOnly = !inactiveCheckbox.checked;
                activDatumInput.readOnly = inactiveCheckbox.checked;
                inactiveDatumInput.classList.toggle('bg-light', !inactiveCheckbox.checked);
            }

            toggleInactiveDatum(); // initial state
            inactiveCheckbox.addEventListener('change', toggleInactiveDatum);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}