@model CleanHub.ViewModels.BuildingViewModel

@{
    ViewData["Title"] = "Објект Детали";
}

<div class="row">
    <div class="col-xl-66 col-lg-12 col-md-12 col-sm-12">
        <div class="user-profile">
            <div class="widget-content widget-content-area">
                <div class="text-center user-info">
                    <h2 class="">@Model.Name</h2>
                    <div class="user-info-list">
                        <div class="text-center user-info">
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="mt-2 edit-profile"> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></a>

                            <ul class="list-unstyled">
                                <li class="contacts-block__item">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-map-pin me-3"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> @Model.Name
                                </li>
                                <li class="contacts-block__item">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-credit-card"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg> @Model.BankAccount
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  
    <h1></h1>

    @if (Model.Customers.Any())
    {
        <form asp-controller="Buildings" asp-action="SendInvoiceEmail" autocomplete="off" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="row">
                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="form-group mb-0">
                        <p>За Месец </p>
                        <input id="month" name="month" min="1" max="12" placeholder="Внесете месец" type="text" class="form-control" value="@ViewBag.Month" />
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <p>За година</p>
                    <div class="form-group mb-0">
                        <input id="year" name="year" min="2000" max="2100" placeholder="Внесете година" type="text" class="form-control" value="@ViewBag.Year" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
                    <p>Испрати </p>
                    <div class="form-group mb-0">
                        <button type="submit" class="form-control btn btn-primary">Испрати</button>
                    </div>
                </div>
            </div>
        </form>
        <h1></h1>
        @Html.Partial("_CustomersPartial", Model.Customers.ToList())
    }
</div>
                          
