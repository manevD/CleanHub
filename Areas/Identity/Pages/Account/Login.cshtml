@page
@model LoginModel

@{
    ViewData["Title"] = "Најава";
}

<div class="auth-card">
    <img src="~/src/logo3.png" alt="Марти Хигиена" class="auth-logo" width="160" height="64" />
    <h1 class="auth-title">Добредојдовте</h1>
    <p class="auth-sub">Најавете се за да продолжите</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="form-group mb-3">
            <label asp-for="Input.Email" class="form-label">Е-пошта</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ime@primer.mk" autofocus />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Input.Password" class="form-label">Лозинка</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <button id="login-submit" type="submit" class="btn btn-lg btn-primary">Најави се</button>
    </form>

    <p class="auth-foot">© @DateTime.Now.Year Марти Хигиена</p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
