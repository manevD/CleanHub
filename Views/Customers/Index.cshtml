@model IEnumerable<CleanHub.ViewModels.CustomerViewModel>
@{
    ViewData["Title"] = "Партнер Листа";
}

<hr />

<div class="col-lg-12 col-md-12 layout-spacing">
    <p>
        <a class="btn btn-primary" asp-action="Create">Креирај Партнер</a>
    </p>
    </br>

    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            Информации
                        </th>
                        <th>
                            Адреса
                        </th>
                        <th>
                            Телефон
                        </th>
                        <th>
                            Е-Маил
                        </th>
                        <th>
                            Во претплата
                        </th>
                        <th>
                            Неактивен
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.CustomerInfo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Adress)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PhoneNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Subscription)
                            </td>
                            <td>
                                @{
                                    bool inactiveValue = item.Inactive.HasValue ? item.Inactive.Value : false;
                                }
                                @Html.CheckBoxFor(modelItem => inactiveValue, new { @disabled = "disabled" })
                            </td>
                           
                            <td>
                                <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Details" asp-controller="Customers" asp-route-id="@item.Id">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </a>
                                <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Edit" asp-controller="Customers" asp-route-id="@item.Id"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></a>
                                <a class="badge badge-light-danger text-start action-delete" asp-action="Delete" asp-controller="Customers" asp-route-id="@item.Id"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
