<script>
    const createPaymentForm = document.getElementById("createPaymentForm");

    if (createPaymentForm) {
        let isSaving = false;

        createPaymentForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            // Спречи двоен клик / повторно испраќање додека се зачувува
            if (isSaving) return;

            if (!this.checkValidity()) {
                this.reportValidity();
                return;
            }

            isSaving = true;

            const submitButton = this.querySelector('button[type="submit"]');
            const originalText = submitButton ? submitButton.textContent : "Креирај плаќање";

            if (submitButton) {
                submitButton.disabled = true;
                submitButton.textContent = "Се зачувува...";
            }

            try {
                const formData = new FormData(this);

                const response = await fetch('/Documents/CreateBookFinancial', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const modalElement = document.getElementById("createPaymentModal");
                    const modal = bootstrap.Modal.getInstance(modalElement);

                    // Затвори ја формата само откако серверот ќе потврди успешно зачувување
                    if (modal) {
                        modal.hide();
                    }

                    this.reset();

                    // Освежи ја листата; корисникот може повторно да избере „Креирај плаќање“
                    window.location.reload();
                    return;
                }

                let message = "Се појави грешка при зачувување на плаќањето.";

                try {
                    const result = await response.json();
                    message = result.message || message;
                } catch {
                    // Одговорот не е JSON; користи ја стандардната порака
                }

                showSaldoErrorModal(message);
            } catch (error) {
                console.error("Error:", error);
                showSaldoErrorModal("Грешка во конекцијата.");
            } finally {
                // Ако зачувувањето не успеало, дозволи повторен обид
                isSaving = false;

                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.textContent = originalText;
                }
            }
        });
    }

    function showSaldoErrorModal(message) {

        let modalHtml = `
            <div class="modal fade" id="saldoErrorModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                Не може да се креира претплата
                            </h5>

                            <button type="button"
                                    class="btn-close btn-close-white"
                                    data-bs-dismiss="modal">
                            </button>
                        </div>

                        <div class="modal-body">
                            <div class="alert alert-danger mb-0">
                                ${message}
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Во ред
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        `;

        document.getElementById("saldoErrorModal")?.remove();

        document.body.insertAdjacentHTML("beforeend", modalHtml);

        const modalElement = document.getElementById("saldoErrorModal");
        const modal = new bootstrap.Modal(modalElement);

        modal.show();
    }
</script>
}