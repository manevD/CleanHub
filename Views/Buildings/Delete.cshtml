@model CleanHub.Entities.Building

@{
    ViewData["Title"] = "Избриши";
    var errors = ViewBag.Errors as List<string>;
    var showModal = ViewBag.ShowErrorModal ?? false;
}

@if (showModal && errors != null && errors.Any())
{
    @await Html.PartialAsync("Error", errors)
}
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
           Име
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
           Жиро Сметка
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BankAccount)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Избриши" class="btn btn-danger" /> |
    </form>
</div>
