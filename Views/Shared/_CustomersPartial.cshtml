@model List<CleanHub.ViewModels.CustomerViewModel>

<style>
    .table-container {
        overflow: auto !important; /* Ensure overflow is set to auto to allow scrolling */
        max-height: 400px; /* Set a maximum height for the container to trigger scrolling */
        /* You may need to adjust the maximum height based on your layout and content */
    }
</style>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    </br>
    <div class="statbox widget box box-shadow">
        <p>
            <a class="btn btn-primary" asp-action="CreateWithBuilding" asp-controller="Customers" asp-route-buildingId="@Model.Select(x=>x.BuildingId).FirstOrDefault()">Креирај Партнер</a>
        </p>
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                <tr>
                    <th>
                    </th>
                    <th>
                        Информации
                    </th>
                    <th>
                        Телефон
                    </th>
                    <th>
                        Е-Маил
                    </th>
                    <th>
                        Со гаража
                    </th>
                    <th>
                        Неактивен
                    </th>
                        <th>
                            Функции
                        </th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td></td>
                        <td>
                            @Html.DisplayFor(modelItem => customer.CustomerInfo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => customer.PhoneNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => customer.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => customer.Garage)
                        </td>
                        <td>
                                @Html.CheckBoxFor(modelItem => customer.Inactive, new { @disabled = "disabled" })
                        </td>
                        <td>
                            <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Details" asp-controller="Customers" asp-route-id="@customer.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </a>
                            <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Edit" asp-controller="Customers" asp-route-id="@customer.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            </a>
                            <a class="badge badge-light-danger text-start action-delete" asp-action="Delete" asp-controller="Customers" asp-route-id="@customer.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
 