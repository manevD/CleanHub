@model CleanHub.ViewModels.DocumentViewModel

@{
    DateTime currentDate = DateTime.Now;

    // Calculate the previous month
    DateTime previousMonthDate = currentDate.AddMonths(-1);

    // Format the previous month date
    string formattedPreviousMonth = previousMonthDate.ToString("MM/yyyy");
}
<div class="invoice-detail-items">
    <div class="table-responsive">
        <table class="table item-table">
            <thead>
                <tr>
                    <th>Опис</th>
                    <th class="">Ед.м</th>
                    <th class="text-right">Цена без ДДВ</th>
                    <th class="text-center">Цена</th>
                    <th class="text-center">Вк.распл.</th>
                    <th class="text-center">Вкупно</th>
                </tr>
                <tr aria-hidden="true" class="mt-3 d-block table-row-hidden"></tr>
            </thead>
            <tbody>
                @if (@Model?.Building != null && @Model.Building.BuildingProducts != null && @Model.Building.BuildingProducts.Any())
                {
                    @for (var i = 0; i < Model.Building.BuildingProducts.Count; i++)
                    {
                        <tr>
                            <td class="description">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].ArticleNotes @formattedPreviousMonth" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].UnitOfMeasurement" />
                            </td>

                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].Price" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].PriceWithTax" />
                            </td>
                            <td class="rate">
                                @{
                                    var product = Model.Building.BuildingProducts[i];
                                    var isSpecialProduct = product.ArticleNotes.Contains("Потрошена елект.") ||
                                    product.ArticleNotes.Contains("Комунална такса") ||
                                    product.ArticleNotes.Contains("лифт");
                                    var value = isSpecialProduct
                                    ? (product.PriceWithTax * Model.Building.Customers.Count)
                                    : 0;
                                }
                                <input type="text" class="form-control form-control-sm" value="@value" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].PriceWithTax" readonly />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@if (@Model.Building.BuildingProducts != null && @Model.Building.BuildingProducts.Any())
{
    <div class="invoice-detail-total" style="text-align: right;">
        <div class="invoice-summary-label" style="color:black;">Вкупно</div>
        <div class="invoice-summary-value">
            <div class="balance-due-amount">
                <span>@Model.Building.BuildingProducts.Sum(x => x.PriceWithTax)</span> <span class="currency">МКД</span>
            </div>
        </div>
    </div>
}