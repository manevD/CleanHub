@model CleanHub.ViewModels.AiAnnualReportViewModel
@using CleanHub.Services.Ai
@{
    ViewData["Title"] = "Годишен извештај за собрание";
    var r = Model.Report;
    var thisYear = DateTime.Now.Year;
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="AnnualReport" method="post" class="toolbar" id="annualForm">
            <div class="toolbar-field">
                <label class="form-label" for="buildingId">Објект</label>
                <select id="buildingId" name="buildingId" class="form-select" asp-items="Model.Buildings" required>
                    <option value="">— Изберете објект —</option>
                </select>
            </div>
            <div class="toolbar-field toolbar-field-sm">
                <label class="form-label" for="year">Година</label>
                <select id="year" name="year" class="form-select">
                    @for (var y = thisYear; y >= 2019; y--)
                    {
                        <option value="@y" selected="@(y == Model.Year ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
            <div class="toolbar-field toolbar-field-grow">
                <label class="form-label" for="notes">Белешки од управителот <span class="text-muted">(опционално)</span></label>
                <input id="notes" name="notes" class="form-control" value="@Model.Notes" maxlength="1000"
                       placeholder="Пр. Во април е заменет моторот на лифтот; следната година планираме фасада." />
            </div>
            <div class="toolbar-actions">
                <button type="submit" class="btn btn-primary" id="annualSubmit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z" /></svg>
                    Генерирај извештај
                </button>
            </div>
        </form>
        @if (!Model.AiEnabled)
        {
            <p class="text-warning-soft small mt-2 mb-0">AI не е вклучен — текстот ќе биде од готов шаблон, бројките се исти.</p>
        }
    </div>
</div>

@if (r != null)
{
    var s = r.Stats;
    <div class="section-head">
        <h2 class="section-title m-0">@s.BuildingName — @s.Year</h2>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" onclick="window.print()">Печати</button>
            <a class="btn btn-success" asp-action="AnnualReportPdf" asp-route-key="@Model.ReportKey">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Преземи PDF
            </a>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card"><span class="stat-label">Фактурирано</span><span class="stat-value">@FinanceDataService.Money(s.Invoiced)</span></div>
        <div class="stat-card"><span class="stat-label">Собрано (1200)</span><span class="stat-value">@FinanceDataService.Money(s.CollectedRegular)</span><span class="stat-sub">наплата @s.CollectionRate.ToString("0.#", FinanceDataService.Mk)%</span></div>
        <div class="stat-card"><span class="stat-label">Резервен фонд — собрано</span><span class="stat-value">@FinanceDataService.Money(s.CollectedReserve)</span></div>
        <div class="stat-card"><span class="stat-label">Резервен фонд — потрошено</span><span class="stat-value">@FinanceDataService.Money(s.ReserveCosts)</span></div>
        <div class="stat-card"><span class="stat-label">Состојба 31.12.@s.Year</span><span class="stat-value">@FinanceDataService.Money(s.ReserveBalanceEndOfYear)</span></div>
        <div class="stat-card"><span class="stat-label">Неплатено</span><span class="stat-value lvl-text-3">@FinanceDataService.Money(s.UnpaidTotal)</span><span class="stat-sub">@s.TenantsWithDebt станари</span></div>
    </div>

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Извештај</span>
                    <span class="ai-chip @(r.AiGenerated ? "" : "is-template")">@(r.AiGenerated ? "напишано со AI" : "шаблон")</span>
                </div>
                <div class="card-body report-text">@r.Narrative</div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="card h-100">
                <div class="card-header">Трошоци од резервен фонд (@s.Costs.Count)</div>
                @if (s.Costs.Count == 0)
                {
                    <div class="card-body text-muted">Нема трошоци за оваа година.</div>
                }
                else
                {
                    <div class="table-responsive table-container" style="max-height:520px">
                        <table class="table m-0">
                            <thead><tr><th>Датум</th><th>Опис</th><th class="text-end">Износ</th></tr></thead>
                            <tbody>
                                @foreach (var c in s.Costs)
                                {
                                    <tr><td class="text-nowrap">@c.Date?.ToString("dd.MM.yyyy")</td><td>@c.Description</td><td class="text-end text-nowrap">@FinanceDataService.Money(c.Amount)</td></tr>
                                }
                            </tbody>
                            <tfoot><tr><td colspan="2">Вкупно</td><td class="text-end text-nowrap">@FinanceDataService.Money(s.ReserveCosts)</td></tr></tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <p class="text-muted small mt-3">Бројките се пресметани од книжењата во апликацијата (иста логика како „Завршна“ и картиците). Текстот проверете го пред да го поделите со станарите.</p>
}

@section Scripts {
    <script>
        document.getElementById('annualForm').addEventListener('submit', function () {
            const b = document.getElementById('annualSubmit');
            b.disabled = true;
            b.innerHTML = '<span class="spinner"></span> Се подготвува…';
        });
    </script>
}
