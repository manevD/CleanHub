@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var controller = (ViewContext.RouteData.Values["controller"] as string ?? string.Empty).ToLowerInvariant();
    var action = (ViewContext.RouteData.Values["action"] as string ?? string.Empty).ToLowerInvariant();
    var page = (ViewContext.RouteData.Values["page"] as string ?? string.Empty).Trim('/').Replace('/', '-').ToLowerInvariant();
    var bodyClass = string.IsNullOrEmpty(page) ? $"c-{controller} a-{action}" : $"p-{page}";
    var title = ViewData["Title"] as string;
    if (string.IsNullOrEmpty(title))
    {
        title = (controller + "/" + action) switch
        {
            "buildings/index" => "Објекти",
            "customers/index" => "Партнери",
            "cards/buildings" => "Картица на згради",
            "cards/buildingsfinance" => "Финансова картица",
            "cards/buildingsreserve" => "1201 · Резервен фонд",
            "cards/buildinginvoice1200" => "1200 · Сите станари",
            "cards/buildingsinvoice1200" => "1200 · Сите згради",
            "cards/customers" => "Картица на станар · 1200",
            "cards/customersreserve" => "Картица на станар · 1201",
            "documents/create" => "Креирај фактура",
            "documents/createforcustomer" => "Фактура за станар",
            "documents/createcostforbuilding" => "Трошок за објект",
            "documents/edit" => "Измени документ",
            "home/help" => "Помош",
            _ => null
        };
    }
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="mk" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#059669">
    <title>@(string.IsNullOrEmpty(title) ? "Free Clean" : title + " · Free Clean")</title>
    <link rel="icon" href="~/favicon.ico">
    <script>try{var t=localStorage.getItem('mh-theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}</script>

    <!-- Vendor -->
    <link rel="stylesheet" href="~/src/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/src/plugins/src/table/datatable/datatables.css" asp-append-version="true" />
    <!-- Апликација: една единствена CSS датотека -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass @(signedIn ? "is-app" : "is-auth")">
    <div class="progress-bar-top" id="pageProgress" aria-hidden="true"></div>

    @if (signedIn)
    {
        <div class="app-shell">
            <partial name="_NavMenu" />
            <div class="sidebar-backdrop" data-sidebar-close></div>

            <div class="app-main">
                <partial name="_HeaderNav" />

                <main class="app-content" id="content">
                    @if (!string.IsNullOrEmpty(title) && title != "Home Page")
                    {
                        <div class="page-head">
                            <h1 class="page-title">@title</h1>
                        </div>
                    }
                    <div class="page-body">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    }
    else
    {
        <main class="auth-shell">
            @RenderBody()
        </main>
    }

    <div class="toast-stack" id="toastStack" aria-live="polite">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="app-toast is-success" role="status">@success</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="app-toast is-error" role="alert">@error</div>
        }
    </div>

    <!-- Скрипти (без defer, по редослед, за да работат и скриптите од поединечните страни) -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/src/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/src/plugins/src/flatpickr/flatpickr.js" asp-append-version="true"></script>
    <script src="~/src/plugins/src/table/datatable/datatables.js" asp-append-version="true"></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/dataTables.buttons.min.js" asp-append-version="true"></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/jszip.min.js" asp-append-version="true"></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/buttons.html5.min.js" asp-append-version="true"></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/buttons.print.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (signedIn)
    {
        <partial name="_GlobalPayModal" />
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
