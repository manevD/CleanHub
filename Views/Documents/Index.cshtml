@using System.Text.RegularExpressions
@using CleanHub.Entities.Enums
@using CleanHub.Extensions
@using CleanHub.ViewModels
@model List<CleanHub.ViewModels.DocumentViewModel>

@{
    ViewData["Title"] = "Сметки";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedItem = ((List<SelectListItem>)ViewBag.PaymentStatusList)
        .FirstOrDefault(x => x.Selected);

    int selectedValue = selectedItem != null
        ? int.Parse(selectedItem.Value)
        : -1;
}

<div class="container-fluid p-0">
    <div class="row">

        <!-- 🔹 SIDEBAR -->
        <div class="col-lg-2 col-md-3">
            <div class="card p-2 h-100" style="position: sticky; top:20px;">

                <form asp-action="InvoiceFiltered" asp-controller="Documents" method="get" id="filterForm">

                    <h5 class="mb-3">Филтер</h5>

                    @if (ViewBag.Buildings != null)
                    {
                        <div class="form-group mb-3">
                            <label>Објект</label>
                            <input class="form-control" list="buildingOptions" id="buildingSearch"
                                   name="buildingName" value="@ViewBag.SelectedBuildingName">

                            <input type="hidden" id="buildingId" name="buildingId" value="@ViewBag.BuildingId">

                            <datalist id="buildingOptions">
                                @foreach (var b in (IEnumerable<SelectListItem>)ViewBag.Buildings)
                                {
                                    <option value="@b.Text" data-id="@b.Value"></option>
                                }
                            </datalist>
                        </div>
                    }

                    @if (ViewBag.PaymentStatusList != null)
                    {
                        <div class="form-group mb-3">
                            <label>Статус</label>
                            @Html.DropDownList("paymentStatusId",
                                 (IEnumerable<SelectListItem>)ViewBag.PaymentStatusList,
                                 new { @class = "form-control", id = "paymentStatusId" })
                        </div>
                    }

                    <div class="form-group mb-3">
                        <label>Година</label>
                        <select name="year" class="form-control">
                            @{
                                var currentYear = DateTime.Now.Year;
                                @for (int y = currentYear; y >= 2019; y--)
                                {
                                    <option value="@y" selected="@(ViewBag.Year == y ? "selected" : null)">
                                        @y
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        Пребарувај
                    </button>

                    <button type="button" class="btn btn-secondary w-100" id="navigateButton">
                        Извади сметки
                    </button>

                </form>

                <!-- ✅ НОВО КОПЧЕ ПОД ФОРМАТА (Ако е селектиран објект) -->
                @if (ViewBag.BuildingId != null)
                {
                    <button type="button" class="btn btn-success w-100 mt-2"
                            data-bs-toggle="modal" data-bs-target="#createPaymentModal">
                        Креирај плаќање
                    </button>
                }
            </div>
        </div>

        <!-- 🔹 RIGHT SIDE -->
        <div class="col-lg-10 col-md-9 ps-0 pe-1">

            <!-- ✅ TABLE 2 -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-content widget-content-area">
                    <div style="overflow-x:auto; width:100%;">

                        <table class="table table-bordered table-sm table-compact w-100">
                            <thead>
                                <tr>
                                    <th>Партнер</th>

                                    <th>Должи</th>
                                    <th>Побарува</th>
                                    <th>Салдо</th>

                                    <th>Јан</th>
                                    <th>Фев</th>
                                    <th>Мар</th>
                                    <th>Апр</th>
                                    <th>Мај</th>
                                    <th>Јун</th>
                                    <th>Јул</th>
                                    <th>Авг</th>
                                    <th>Сеп</th>
                                    <th>Окт</th>
                                    <th>Ное</th>
                                    <th>Дек</th>

                                    <th>Вкупно</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (ViewBag.Customers != null && ViewBag.CustomerBalances != null)
                                {
                                    var customers = (IEnumerable<dynamic>)ViewBag.Customers;
                                    var balances = (IEnumerable<dynamic>)ViewBag.CustomerBalances;
                                    var orderedCustomers = customers.OrderBy(c => c.OrderNumber).ToList();
                                    @foreach (var c in orderedCustomers)
                                    {
                                        var cusBalance = balances.FirstOrDefault(b => b.Customer.Id == c.Id);
                                        var docs = ViewBag.Docs as List<CleanHub.ViewModels.DocumentViewModel>;

                                        var customerInvoices = docs?
                                            .Where(x => x.CustomerId == c.Id)
                                            .ToList()
                                            ?? new List<CleanHub.ViewModels.DocumentViewModel>();

                                        <tr>
                                            <td style="font-size:13px !important;">@c.CustomerInfo</td>
                                            <td style="color:red;font-size: 15px !important;">@cusBalance?.Dolzi</td>
                                            <td style="color:blue;font-size: 15px !important;">@cusBalance?.Pobaruva</td>
                                            <td style="color:green;font-size: 15px !important;">@cusBalance?.Saldo</td>

                                            @for (int m = 1; m <= 12; m++)
                                            {
                                                var monthName = new DateTime(ViewBag.Year, m, 1)
                                                                .ToString("MMMM", new System.Globalization.CultureInfo("mk-MK"));
                                                float monthly = 0;
                                                @if (c.ActivityId != 3)
                                                {
                                                    monthly = customerInvoices
                                                      .Where(x =>
                                                          x.Date.HasValue &&
                                                          x.Date.Value.Month == m &&
                                                          x.PaymentStatus == 0 // nur wenn PaymentStatus 0
                                                      )
                                                      .Sum(x => x.TotalOutput ?? 0);
                                                }
                                                else
                                                {
                                                    monthly = customerInvoices
                                                    .Where(x =>
                                                        x.ToDocument != null &&
                                                        x.ToDocument.IndexOf(monthName, StringComparison.OrdinalIgnoreCase) >= 0 &&
                                                        x.ToDocument.IndexOf(ViewBag.Year.ToString(), StringComparison.OrdinalIgnoreCase) >= 0 &&
                                                        x.PaymentStatus == 0 // nur wenn PaymentStatus 0
                                                    )
                                                    .Sum(x => x.TotalOutput ?? 0);
                                                }

                                                
                                                <td style="font-size: 15px !important; font-weight:bold;">
                                                    @(monthly == 0 ? "0" : monthly.ToString())
                                                </td>
                                            }

                                            <td style="font-weight:bold;font-size: 15px !important;">
                                                @customerInvoices.Sum(x => x.TotalOutput)
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="17" class="text-center">Нема корисници</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ✅ TABLE 1 -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-content widget-content-area">
                    <table id="html5-extension" class="table dt-table-hover w-100">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Бр.</th>
                                <th>Станар</th>
                                <th>Претплата</th>
                                <th>Вкупно</th>
                                <th>Сметка</th>
                                <th>Статус</th>
                                @if (selectedValue != (int)PaymentStatus.Платено)
                                {
                                    <th>Дата на плаќање</th>
                                }
                                @if (selectedValue == (int)PaymentStatus.Платено)
                                {
                                    <th>Опис на плаќање</th>
                                    <th>Платено на</th>
                                    <th>Тип на плаќање</th>
                                    <th>Број на плаќање</th>
                                }
                                <th>Функции</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                var counter = 0;
                                foreach (var invoice in Model.OrderBy(x => x.Date))
                                {
                                    counter++;
                                    <tr>
                                        <td><input type="checkbox" class="invoice-check" value="@invoice.Id" /></td>
                                        <td>@counter</td>
                                        <td>@invoice.Customer?.CustomerInfo</td>
                                        <td>@invoice.Customer?.Subscription</td>
                                        <td>@invoice.TotalOutput МКД</td>
                                        <td>@invoice.ToDocument</td>

                                        <td>
                                            @switch (invoice.PaymentStatus)
                                            {
                                                case PaymentStatus.Платено:
                                                    <span class="badge badge-light-success">@invoice.PaymentStatus</span>
                                                    break;
                                                case PaymentStatus.Неплатено:
                                                case PaymentStatus.Делумно:
                                                    <span class="badge badge-light-warning">@invoice.PaymentStatus</span>
                                                    break;
                                                case PaymentStatus.Задоцнето:
                                                    <span class="badge badge-light-danger">@invoice.PaymentStatus</span>
                                                    break;
                                            }
                                        </td>

                                        @if (selectedValue != (int)PaymentStatus.Платено)
                                        {
                                            <td>@invoice.DateReceived?.ToString("dd.MM.yyyy")</td>
                                        }
                                        @if (selectedValue == (int)PaymentStatus.Платено)
                                        {
                                            <td>@invoice.PaymentDescription</td>
                                            <td>@invoice.PaymentDate?.ToString("dd.MM.yyyy")</td>
                                            <td>@invoice.PaymentType.GetEnumDescription()</td>
                                            <td>@invoice.PaymentNumber </td>
                                        }

                                        <td>
                                            <a asp-action="DetailsMemorandum" asp-route-id="@invoice.Id"
                                               class="badge badge-light-primary">
                                                Меморандум
                                            </a>
                                            <a asp-action="Details" asp-route-id="@invoice.Id"
                                               class="badge badge-light-primary">
                                                👁
                                            </a>
                                               <a asp-action="Edit" asp-route-id="@invoice.Id"
                                               class="badge badge-light-primary">
                                                Измени
                                            </a>
                                            @if (invoice.PaymentStatus == PaymentStatus.Неплатено)
                                            {

                                                <a href="#"
                                                   class="badge badge-light-primary set-paid-btn"
                                                   data-id="@invoice.Id">
                                                    Стави како платено
                                                </a>
                                            }
                                            @if (invoice.PaymentStatus == PaymentStatus.Платено)
                                            {
                                                <a href="#"
                                                   class="badge badge-light-primary set-notpaid-btn"
                                                   data-id="@invoice.Id">
                                                    Стави како неплатено
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center">Нема податоци</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 🔹 ACTIONS -->
            <div class="d-flex gap-3 mt-3">
                @if (Model != null && Model.Any(x => x.PaymentStatus == PaymentStatus.Неплатено))
                {
                    <form asp-action="SetMultiplePayments" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="selectedInvoices" name="SelectedInvoiceIds" />

                        <button type="button" class="btn btn-dark"
                                data-bs-toggle="modal" data-bs-target="#multiPaymentModal">
                            Плати селектирани
                        </button>
                        <div class="modal fade" id="multiPaymentModal" tabindex="-1" role="dialog" aria-labelledby="multiPaymentModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Плати повеќе фактури</h5>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label for="paymentType">Тип на плаќање</label>
                                            <select id="paymentType" name="PaymentType" class="form-control form-control-sm">
                                                @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                                                {
                                                    <option value="@((int)paymentType)">@paymentType.GetEnumDescription()</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDate">Дата на плаќање</label>
                                            <input type="date" id="paymentDate" name="PaymentDate" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentNumber">Број на плаќање</label>
                                            <input type="text" id="paymentNumber" name="PaymentNumber" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDescription">Опис</label>
                                            <input type="text" id="paymentDescription" name="PaymentDescription" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary">Плати селектирани</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                <form id="deleteForm" asp-action="DeleteMultipleDocuments" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="selectedInvoicesForDelete" name="SelectedInvoiceIds" />

                    <button type="submit" class="btn btn-danger">
                        Избриши селектирани
                    </button>
                </form>

                @if (Model != null && Model.Any(x => x.PaymentStatus == PaymentStatus.Платено))
                {
                    <form asp-action="ChangePaymentMultipleDocuments" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="selectedInvoicesMultipleChange" name="SelectedInvoiceIds" />

                        <button type="button" class="btn btn-secondary"
                                data-bs-toggle="modal" data-bs-target="#multiChangeModal">
                            Измени плаќање
                        </button>
                        <div class="modal fade" id="multiChangeModal" tabindex="-1" role="dialog" aria-labelledby="multiChangeModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Измени плаќање</h5>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label for="paymentType">Тип на плаќање</label>
                                            <select id="paymentType" name="PaymentType" class="form-control form-control-sm">
                                                @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                                                {
                                                    <option value="@((int)paymentType)">@paymentType.GetEnumDescription()</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group">

                                            <label for="total">
                                                Тотал
                                            </label>

                                            <input type="number"
                                                   id="total"
                                                   name="Total"
                                                   min="0"
                                                   step="1"
                                                   class="form-control form-control-sm" />

                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDate">Дата на плаќање</label>
                                            <input type="date" id="paymentDate" name="PaymentDate" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentNumber">Број на плаќање</label>
                                            <input type="text" id="paymentNumber" name="PaymentNumber" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDescription">Опис</label>
                                            <input type="text" id="paymentDescription" name="PaymentDescription" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary"> Измени плаќање</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                }

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="createPaymentModal" tabindex="-1" role="dialog" aria-labelledby="createPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <!-- Му додаваме ID на формата, го тргаме asp-action бидејќи ќ addresses преку AJAX -->
            <form id="createPaymentForm" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Креирај ново плаќање</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div class="form-group mb-3">
                        <label for="createPaymentCustomerId" class="form-label">Станар</label>
                        <select id="createPaymentCustomerId" name="customerId" class="form-control" required data-search="Пребарувај станар...">
                            <option value="">-- Избери станар --</option>
                            @if (ViewBag.Customers != null)
                            {
                                foreach (var c in (IEnumerable<dynamic>)ViewBag.Customers)
                                {
                                    <option value="@c.Id">@c.CustomerInfo</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="createPaymentType" class="form-label">Тип на плаќање</label>
                        <select id="createPaymentType" name="PaymentType" class="form-control">
                            @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                            {
                                <option value="@((int)paymentType)">@paymentType.GetEnumDescription()</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="createTotal" class="form-label">Тотал</label>
                        <input type="number" id="createTotal" name="Total" min="0" step="1" class="form-control" required />
                    </div>

                    <div class="form-group mb-3">
                        <label for="createPaymentDate" class="form-label">Дата на плаќање</label>
                        <input type="date" id="createPaymentDate" name="PaymentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="form-group mb-3">
                        <label for="createPaymentNumber" class="form-label">Број на плаќање</label>
                        <input type="text" id="createPaymentNumber" name="PaymentNumber" class="form-control" />
                    </div>

                    <div class="form-group mb-3">
                        <label for="createPaymentDescription" class="form-label">Опис</label>
                        <input type="text" id="createPaymentDescription" name="PaymentDescription" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Откажи</button>
                    <button type="submit" class="btn btn-success">Креирај плаќање</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- „Извади сметки“: избор на месец и сметки -->
<div class="modal fade" id="printPickerModal" tabindex="-1" aria-labelledby="printPickerTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="printPickerTitle">Извади сметки</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Затвори"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                    <div>
                        <label for="ppMonth" class="form-label">Месец</label>
                        <input type="month" id="ppMonth" class="form-control" />
                    </div>
                    <div class="d-flex flex-wrap gap-2 ms-auto">
                        <button type="button" class="btn btn-sm btn-secondary" id="ppUnpaid">Само неплатени</button>
                        <button type="button" class="btn btn-sm btn-secondary" id="ppAll">Сите</button>
                        <button type="button" class="btn btn-sm btn-secondary" id="ppNone">Ниедна</button>
                    </div>
                </div>
                <div id="ppStatus" class="text-muted small mb-2"></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:36px"><input type="checkbox" class="form-check-input" id="ppCheckAll" aria-label="Избери ги сите" /></th>
                                <th>Бр.</th>
                                <th>Станар</th>
                                <th>Период</th>
                                <th class="text-end">Износ</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody id="ppRows"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <span id="ppCount" class="me-auto text-muted small"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Откажи</button>
                <button type="button" class="btn btn-primary" id="ppDownload" disabled>Извади PDF</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        function init() {
            const modalEl = document.getElementById('printPickerModal');
            const monthInput = document.getElementById('ppMonth');
            const rowsEl = document.getElementById('ppRows');
            const statusEl = document.getElementById('ppStatus');
            const countEl = document.getElementById('ppCount');
            const checkAll = document.getElementById('ppCheckAll');
            const downloadBtn = document.getElementById('ppDownload');
            const esc = t => String(t ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const token = () => (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
            let list = [];

            function show() {
                if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
                if (window.bootstrap && bootstrap.Modal) bootstrap.Modal.getOrCreateInstance(modalEl).show();
                else if (window.jQuery && jQuery.fn.modal) jQuery(modalEl).modal('show');
            }

            const boxes = () => [...rowsEl.querySelectorAll('input[type=checkbox]')];
            function updateCount() {
                const n = boxes().filter(b => b.checked).length;
                countEl.textContent = n ? 'Избрани: ' + n + ' од ' + list.length : '';
                downloadBtn.disabled = n === 0;
                checkAll.checked = n > 0 && n === list.length;
                checkAll.indeterminate = n > 0 && n < list.length;
            }
            function select(fn) { boxes().forEach(b => { b.checked = fn(list.find(x => String(x.id) === b.value)); }); updateCount(); }

            async function load() {
                const buildingId = (document.getElementById('buildingId') || {}).value;
                const [y, m] = (monthInput.value || '').split('-');
                rowsEl.innerHTML = '';
                list = [];
                updateCount();
                if (!buildingId || !y || !m) { statusEl.textContent = 'Изберете објект и месец.'; return; }
                statusEl.textContent = 'Се вчитува...';
                try {
                    list = await fetch('/Documents/InvoicesForPrint?buildingId=' + encodeURIComponent(buildingId) + '&year=' + y + '&month=' + parseInt(m, 10)).then(r => r.json());
                } catch { statusEl.textContent = 'Грешка при вчитување.'; return; }
                if (!list.length) { statusEl.textContent = 'Нема сметки за овој месец.'; return; }
                const unpaid = list.filter(x => !x.paid).length;
                statusEl.textContent = list.length + ' сметки · ' + unpaid + ' неплатени. Неплатените се веќе избрани.';
                rowsEl.innerHTML = list.map(x =>
                    '<tr>' +
                    '<td><input type="checkbox" class="form-check-input" value="' + x.id + '"' + (x.paid ? '' : ' checked') + ' /></td>' +
                    '<td class="text-nowrap">' + esc(x.number) + '</td>' +
                    '<td>' + esc(x.customer) + '</td>' +
                    '<td class="text-nowrap">' + esc(x.period || x.date) + '</td>' +
                    '<td class="text-end text-nowrap">' + esc(x.total) + '</td>' +
                    '<td>' + (x.paid ? '<span class="badge bg-success">Платено</span>' : '<span class="badge bg-danger">Неплатено</span>') + '</td>' +
                    '</tr>').join('');
                updateCount();
            }

            window.openPrintPicker = function () {
                const buildingId = (document.getElementById('buildingId') || {}).value;
                if (!buildingId || buildingId === '0') { alert('Прво изберете објект.'); return; }
                if (!monthInput.value) {
                    const yearSel = document.querySelector('#filterForm select[name="year"]');
                    const now = new Date();
                    const y = yearSel ? parseInt(yearSel.value, 10) : now.getFullYear();
                    const m = y === now.getFullYear() ? now.getMonth() + 1 : 12;
                    monthInput.value = y + '-' + String(m).padStart(2, '0');
                }
                show();
                load();
            };

            monthInput.addEventListener('change', load);
            rowsEl.addEventListener('change', updateCount);
            checkAll.addEventListener('change', () => select(() => checkAll.checked));
            document.getElementById('ppUnpaid').addEventListener('click', () => select(x => x && !x.paid));
            document.getElementById('ppAll').addEventListener('click', () => select(() => true));
            document.getElementById('ppNone').addEventListener('click', () => select(() => false));

            downloadBtn.addEventListener('click', async () => {
                const ids = boxes().filter(b => b.checked).map(b => b.value);
                if (!ids.length) return;
                const fd = new FormData();
                fd.set('buildingId', document.getElementById('buildingId').value);
                fd.set('documentIds', ids.join(','));
                fd.set('__RequestVerificationToken', token());
                const label = downloadBtn.textContent;
                downloadBtn.disabled = true;
                downloadBtn.textContent = 'Се креира PDF (' + ids.length + ')...';
                try {
                    const res = await fetch('/Documents/CombineAndDownloadPdfs', { method: 'POST', body: fd });
                    if (!res.ok) { alert((await res.text()) || ('Грешка ' + res.status)); return; }
                    const blob = await res.blob();
                    const cd = res.headers.get('Content-Disposition') || '';
                    const m = /filename\*=UTF-8''([^;]+)/i.exec(cd) || /filename="?([^";]+)"?/i.exec(cd);
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = m ? decodeURIComponent(m[1]) : 'smetki.pdf';
                    document.body.appendChild(a);
                    a.click();
                    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
                } catch { alert('Грешка при креирање на PDF.'); }
                finally { downloadBtn.textContent = label; updateCount(); }
            });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    })();
</script>

