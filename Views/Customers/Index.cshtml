@model IEnumerable<CleanHub.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Партнер Листа";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<hr />

<div class="col-lg-12 col-md-12 layout-spacing">

    <p>
        <a class="btn btn-primary" asp-action="Create">Креирај Партнер</a>
    </p>

    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">

            <table id="html5-extension" class="table dt-table-hover w-100">
                <thead>
                    <tr>
                        <th>Информации</th>
                        <th>Адреса</th>
                        <th>Телефон</th>
                        <th>E-Mail</th>
                        <th>Во претплата</th>
                        <th class="text-center">Со гаража</th>
                        <th class="text-center">Неактивен</th>
                        <th class="text-center">Акции</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CustomerInfo</td>
                            <td>@item.Adress</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Email</td>
                            <td>@item.Subscription</td>

                            <td class="text-center">
                                <input type="checkbox" disabled checked="@item.Garage" />
                            </td>

                            <td class="text-center">
                                <input type="checkbox" disabled checked="@item.Inactive" />
                            </td>

                            <td class="text-nowrap text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info me-1"
                                   title="Детали">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Измени">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Избриши">
                                    <i class="bi bi-trash"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>