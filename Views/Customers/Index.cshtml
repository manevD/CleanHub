@model IEnumerable<CleanHub.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Партнер Листа";
}
<hr />

<div class="col-lg-12 col-md-12 layout-spacing">

    <p>
        <a class="btn btn-primary" asp-action="Create">Креирај Партнер</a>
    </p>

    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">

            <table id="html5-extension" class="table dt-table-hover w-100">
                <thead>
                    <tr>
                        <th>Информации</th>
                        <th>Адреса</th>
                        <th>Телефон</th>
                        <th>E-Mail</th>
                        <th>Во претплата</th>
                        <th class="text-center">Со гаража</th>
                        <th class="text-center">Неактивен</th>
                        <th class="text-center">Акции</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CustomerInfo</td>
                            <td>@item.Adress</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Email</td>
                            <td>@item.Subscription</td>

                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" disabled checked="@item.Garage" />
                            </td>

                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" disabled checked="@item.Inactive" />
                            </td>

                            <td class="text-nowrap text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="badge badge-light-primary me-1"
                                   title="Детали">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="badge badge-light-primary me-1"
                                   title="Измени">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="badge badge-light-danger"
                                   title="Избриши">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>