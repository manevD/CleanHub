@model CleanHub.ViewModels.DocumentViewModel
@{
    int summ = 0;
    int summDemands = 0;
    string result = "0";
    if (Model != null)
    {
        summ = Model.TotalBuildingOwes;
        summDemands = Model.TotalBuildingDemands;
        int difference = summ - summDemands;
        var message = "Вашата состојба на резервен фонд: ";
        if (summDemands == 0)
        {
            result = "0";
        }
        else if (summDemands > summ)
        {
            result = message + " Во претплата " + (-difference);
        }
        else
        {
            result = message + " Во минус " + difference;
        }
    }
}
<link href="~/layouts/horizontal-light-menu/css/light/loader.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/src/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/layouts/horizontal-light-menu/css/light/plugins.css" rel="stylesheet" type="text/css" media="all" />

<link href="~/src/assets/css/light/apps/invoice-preview.css" rel="stylesheet" type="text/css" media="all" />
<style>
    .horizontal_line {
        width: 100%;
        height: 5px;
        border-top: 5px dotted black;
    }

    .compact-section {
        padding: 3px; /* Adjust padding for the section */
        margin: 3px 0; /* Adjust margin for the section */
    }

    .boxed {
        border: 1px solid #000; /* Border color */
        padding: 10px; /* Space inside the box */
        border-radius: 5px; /* Optional: rounded corners */
        background-color: #f9f9f9; /* Optional: background color */
        margin: 10px 0; /* Space around the box */
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .invoice, .invoice * {
            visibility: visible;
        }

        .invoice {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none;
        }

        .invoice-container {
            margin: 0;
            padding: 0;
            width: 100%;
            border: none;
        }

        .invoice-actions-btn {
            display: none;
        }

        .inv--note, .inv--additional-notes {
            page-break-before: avoid;
            page-break-after: avoid;
        }
    }
</style>
<div class="row invoice layout-top-spacing layout-spacing" id="Grid">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="doc-container">
            <div class="row">
                <div class="col-xl-9">
                    <div class="invoice-container">
                        <div class="invoice-inbox">
                            <div id="ct" class="">
                                <div class="invoice-00001">
                                    <div class="content-section">
                                        <div class="inv--head-section inv--detail-section">
                                            <div class="row">
                                                <div class="col-sm-6 col-12 mr-auto">
                                                    <div class="d-flex">
                                                        <img class="company-logo" src="~/src/logo3.png">
                                                        <h3 class="in-heading align-self-center">@Model?.Company?.Name</h3>
                                                    </div>
                                                    <p class="inv-street-addr mt-3">@Model?.Company?.Address</p>
                                                    <p class="inv-email-address">@Model?.Company?.Email</p>
                                                    <p class="inv-email-address">@Model?.Company?.PhoneNumber</p>
                                                    <p class="inv-email-address">ЕДБ: @Model?.Company?.VATID</p>
                                                    <p class="inv-email-address">@Model?.Company?.IBAN</p>
                                                </div>
                                                <div class="col-sm-6 text-sm-end">
                                                    <p class="inv-list-number mt-sm-3 pb-sm-2 mt-4">
                                                        <span class="inv-title">ИСПРАТНИЦА-ФАКТУРА БР: </span>
                                                        <span class="inv-number">@Model?.Number</span>
                                                    </p>
                                                    <p class="inv-created-date mt-sm-5 mt-3">
                                                        <span class="inv-title">Издадена на : </span>
                                                        <span class="inv-date">@Model?.Date</span>
                                                    </p>
                                                    <p class="inv-due-date">
                                                        <span class="inv-title">Рок на плаќање до: </span>
                                                        <span class="inv-date">@Model?.DateReceived</span>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="inv--detail-section inv--customer-detail-section compact-section">
                                            <div class="row">
                                                <div class="col-xl-8 col-lg-7 col-md-6 col-sm-4 align-self-center">
                                                    <p class="inv-to"></p>
                                                </div>
                                                <div class="col-xl-4 col-lg-5 col-md-6 col-sm-8 col-12 order-sm-0 order-1 text-sm-end compact-customer-info">
                                                    <p class="inv-customer-name">@Model?.Customer?.CustomerInfo</p>
                                                    <p class="inv-email-address">@Model?.Customer?.Adress</p>
                                                    <p class="inv-email-address">@Model?.Customer?.Email</p>
                                                    <p class="inv-email-address">@Model?.Customer?.PhoneNumber</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="inv--product-table-section">
                                            <tr class="table-responsive">
                                                <table class="table">
                                                    <thead class="">
                                                        <tr>
                                                            <th scope="col">Артикал</th>
                                                            <th class="text-end" scope="col">Ед.М</th>
                                                            <th class="text-end" scope="col">Кол</th>
                                                            <th class="text-end" scope="col">Цена со ДДВ</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model?.Books != null && Model.Books.Any())
                                                        {
                                                            foreach (var article in Model.Books)
                                                            {
                                                                <tr>
                                                                    <td>@article.ArticleNotes</td>
                                                                    <td class="text-end">@article.UnitOfMeasurement</td>
                                                                    <td class="text-end">@article.Quantity</td>
                                                                    <td class="text-end">@article.PriceWithTax!.Value.ToString("F2")</td>
                                                                </tr>
                                                            }
                                                        }
                                                        <tr>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td class="text-end">ЗА НАПЛАТА: @(Model?.TotalOutput ?? 0)</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                        </div>
                                    </div>
                                    <div class="inv--additional-notes">
                                        @Html.Raw(@Model?.Company?.InvoiceNotice)
                                        <br/>
                                        <strong>@result</strong>
                                    </div>

                                    <div class="inv--note">
                                        <div class="row mt-4">
                                            <div class="col-sm-6 col-12 order-sm-0 order-1">
                                                <p>Примил</p>
                                            </div>
                                            <div class="col-sm-6 col-12 order-sm-1 order-1 text-sm-end">
                                                <p>Потпис Виолета</p>
                                            </div>
                                        </div>
                                    </div>
                                    <br />
                                    <div class="horizontal_line"></div>
                                    <div class="inv--footer mt-4">
                                        <div class="row">
                                            <div class="col-sm-4 col-12">
                                                <div class="boxed">
                                                    <p class="inv-customer-name">@Model?.Customer?.CustomerInfo</p>
                                                    <p class="inv-email-address">@Model?.Customer?.Adress</p>
                                                </div>
                                            </div>
                                            <div class="col-sm-4 col-12 text-center">
                                                <h3 class="in-heading align-self-center">@Model?.Company?.Name</h3>
                                                <p class="inv-street-addr mt-3">@Model?.Company?.Address</p>
                                            </div>
                                            <div class="col-sm-4 col-12 text-sm-end">
                                                <p class="inv-list-number mt-sm-3 pb-sm-2 mt-4">
                                                    <span class="inv-title">ИСПРАТНИЦА-ФАКТУРА БР: </span>
                                                    <span class="inv-number">@Model?.Number</span>
                                                </p>
                                                <p class="text-end">ВКУПНО ЗА НАПЛАТА: @Model?.TotalOutput ден</p>
                                                <b>@Model?.ToDocument</b>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        @if (@Model != null && !@Model.IsForPdf)
        {
            <div class="col-xl-3">
                <div class="invoice-actions-btn">
                    <div class="invoice-action-btn">
                        <div class="row">
                            <form asp-action="GeneratePdfTest" asp-controller="Documents">
                                <input type="hidden" asp-for="Id" />
                                <input type="submit" value="Испрати Сметка" class="btn btn-danger" /> |
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script src="~/layouts/horizontal-light-menu/loader.js"></script>
<script src="~/src/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/src/plugins/src/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="~/src/plugins/src/mousetrap/mousetrap.min.js"></script>
<script src="~/src/plugins/src/waves/waves.min.js"></script>
<script src="~/layouts/horizontal-light-menu/app.js"></script>
<!-- END GLOBAL MANDATORY SCRIPTS -->
<script src="~/src/assets/js/apps/invoice-preview.js"></script>