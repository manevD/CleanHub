@model CleanHub.ViewModels.DocumentViewModel

@{
    DateTime currentDate = DateTime.Now;

    // Calculate the previous month
    DateTime previousMonthDate = currentDate.AddMonths(-1);
    // Format the previous month date
    string formattedPreviousMonth = previousMonthDate.ToString("MM/yyyy");
}
<div class="invoice-detail-items">
    <div class="table-responsive">
        <table class="table item-table">
            <thead>
                <tr>
                    <th>Опис</th>
                    <th class="">Ед.м</th>
                    <th class="text-right">Цена без ДДВ</th>
                    <th class="text-right">ДДВ</th>
                    <th class="text-center">Цена</th>
                    <th class="text-center">Вк.распл.</th>
                    <th class="text-center">Вкупно</th>
                </tr>
                <tr aria-hidden="true" class="mt-3 d-block table-row-hidden"></tr>
            </thead>
            <tbody>
                @if (@Model?.Building != null && @Model.Building.BuildingProducts != null && @Model.Building.BuildingProducts.Any())
                {
                    @for (var i = 0; i < Model.Building.BuildingProducts.Count; i++)
                    {
                        <tr>
                            <td class="description">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].ArticleNotes @formattedPreviousMonth" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].UnitOfMeasurement" />
                            </td>

                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" id="Price_@i" value="@Model.Building.BuildingProducts[i].Price" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" id="Tax_@i" value="@Model.Building.BuildingProducts[i].Tax" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" id="PriceWithTax_@i" value="@Model.Building.BuildingProducts[i].PriceWithTax" readonly />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" id="Total_@i" value="@Model.Building.BuildingProducts[i].Total" />
                            </td>
                            <td class="rate">
                                <input type="text" class="form-control form-control-sm" value="@Model.Building.BuildingProducts[i].PriceWithTax" readonly />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@if (@Model?.Building.BuildingProducts != null && @Model.Building.BuildingProducts.Any())
{
    <div class="invoice-detail-total" style="text-align: right;">
        <div class="invoice-summary-label" style="color:black;">Вкупно</div>
        <div class="invoice-summary-value">
            <div class="balance-due-amount">
                <span>@Model.Building.BuildingProducts.Sum(x => x.PriceWithTax)</span> <span class="currency">МКД</span>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get all rows in the tbody
            var rows = document.querySelectorAll('tbody tr');

            // Get the number of customers
            var customerCount = @Model?.Building?.Customers?.Count;

            // Function to calculate and update values
            function calculatePrice(row) {
                // Get elements in the row
                var priceInput = row.querySelector('input[id^="Price_"]');
                var taxInput = row.querySelector('input[id^="Tax_"]');
                var priceWithTaxInput = row.querySelector('input[id^="PriceWithTax_"]');
                var totalInput = row.querySelector('input[id^="Total_"]');

                // Parse total value
                var total = parseFloat(totalInput.value) || 0;

                // If total is provided, calculate price per customer
                if (total > 0) {
                    var pricePerCustomer = total / customerCount;
                    // Round to the nearest whole number
                    priceInput.value = Math.round(pricePerCustomer);
                }

                // Recalculate PriceWithTax based on the new Price
                var price = parseFloat(priceInput.value) || 0; // Price without VAT
                var tax = parseFloat(taxInput.value) || 0; // VAT

                // Calculate PriceWithTax
                var priceWithTax;
                if (tax === 0) {
                    // If tax is 0, set PriceWithTax to Price
                    priceWithTax = price;
                } else {
                    // Calculate tax amount and add it to the price
                    var taxAmount = (price * tax) / 100; // Calculate tax based on the price
                    priceWithTax = price + taxAmount; // Price without VAT + VAT = Total Price
                }

                // Round PriceWithTax to the nearest whole number
                priceWithTaxInput.value = Math.round(priceWithTax);
            }

            // For each row, add input event listeners
            rows.forEach(function (row) {
                // Get elements in the row
                var totalInput = row.querySelector('input[id^="Total_"]');
                var taxInput = row.querySelector('input[id^="Tax_"]');

                // Add input event listeners
                totalInput.addEventListener('input', function () {
                    calculatePrice(row);
                });

                taxInput.addEventListener('input', function () {
                    calculatePrice(row);
                });

                // Perform Initial calculation on page load
                calculatePrice(row);
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}