@using CleanHub.Entities
@model IEnumerable<CleanHub.ViewModels.BookFinancialInfoViewModel>
@{
    ViewData["Title"] = "Книжења";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var invoiceId = @ViewBag.InvoiceId;
}

<hr />
<form asp-action="Books" asp-controller="BookFinancial" method="get">
    <div class="row">
        @if (ViewBag.Buildings != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="buildingId">Објект</label>
                    @Html.DropDownList("buildingId", (IEnumerable<SelectListItem>)ViewBag.Buildings, new { @class = "form-control" })
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-2 col-md-3">
                <p>Нема пронајдено објекти!</p>
            </div>
        }
        @if (ViewBag.InvoiceTypList != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="invoiceId">Тип на сметка</label>
                    @Html.DropDownList("invoiceId", (IEnumerable<SelectListItem>)ViewBag.InvoiceTypList, new { @class = "form-control" })
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-2 col-md-3">
                <p>Нема пронајдено тип на сметка!</p>
            </div>
        }
        @if (ViewBag.PaymentStatusList != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="paymentStatusId">Статус</label>
                    @Html.DropDownList("paymentStatusId", (IEnumerable<SelectListItem>)ViewBag.PaymentStatusList, new { @class = "form-control" })
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-2 col-md-3">
                <p>Нема пронајдено статус!</p>
            </div>
        }
        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <label for="dateFrom">Од</label>
                <input id="dateFrom" name="dateFrom" placeholder="ден.месец.година" type="text" class="form-control flatpickr" value="@ViewBag.DateFrom" />
            </div>
        </div>
        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <label for="dateTo">До</label>
                <input id="dateTo" name="dateTo" placeholder="ден.месец.година" type="text" class="form-control flatpickr" value="@ViewBag.DateTo" />
            </div>
        </div>
      
    </div>
    </br> <!-- Optional: Trennlinie -->
    <div class="col-lg-2 col-md-3">
        <div class="form-group mb-0">
            <button type="submit" class="btn btn-primary w-100">Пребарувај</button>
        </div>
    </div>
</form>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    </br>
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Станар</th>
                        <th>Опис</th>
                        <th>Должи</th>
                        <th>Побарува</th>
                        <th>Статус</th>
                        <th>Дата на издавање</th>
                        <th>Задоцнување</th>
                        <th>Нова вредност</th>
                        <th>Функции</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => invoice.CustomerInfo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => invoice.Description)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => invoice.Owes) МКД
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => invoice.Demands) МКД
                                </td>

                                <td>
                                    @if (invoice.Status == PaymentStatus.Платено)
                                    {
                                        <span class="badge badge-light-success inv-status">@invoice.Status</span>
                                    }
                                    else if (invoice.Status == PaymentStatus.Неплатено)
                                    {
                                        <span class="badge badge-light-warning inv-status">@invoice.Status</span>
                                    }
                                    else if (invoice.Status == PaymentStatus.Делумно)
                                    {
                                        <span class="badge badge-light-warning inv-status">@invoice.Status</span>
                                    }
                                    else if (invoice.Status == PaymentStatus.Задоцнето)
                                    {
                                        <span class="badge badge-light-danger inv-status">@invoice.Status</span>
                                    }
                                    else
                                    {
                                        <span>Неопределен статус</span>
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => invoice.FormattedDatumF)
                                </td>

                                <td>
                                    @((invoice.Delay ?? 0))
                                </td>
                                <td>
                                    @((invoice.NewTotal ?? 0) + " МКД")
                                </td>
                                <td>
                                    <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Edit" asp-controller="Invoices" asp-route-id="@invoice.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-3">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">Нема пронајдени податоци</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>