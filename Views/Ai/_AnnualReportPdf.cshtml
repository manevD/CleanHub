@model CleanHub.Services.Ai.AnnualReportDocument
@using CleanHub.Services.Ai
@{
    Layout = null;
    var r = Model.Report;
    var s = r.Stats;
    var paragraphs = (r.Narrative ?? "").Replace("\r", "").Split("\n\n", StringSplitOptions.RemoveEmptyEntries);
}
<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <title>@r.Title — @s.BuildingName</title>
    @* PDF / печатење: стиловите мора да бидат тука (SelectPdf не ја вчитува site.css) *@
    <style>
        @@page { size: A4; margin: 14mm; }
        body { font-family: "Segoe UI", Arial, sans-serif; color: #0f172a; font-size: 12.5px; line-height: 1.55; margin: 0; }
        .head { width: 100%; border-collapse: collapse; border-bottom: 3px solid #059669; margin-bottom: 18px; }
        .head td { padding: 0 0 14px; vertical-align: top; }
        .head img { height: 54px; }
        .head .meta { text-align: right; color: #475569; font-size: 11px; }
        h1 { font-size: 21px; margin: 0 0 2px; letter-spacing: -.01em; }
        .sub { color: #475569; margin: 0 0 18px; }
        .stats { width: 100%; border-collapse: separate; border-spacing: 8px; margin: 0 -8px 10px; }
        .stats td { background: #f1f5f9; border-radius: 10px; padding: 10px 12px; width: 33%; vertical-align: top; }
        .stats .l { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: #64748b; font-weight: 700; }
        .stats .v { display: block; font-size: 15px; font-weight: 700; margin-top: 2px; }
        .text p { margin: 0 0 10px; white-space: pre-line; }
        h2 { font-size: 14px; margin: 22px 0 8px; color: #047857; }
        table.costs { width: 100%; border-collapse: collapse; font-size: 11.5px; page-break-inside: auto; }
        table.costs tr { page-break-inside: avoid; }
        table.costs th { text-align: left; background: #f1f5f9; padding: 6px 8px; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: #475569; }
        table.costs td { padding: 6px 8px; border-bottom: 1px solid #e5e9f0; vertical-align: top; }
        table.costs .m { white-space: nowrap; font-weight: 600; width: 90px; }
        table.costs .n { text-align: right; white-space: nowrap; }
        table.costs tfoot td { font-weight: 700; border-top: 2px solid #cbd5e1; }
        .foot { width: 100%; margin-top: 28px; border-collapse: collapse; color: #475569; font-size: 11px; page-break-inside: avoid; }
        .foot td { vertical-align: bottom; }
        .sign { width: 220px; border-top: 1px solid #475569; padding-top: 4px; text-align: center; }
        .print-bar { display: none; }
        @@media screen {
            html { background: #e2e8f0; }
            body.is-screen { max-width: 794px; margin: 24px auto; padding: 40px 44px; background: #fff; box-shadow: 0 6px 30px rgba(15, 23, 42, .15); }
            .print-bar { display: flex; gap: 8px; justify-content: center; position: sticky; top: 0; padding: 10px; background: #e2e8f0; z-index: 5; }
            .print-bar button, .print-bar a { font: 600 14px "Segoe UI", Arial, sans-serif; padding: 8px 16px; border-radius: 9px; border: 1px solid #cbd5e1; background: #fff; color: #0f172a; text-decoration: none; cursor: pointer; }
            .print-bar button { background: #059669; border-color: #059669; color: #fff; }
        }
        @@media print {
            .print-bar { display: none !important; }
            body { max-width: none; margin: 0; padding: 0; box-shadow: none; }
            .stats td, table.costs th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body class="@(Model.AutoPrint ? "is-screen" : "")">
    @if (Model.AutoPrint)
    {
        <div class="print-bar">
            <button type="button" onclick="window.print()">Печати</button>
            <a href="@Url.Action("AnnualReportEdit", "Ai", new { id = r.Id })">← Назад кон уредување</a>
        </div>
    }

    <table class="head">
        <tr>
            <td><img src="~/src/logo3.png" alt="" /></td>
            <td class="meta">
                <strong>@Model.Company.Name</strong><br />
                @Model.Company.Address<br />
                @Model.Company.PhoneNumber · @Model.Company.Email
            </td>
        </tr>
    </table>

    <h1>@r.Title</h1>
    <p class="sub">Зграда: <strong>@s.BuildingName</strong> · Активни станари: @s.TenantsCount · Изготвено: @((r.UpdatedAt ?? r.GeneratedAt).ToString("dd.MM.yyyy"))</p>

    <table class="stats">
        <tr>
            <td><span class="l">Фактурирано</span><span class="v">@FinanceDataService.Money(s.Invoiced)</span></td>
            <td><span class="l">Собрано (редовен фонд)</span><span class="v">@FinanceDataService.Money(s.CollectedRegular)</span></td>
            <td><span class="l">Процент на наплата</span><span class="v">@s.CollectionRate.ToString("0.#", FinanceDataService.Mk)%</span></td>
        </tr>
        <tr>
            <td><span class="l">Резервен фонд — собрано</span><span class="v">@FinanceDataService.Money(s.CollectedReserve)</span></td>
            <td><span class="l">Резервен фонд — потрошено</span><span class="v">@FinanceDataService.Money(s.ReserveCosts)</span></td>
            <td><span class="l">Состојба на 31.12.@s.Year</span><span class="v">@FinanceDataService.Money(s.ReserveBalanceEndOfYear)</span></td>
        </tr>
    </table>

    <div class="text">
        @foreach (var p in paragraphs)
        {
            <p>@p.Trim()</p>
        }
    </div>

    @if (r.Months.Count > 0)
    {
        <h2>Трошоци од резервниот фонд по месеци</h2>
        <table class="costs">
            <thead><tr><th>Месец</th><th>Опис</th><th class="n">Износ</th></tr></thead>
            <tbody>
                @foreach (var m in r.Months)
                {
                    <tr><td class="m">@AnnualReportService.MonthName(m.Month)</td><td>@m.Description</td><td class="n">@FinanceDataService.Money(m.Amount)</td></tr>
                }
            </tbody>
            <tfoot><tr><td colspan="2">Вкупно</td><td class="n">@FinanceDataService.Money(r.MonthsTotal)</td></tr></tfoot>
        </table>
    }

    <table class="foot">
        <tr>
            <td>Неплатени фактури за годината: <strong>@FinanceDataService.Money(s.UnpaidTotal)</strong> (@s.TenantsWithDebt станари)</td>
            <td style="width:240px; padding-top:48px"><div class="sign">Управител</div></td>
        </tr>
    </table>

    @if (Model.AutoPrint)
    {
        <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });</script>
    }
</body>
</html>
