@using CleanHub.Entities
@model List<CleanHub.ViewModels.DocumentViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .table-container {
        overflow: auto !important; /* Ensure overflow is set to auto to allow scrolling */
        max-height: 800px; /* Set a maximum height for the container to trigger scrolling */
    }
</style>
<div class="row">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Број на Сметка</th>
                        <th>Станар</th>
                        <th>Вредност</th>
                        <th>Статус</th>
                        <th>Дата на креирање</th>
                        <th>Дата на примање</th>
                        <th>По Документ</th>
                        <th>Функции</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in @Model)
                    {
                        <tr>
                            <td><a href="./app-invoice-preview.html"><span class="inv-number">@document.Number</span></a></td>
                            <td>
                                <span class="inv-amount">
                                    @(document.Customer.CustomerInfo)
                                </span>
                            </td>
                            <td>
                                <span class="inv-amount">
                                    @(document.TotalOutput?.ToString("F2") ?? "N/A") MKD
                                </span>
                            </td>
                           
                            @if (@document.PaymentStatus == PaymentStatus.Платено)
                            {
                                <td><span class="badge badge-light-success inv-status">@document.PaymentStatus</span></td>
                            }
                            @if (@document.PaymentStatus == PaymentStatus.Неплатено)
                            {
                                <td><span class="badge badge-light-warning inv-status">@document.PaymentStatus</span></td>
                            }
                            @if (@document.PaymentStatus == PaymentStatus.Делумно)
                            {
                                <td><span class="badge badge-light-warning inv-status">@document.PaymentStatus</span></td>
                            }
                            @if (@document.PaymentStatus == PaymentStatus.Задоцнето)
                            {
                                <td><span class="badge badge-light-danger inv-status">@document.PaymentStatus</span></td>
                            }

                            <td>
                                <span class="inv-date">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    @(document.CreatedTime?.ToString("yyyy-MM-dd") ?? "N/A")
                                </span>
                            </td>

                            <td>
                                @(document.ToDocument ?? "N/A")
                            </td>
                            <td>
                                <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Details" asp-controller="Documents" asp-route-id="@document.Id">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </a>
                                <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Edit" asp-controller="Documents" asp-route-id="@document.Id"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></a>
                                <a class="badge badge-light-danger text-start action-delete" asp-action="Delete" asp-controller="Documents" asp-route-id="@document.Id"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
