@model CleanHub.ViewModels.DocumentViewModel
@{
    int summ = 0;
    int summDemands = 0;
    string result = "0";
    if (Model != null)
    {
        summ = Model.TotalBuildingOwes;
        summDemands = Model.TotalBuildingDemands;
        int difference = summ - summDemands;
        var message = "Вашата состојба на резервен фонд: ";
        if (summDemands == 0)
        {
            result = "0";
        }
        else if (summDemands > summ)
        {
            result = message + " Во претплата " + (-difference);
        }
        else
        {
            result = message + " Во минус " + difference;
        }
    }
}

<link href="~/layouts/horizontal-light-menu/css/light/loader.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/src/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/layouts/horizontal-light-menu/css/light/plugins.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/src/assets/css/light/apps/invoice-preview.css" rel="stylesheet" type="text/css" media="all" />

<style>
    .horizontal_line {
        width: 100%;
        height: 5px;
        border-top: 5px dotted black;
    }

    .compact-section {
        padding: 3px;
        margin: 3px 0;
    }

    .boxed {
        border: 1px solid #000;
        padding: 10px;
        border-radius: 5px;
        background-color: #f9f9f9;
        margin: 10px 0;
    }

    @@media print {
        body * {
            visibility: hidden;
        }
        .invoice, .invoice * {
            visibility: visible;
        }
        .invoice {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none;
        }
        .invoice-actions-btn {
            display: none;
        }
    }
</style>

<div class="row invoice layout-top-spacing layout-spacing" id="Grid" style="font-size: 0.70rem;">
    <div class="col-xl-12">
        <div class="doc-container">
            <div class="invoice-container">
                <div class="invoice-inbox">
                    <div id="ct">
                        <div class="invoice-00001">
                            <div class="content-section">
                                <div class="inv--head-section inv--detail-section">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="d-flex">
                                                <img class="company-logo" src="~/src/logo3.png" alt="Logo">
                                                <h3 class="in-heading align-self-center">@Model?.Company?.Name</h3>
                                            </div>
                                            <p>@Model?.Company?.Address</p>
                                            <p>@Model?.Company?.Email</p>
                                            <p>@Model?.Company?.PhoneNumber</p>
                                            <p>ЕДБ: @Model?.Company?.VATID</p>
                                            <p>@Model?.Company?.IBAN</p>
                                        </div>
                                        <div class="col-sm-6 text-sm-end">
                                            <p><span>ИСПРАТНИЦА-ФАКТУРА БР: </span><span>@Model?.Number</span></p>
                                            <p><span>Издадена на : </span><span>@Model?.CreatedTime?.ToString("dd.MM.yyyy")</span></p>
                                            <p><span>Рок на плаќање до: </span><span>@Model?.DueDate?.ToString("dd.MM.yyyy")</span></p>
                                            <p>@Model?.Customer?.CustomerInfo</p>
                                            <p>@Model?.Customer?.Adress</p>
                                            <p>@Model?.Customer?.Email</p>
                                            <p>@Model?.Customer?.PhoneNumber</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="inv--detail-section compact-section">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Артикал</th>
                                                <th class="text-end">Ед.М</th>
                                                <th class="text-end">Кол</th>
                                                <th class="text-end">Цена со ДДВ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model?.Books != null && Model.Books.Any())
                                            {
                                                foreach (var article in Model.Books)
                                                {
                                                    <tr>
                                                        <td>@article.ArticleNotes</td>
                                                        <td class="text-end">@article.UnitOfMeasurement</td>
                                                        <td class="text-end">@article.Quantity</td>
                                                        <td class="text-end">@(article.PriceWithTax?.ToString("F2") ?? "0.00")</td>
                                                    </tr>
                                                }
                                            }
                                            <tr>
                                                <td colspan="3"></td>
                                                <td class="text-end">за наплата: @(Model?.TotalOutput ?? 0)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="inv--additional-notes mt-2">
                                    @Html.Raw(Model?.Company?.InvoiceNotice ?? "")
                                    <strong>@result</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model != null && !Model.IsForPdf)
        {
            <div class="invoice-actions-btn">
                <form asp-action="GeneratePdfTest" asp-controller="Documents">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Испрати Сметка" class="btn btn-danger" />
                </form>
            </div>
        }
    </div>
</div>

<script src="~/layouts/horizontal-light-menu/loader.js"></script>
<script src="~/src/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/src/plugins/src/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="~/src/plugins/src/mousetrap/mousetrap.min.js"></script>
<script src="~/src/plugins/src/waves/waves.min.js"></script>
<script src="~/layouts/horizontal-light-menu/app.js"></script>
<script src="~/src/assets/js/apps/invoice-preview.js"></script>