@model CleanHub.ViewModels.AiAnnualReportViewModel
@using CleanHub.Services.Ai
@{
    ViewData["Title"] = "Годишен извештај за собрание";
    var thisYear = DateTime.Now.Year;
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="AnnualReport" method="post" class="toolbar" id="annualForm">
            <div class="toolbar-field">
                <label class="form-label" for="buildingId">Објект</label>
                <select id="buildingId" name="buildingId" class="form-select" asp-items="Model.Buildings" required data-search="Пребарувај објект...">
                    <option value="">— Изберете објект —</option>
                </select>
            </div>
            <div class="toolbar-field toolbar-field-sm">
                <label class="form-label" for="year">Година</label>
                <select id="year" name="year" class="form-select">
                    @for (var y = thisYear; y >= 2019; y--)
                    {
                        <option value="@y" selected="@(y == Model.Year ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
            <div class="toolbar-field toolbar-field-grow">
                <label class="form-label" for="notes">Белешки од управителот <span class="text-muted">(опционално)</span></label>
                <input id="notes" name="notes" class="form-control" value="@Model.Notes" maxlength="1000"
                       placeholder="Пр. Во април е заменет моторот на лифтот; следната година планираме фасада." />
            </div>
            <div class="toolbar-actions">
                <button type="submit" class="btn btn-primary" id="annualSubmit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z" /></svg>
                    Генерирај извештај
                </button>
            </div>
        </form>
        @if (!Model.AiEnabled)
        {
            <p class="text-warning-soft small mt-2 mb-0">AI не е вклучен — текстот ќе биде од готов шаблон, бројките се исти.</p>
        }
        <p class="text-muted small mt-2 mb-0">Трошоците од резервниот фонд се прикажуваат групирани по месеци. По генерирањето извештајот се зачувува и може да се менува, печати или брише.</p>
    </div>
</div>

<div class="section-head">
    <h2 class="section-title m-0">Зачувани извештаи @(Model.BuildingId != null ? "за избраниот објект" : "")</h2>
    @if (Model.BuildingId != null)
    {
        <a class="btn btn-secondary btn-sm" asp-action="AnnualReport">Прикажи ги сите</a>
    }
</div>

<div class="card">
    @if (Model.Saved.Count == 0)
    {
        <div class="empty-state">Сè уште нема зачувани извештаи. Изберете објект и година и кликнете „Генерирај извештај“.</div>
    }
    else
    {
        <div class="table-responsive table-container">
            <table class="table m-0 align-middle">
                <thead>
                    <tr>
                        <th>Објект</th>
                        <th>Година</th>
                        <th>Наслов</th>
                        <th class="text-end">Трошоци (рез. фонд)</th>
                        <th>Изготвено</th>
                        <th>Последна измена</th>
                        <th class="text-end">Акции</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Saved)
                    {
                        <tr>
                            <td>@r.Stats.BuildingName</td>
                            <td>@r.Stats.Year</td>
                            <td>
                                <a asp-action="AnnualReportEdit" asp-route-id="@r.Id">@r.Title</a>
                                @if (r.AiGenerated) { <span class="ai-chip ms-1">AI</span> }
                            </td>
                            <td class="text-end text-nowrap">@FinanceDataService.Money(r.MonthsTotal)</td>
                            <td class="text-nowrap">@r.GeneratedAt.ToString("dd.MM.yyyy HH:mm")<span class="text-muted small d-block">@r.CreatedBy</span></td>
                            <td class="text-nowrap">
                                @if (r.UpdatedAt != null)
                                {
                                    @r.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")<span class="text-muted small d-block">@r.UpdatedBy</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    <a class="btn btn-sm btn-primary" asp-action="AnnualReportEdit" asp-route-id="@r.Id">Отвори / уреди</a>
                                    <a class="btn btn-sm btn-secondary" asp-action="AnnualReportPrint" asp-route-id="@r.Id" target="_blank" rel="noopener">Печати</a>
                                    <a class="btn btn-sm btn-success" asp-action="AnnualReportPdf" asp-route-id="@r.Id">PDF</a>
                                    <form asp-action="AnnualReportDelete" asp-route-id="@r.Id" method="post" class="m-0 d-inline"
                                          data-confirm="Да се избрише извештајот „@r.Stats.BuildingName — @r.Stats.Year“? Ова не може да се врати.">
                                        <button type="submit" class="btn btn-sm btn-danger">Избриши</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('annualForm').addEventListener('submit', function () {
            const b = document.getElementById('annualSubmit');
            b.disabled = true;
            b.innerHTML = '<span class="spinner"></span> Се подготвува…';
        });
        document.querySelectorAll('form[data-confirm]').forEach(function (f) {
            f.addEventListener('submit', function (e) { if (!confirm(f.dataset.confirm)) e.preventDefault(); });
        });
    </script>
}
