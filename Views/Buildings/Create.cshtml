@model CleanHub.ViewModels.BuildingViewModel

@{
    ViewData["Title"] = "Додај Објект";
    DateTime currentDate = DateTime.Now;

    // Calculate the previous month
    DateTime previousMonthDate = currentDate.AddMonths(-1);

    // Format the previous month date
    string formattedPreviousMonth = previousMonthDate.ToString("MM/yyyy");
}

<div class="tab-content" id="animateLineContent-4">
    <div class="tab-pane fade show active" id="animated-underline-home" role="tabpanel" aria-labelledby="animated-underline-home-tab">
        <div class="row">
            <form asp-action="Create" class="section general-info">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="info">
                    <h6 class="">Информации за Објектот</h6>
                    <div class="row">
                        <div class="col-xl-10 col-lg-12 col-md-8 mt-md-0 mt-4">
                            <div class="form">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Име на Објект</label>
                                            <input asp-for="Name" class="form-control form-control-sm" />
                                            <span asp-validation-for="Name" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Резервен фонд</label>
                                            <input asp-for="ReserveFund" class="form-control form-control-sm" />
                                            <span asp-validation-for="ReserveFund" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Жиро Сметка</label>
                                            <input asp-for="BankAccount" class="form-control form-control-sm" />
                                            <span asp-validation-for="BankAccount" class="text-danger"></span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4">
                    <div id="buildingProductsContainer">


                        @for (int i = 0; i < Model.BuildingProducts.Count; i++)
                        {
                            <div class="row product-row" data-index="@i">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label>Опис</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.ArticleNotes" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.ArticleNotes @formattedPreviousMonth" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.ArticleNotes" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Ед.М</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.UnitOfMeasurement" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.UnitOfMeasurement" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.UnitOfMeasurement" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Данок</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.Tax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.Tax" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.Tax" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Кол.</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.Quantity" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.Quantity" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.Quantity" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Цена без ДДВ</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.Price" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.Price" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.Price" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Цена</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.PriceWithTax" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Вкупно</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.PriceWithTax" />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-sm">
                                    <div class="form-group">
                                        <label>Вк.по лице</label>
                                        <input asp-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.PriceWithTax" readonly />
                                        <span asp-validation-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                    <div class="form-group d-flex justify-content-between mt-3">
                        <button type="button" class="btn btn-secondary" onclick="addBuildingProduct()">Додај нов Артикал</button>
                        <input type="submit" value="Зачувај" class="btn btn-primary" />
                    </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function addBuildingProduct() {
            // Find the container where new rows will be added
            var container = document.getElementById('buildingProductsContainer');

            // Get the current number of rows to determine the next index
            var currentIndex = container.querySelectorAll('.building-product-row').length;

            // Create a new row for a BuildingProduct
            var newRow = document.createElement('div');
            newRow.className = 'row building-product-row';
            newRow.setAttribute('data-index', currentIndex);

            // Create new input fields (Example for ArticleNotes, repeat for other fields)
            var newCol1 = document.createElement('div');
            newCol1.className = 'col-sm-4';
            newCol1.innerHTML = `
                    <div class="form-group">
                        <label>Опис</label>
                                <input name="BuildingProducts[${currentIndex}].Product.ArticleNotes" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol2 = document.createElement('div');
            newCol2.className = 'col-sm';
            newCol2.innerHTML = `
                    <div class="form-group">
                        <label>Ед.М</label>
                                <input name="BuildingProducts[${currentIndex}].Product.UnitOfMeasurement" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol3 = document.createElement('div');
            newCol3.className = 'col-sm';
            newCol3.innerHTML = `
                    <div class="form-group">
                        <label>Данок</label>
                                <input name="BuildingProducts[${currentIndex}].Product.Tax" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol4 = document.createElement('div');
            newCol4.className = 'col-sm';
            newCol4.innerHTML = `
                    <div class="form-group">
                        <label>Кол.</label>
                                <input name="BuildingProducts[${currentIndex}].Product.Quantity" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol5 = document.createElement('div');
            newCol5.className = 'col-sm';
            newCol5.innerHTML = `
                    <div class="form-group">
                        <label>Цена без ДДВ</label>
                                <input name="BuildingProducts[${currentIndex}].Product.Price" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol6 = document.createElement('div');
            newCol6.className = 'col-sm';
            newCol6.innerHTML = `
                    <div class="form-group">
                        <label>Цена</label>
                                <input name="BuildingProducts[${currentIndex}].Product.PriceWithTax" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol7 = document.createElement('div');
            newCol7.className = 'col-sm';
            newCol7.innerHTML = `
                    <div class="form-group">
                        <label>Вкупно</label>
                                <input name="BuildingProducts[${currentIndex}].Product.Total" class="form-control form-control-sm" />
                        <span class="text-danger"></span>
                    </div>
                `;

            var newCol8 = document.createElement('div');
            newCol8.className = 'col-sm';
            newCol8.innerHTML = `
                    <div class="form-group">
                        <label>Вк.по лице</label>
                        <input name="BuildingProducts[${currentIndex}].Product.TotalPerPerson" class="form-control form-control-sm" readonly />
                        <span class="text-danger"></span>
                    </div>
                `;

            // Append columns to the new row
            newRow.appendChild(newCol1);
            newRow.appendChild(newCol2);
            newRow.appendChild(newCol3);
            newRow.appendChild(newCol4);
            newRow.appendChild(newCol5);
            newRow.appendChild(newCol6);
            newRow.appendChild(newCol7);
            newRow.appendChild(newCol8);

            // Append the new row to the container
            container.appendChild(newRow);
        }
    </script>

}
