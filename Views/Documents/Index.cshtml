@using CleanHub.Entities.Enums
@using CleanHub.Extensions
@model List<CleanHub.ViewModels.DocumentViewModel>
@{
    ViewData["Title"] = "Сметки";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var invoiceId = @ViewBag.InvoiceId;
    var errors = ViewBag.Errors as List<string>;
    var showModal = ViewBag.ShowErrorModal ?? false;
}

@if (showModal && errors != null && errors.Any())
{
    @await Html.PartialAsync("Error", errors)
}

<hr />
<form asp-action="InvoiceFiltered" asp-controller="Documents" method="get" id="filterForm">
    <div class="row">
        @if (ViewBag.Buildings != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="buildingSearch">Објект</label>
                    <input class="form-control" list="buildingOptions" id="buildingSearch" name="buildingName" placeholder="Пребарувај">
                    <input type="hidden" id="buildingId" name="buildingId">
                    <datalist id="buildingOptions">
                        @foreach (var building in (IEnumerable<SelectListItem>)ViewBag.Buildings)
                        {
                            <option value="@building.Text" data-id="@building.Value"></option>
                        }
                    </datalist>
                </div>
            </div>
        }
        else
        {
            <p>Нема пронајдено објекти!</p>
        }
        @if (ViewBag.PaymentStatusList != null)
        {
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                <div class="form-group mb-0">
                    <label for="paymentStatusId">Статус</label>
                    @Html.DropDownList("paymentStatusId", (IEnumerable<SelectListItem>)ViewBag.PaymentStatusList, new { @class = "form-control" })
                </div>
            </div>
        }
        else
        {
            <p>Нема пронајдено статус!</p>
        }
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
            <div class="form-group mb-0">
                <h6>Од</h6>
                <input id="dateFrom" name="dateFrom" placeholder="Внесете датум во формат ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateFrom" />
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
            <h6>До</h6>
            <div class="form-group mb-0">
                <input id="dateTo" name="dateTo" placeholder="Внесете датум во формат ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateTo" />
            </div>
        </div>
        <li class="divider"></li> <!-- Optional: Trennlinie -->
        <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
            <div class="form-group mb-0">
                <button type="submit" class="form-control btn btn-primary">Пребарувај</button>
            </div>
        </div>
        <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
            <div class="form-group mb-0">
                <button type="button" class="form-control btn btn-secondary" id="navigateButton">Извади сметки</button>
            </div>
        </div>
    </div>
</form>
<br />

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Станар</th>
                        <th>Опис</th>
                        <th>Вкупно</th>
                        <th>Сметка</th>
                        <th>Статус</th>
                        <th>Дата на плаќање</th>
                        <th>Платено на</th>
                        <th>Тип на плаќање</th>
                        <th>Број на плаќање</th>
                        <th>Задоцнување</th>
                        <th>Камата</th>
                        <th>Нова вредност</th>
                        <th>Функции</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td>@(invoice.Customer?.CustomerInfo ?? "")</td>
                                <td>@invoice.Description</td>
                                <td>@invoice.TotalOutput МКД</td>
                                <td>@(invoice.ToDocument ?? "")</td>
                                <td>
                                    @if (invoice.PaymentStatus == PaymentStatus.Платено)
                                    {
                                        <span class="badge badge-light-success inv-status">@invoice.PaymentStatus</span>
                                    }
                                    else if (invoice.PaymentStatus == PaymentStatus.Неплатено)
                                    {
                                        <span class="badge badge-light-warning inv-status">@invoice.PaymentStatus</span>
                                    }
                                    else if (invoice.PaymentStatus == PaymentStatus.Делумно)
                                    {
                                        <span class="badge badge-light-warning inv-status">@invoice.PaymentStatus</span>
                                    }
                                    else if (invoice.PaymentStatus == PaymentStatus.Задоцнето)
                                    {
                                        <span class="badge badge-light-danger inv-status">@invoice.PaymentStatus</span>
                                    }
                                    else
                                    {
                                        <span>Неопределен статус</span>
                                    }
                                </td>
                                <td>@(invoice.DateReceived?.ToString("dd.MM.yyyy") ?? "")</td>
                                <td>@(invoice.PaymentDate?.ToString("dd.MM.yyyy") ?? "")</td>
                                <td>@(invoice.PaymentType.GetEnumDescription() ?? "")</td>
                                <td>@(invoice.PaymentNumber ?? "—")</td>
                                <td>@(invoice.Delay ?? 0) дена</td>
                                <td>@(invoice.ChargesInPercent ?? 0) %</td>
                                <td>@((invoice.NewTotal ?? invoice.TotalOutput) + " МКД")</td>
                                <td>
                                    @if (invoice.PaymentStatus != PaymentStatus.Платено)
                                    {
                                        <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Details" asp-controller="Documents" asp-route-id="@invoice.Id">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </a>
                                        <button type="button" class="btn btn-dark mb-2 me-4" data-bs-toggle="modal" data-bs-target="#inputFormModal">
                                            Плати
                                        </button>
                                        <div class="modal fade inputForm-modal" id="inputFormModal" tabindex="-1" role="dialog" aria-labelledby="inputFormModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header" id="inputFormModalLabel">
                                                        <h5 class="modal-title">Внесете податоци</h5>
                                                    </div>
                                                    <div class="modal-body">
                                                        <form asp-action="SetStatusPayment" asp-controller="Documents" asp-route-id="@invoice.Id" method="post" class="mt-0">

                                                            <!-- Hidden input to include the model -->
                                                            @Html.HiddenFor(m => @invoice.Id)
                                                            @Html.AntiForgeryToken()

                                                            <!-- Тип на плакање -->
                                                            <div class="form-group">
                                                                <label for="paymentType">Тип на плакање</label>
                                                                <select id="paymentType" name="PaymentTypee" class="form-control form-control-sm">
                                                                    @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                                                                    {
                                                                        <option value="@paymentType">@paymentType.GetEnumDescription()</option>
                                                                    }
                                                                </select>
                                                            </div>

                                                            <!-- Дата на плаќање -->
                                                            <div class="form-group">

                                                                <label for="paymentDate">Дата на плаќање</label>
                                                                <div class="input-group mb-3">
                                                                    <span class="input-group-text">
                                                                    </span>
                                                                    <input type="datetime-local" asp-for="@invoice.PaymentDate" id="paymentDate" name="PaymentDate" class="form-control form-control-sm" />
                                                                </div>
                                                            </div>
                                                            <!-- Број на плаќање -->
                                                            <div class="form-group">

                                                                <label for="paymentNumber">Број на плаќање</label>
                                                                <div class="input-group mb-3">
                                                                    <span class="input-group-text">

                                                                    </span>
                                                                    <input type="text" id="paymentNumber" name="PaymentNumber" asp-for="@invoice.PaymentNumber" class="form-control form-control-sm" />
                                                                </div>
                                                            </div>

                                                            <div class="modal-footer">
                                                                <button type="submit" class="btn btn-primary mt-2 mb-2 btn-no-effect" data-bs-dismiss="modal">Плати</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }
                                    else
                                    {
                                        <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Details" asp-controller="Documents" asp-route-id="@invoice.Id">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">Нема пронајдени податоци</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("filterForm");
        const navigateButton = document.getElementById("navigateButton");
        const searchButton = form.querySelector('button[type="submit"]'); // Der "Пребарувај" Button
        const originalAction = form.action; // Speichert die ursprüngliche Action

        navigateButton.addEventListener("click", function () {
            form.action = '@Url.Action("CombineAndDownloadPdfs", "Documents")';
            form.submit();
        });

        searchButton.addEventListener("click", function () {
            form.action = originalAction; // Setzt die ursprüngliche Action zurück
        });
    });
    document.getElementById('buildingSearch').addEventListener('input', function () {
        const selectedValue = this.value;
        const options = document.querySelectorAll('#buildingOptions option');
        let selectedId = '';

        // Find the matching option and get its data-id
        options.forEach(option => {
            if (option.value === selectedValue) {
                selectedId = option.getAttribute('data-id');
            }
        });

        // Set the hidden input's value
        document.getElementById('buildingId').value = selectedId || '';
    });

    document.addEventListener("DOMContentLoaded", function () {
        var dateFromInput = document.getElementById("dateFrom");
        var dateToInput = document.getElementById("dateTo");
        var navigateButton = document.getElementById("navigateButton");

        // Regulärer Ausdruck für dd.mm.yyyy
        var dateRegex = /^\d{2}\.\d{2}\.\d{4}$/;

        function isValidDate(dateString) {
            return dateRegex.test(dateString);
        }

        function toggleButtonState() {
            if (isValidDate(dateFromInput.value.trim()) && isValidDate(dateToInput.value.trim())) {
                navigateButton.disabled = false;
            } else {
                navigateButton.disabled = true;
            }
        }

        // Initial prüfen (z.B. falls Werte aus ViewBag geladen wurden)
        toggleButtonState();

        // Event-Listener für Änderungen an den Inputs
        dateFromInput.addEventListener("input", toggleButtonState);
        dateToInput.addEventListener("input", toggleButtonState);
    });


</script>