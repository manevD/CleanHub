@* @model List<CleanHub.Entities.Resident>
<style>
    .table-container {
        overflow: auto !important; /* Ensure overflow is set to auto to allow scrolling */
        max-height: 400px; /* Set a maximum height for the container to trigger scrolling */
        /* You may need to adjust the maximum height based on your layout and content */
    }
</style>
<div class="table-container">
    <div class="col-xl-12 col-lg-12 col-sm-12 layout-top-spacing layout-spacing">
        <div class="widget-content widget-content-area br-8">
            <table id="invoice-list" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th></th>
                        <th>Име</th>
                        <th>Презиме</th>
                        <th>Е-Маил</th>
                        <th>Активен</th>
                        <th>Веб</th>
                        <th>Телефонски број</th>
                        <th>Улица</th>
                        <th>Функции</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var resident in @Model)
                    {
                        <tr>
                            <td></td>
                            <td><p><span>@resident.FirstName</span></p></td>
                            <td>
                                <div class="d-flex">
                                    <p class="align-self-center mb-0 user-name"> @resident.LastName  </p>
                                </div>
                            </td>
                            <td><a class="inv-email"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mail"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg> @resident.Email</a></td>
                            @if (resident.Inactive)
                            {
                                <td><span class="badge badge-light-danger inv-status">Неактивен</span></td>
                            }
                            else
                            {
                                <td><span class="badge badge-light-success inv-status">Активен</span></td>
                            }
                            <td><span class="inv-amount"> @resident.Web</span></td>
                            <td><span class="inv-amount"> @resident.PhoneNumber</span></td>
                            <td><span class="inv-amount"> @resident.Building.Name</span></td>
                            <td>
                                <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Details" asp-controller="Customers" asp-route-id="@resident.Id">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </a>
                                <a class="badge badge-light-primary text-start me-2 action-edit" asp-action="Edit" asp-controller="Customers" asp-route-id="@resident.Id"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></a>
                                <a class="badge badge-light-danger text-start action-delete" asp-action="Delete" asp-controller="Customers" asp-route-id="@resident.Id"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div> *@