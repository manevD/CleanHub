@model IEnumerable<CleanHub.Models.Building>

@{
    ViewData["Title"] = "Објекти";
    Layout = "~/Views/Shared/_Layout.cshtml";

}


<div class="row">
    <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
        <p>
            <a class="btn btn-primary"  asp-action="Create">Креирај Објект</a>
        </p>
        <div class="statbox widget box box-shadow">
            <div class="widget-content widget-content-area">
               
                <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th>
                                Број на Станари
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NumberOfUnits)
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">Отвори</a>
                                        <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference1" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </button>
                                        <div class="dropdown-menu" aria-labelledby="dropdownMenuReference1">
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">Измени</a>
                                            <a class="dropdown-item" asp-action="Delete" asp-route-id="@item.Id">Избриши</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>