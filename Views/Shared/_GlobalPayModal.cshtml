@using CleanHub.Entities.Enums
@using CleanHub.Extensions

<!-- МОДАЛОТ Е ИЗВАДЕН КОМПЛЕТНО НАДВОР ОД СИДЕБАРОТ И СЕГА НЕМА ДА ПРАВИ СЕНКА -->
<div class="modal fade" id="globalPayModal" tabindex="-1" role="dialog" aria-labelledby="globalPayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="globalPayForm" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Брзо плаќање на сметка</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <!-- 0. Директно пребарување по број на фактура -->
                    <div class="form-group mb-2">
                        <label for="globalInvoiceNumber" class="form-label">Број на фактура</label>
                        <div class="search-field">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                            <input type="number" min="1" inputmode="numeric" id="globalInvoiceNumber" class="form-control"
                                   placeholder="Внесете број, пр. 1245" autocomplete="off">
                        </div>
                    </div>
                    <div id="globalInvoiceResult" class="pay-result" hidden></div>

                    <div class="pay-divider"><span>или пребарај по партнер</span></div>

                    <!-- 1. Избери Станар / Партнер преку Пребарување -->
                    <div class="form-group mb-3">
                        <label for="globalCustomerSearch" class="form-label">Партнер</label>
                        <input class="form-control" list="globalCustomerOptions" id="globalCustomerSearch" name="customerName"
                               placeholder="Пребарувај..." autocomplete="off">

                        <!-- Скриеното поле каде што се чува и се праќа ID-то кон бекендот -->
                        <input type="hidden" id="globalCustomerId" name="customerId">

                        <!-- Динамички ќе се наполни преку fetch од базата -->
                        <datalist id="globalCustomerOptions"></datalist>
                    </div>

                    <!-- 2. Избери Неплатена Сметка -->
                    <div class="form-group mb-3">
                        <label for="globalInvoiceId" class="form-label">Избери Неплатена Сметка</label>
                        <select id="globalInvoiceId" name="invoiceId" class="form-select" required disabled>
                            <option value="">-- Прво избери станар --</option>
                        </select>
                    </div>

                    <div class="row">
                        <!-- Начин на плаќање -->
                        <div class="col-md-6 form-group mb-3">
                            <label for="globalPaymentType" class="form-label">Тип на плаќање</label>
                            <select id="globalPaymentType" name="PaymentType" class="form-select">
                                @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                                {
                                    <option value="@((int)paymentType)">@paymentType.GetEnumDescription()</option>
                                }
                            </select>
                        </div>

                        <!-- Датум на плаќање -->
                        <div class="col-md-6 form-group mb-3">
                            <label for="globalPaymentDate" class="form-label">Датум на плаќање</label>
                            <input type="date" id="globalPaymentDate" name="PaymentDate" class="form-control" required />
                        </div>
                    </div>

                    <!-- Број на плаќање / извод -->
                    <div class="form-group mb-3">
                        <label for="globalPaymentNumber" class="form-label">Број на уплата / извод</label>
                        <input type="text" id="globalPaymentNumber" name="PaymentNumber" class="form-control" placeholder="Пр. Извод 45 / Блок 12" />
                    </div>

                    <!-- Опис -->
                    <div class="form-group mb-3">
                        <label for="globalPaymentDescription" class="form-label">Опис на плаќањето</label>
                        <textarea id="globalPaymentDescription" name="PaymentDescription" class="form-control" rows="2" placeholder="Пр. Редовно плаќање на трошоци"></textarea>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Откажи</button>
                    <button type="submit" class="btn btn-success">Зачувај плаќање</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modalElement = document.getElementById('globalPayModal');
        const customerInput = document.getElementById('globalCustomerSearch');
        const customerHiddenId = document.getElementById('globalCustomerId');
        const customerDatalist = document.getElementById('globalCustomerOptions');
        const invoiceSelect = document.getElementById('globalInvoiceId');
        const paymentDateInput = document.getElementById('globalPaymentDate');
        const form = document.getElementById('globalPayForm');
        const numberInput = document.getElementById('globalInvoiceNumber');
        const resultBox = document.getElementById('globalInvoiceResult');
        const esc = window.mhEscape || (t => String(t == null ? '' : t));

        if (!modalElement) return;

        // 0. ПРЕБАРУВАЊЕ ПО БРОЈ НА ФАКТУРА
        function selectInvoice(inv) {
            customerHiddenId.value = inv.customerId || "";
            customerInput.value = inv.customer || "";
            invoiceSelect.innerHTML = "";
            const opt = document.createElement('option');
            opt.value = inv.id;
            opt.textContent = '№ ' + inv.number + ' · ' + (inv.period || inv.date || '') + ' (' + inv.total + ')';
            invoiceSelect.appendChild(opt);
            invoiceSelect.disabled = false;
            selectedPaid = !!inv.paid;

            resultBox.innerHTML =
                '<div class="pay-card ' + (inv.paid ? 'is-paid' : 'is-open') + '">' +
                    '<div class="pay-card-head"><strong>Фактура № ' + esc(inv.number) + '</strong>' +
                        '<span class="pay-status">' + (inv.paid ? 'Платена' : esc(inv.status)) + '</span></div>' +
                    '<dl>' +
                        '<dt>Партнер</dt><dd>' + esc(inv.customer || '-') + '</dd>' +
                        '<dt>Објект</dt><dd>' + esc(inv.building || '-') + '</dd>' +
                        '<dt>Период</dt><dd>' + esc(inv.period || '-') + '</dd>' +
                        '<dt>Датум</dt><dd>' + esc(inv.date || '-') + '</dd>' +
                        '<dt>Износ</dt><dd class="pay-amount">' + esc(inv.total) + '</dd>' +
                        (inv.paid ? '<dt>Платено</dt><dd>' + esc(inv.paymentDate || '') + (inv.paymentNumber ? ' · ' + esc(inv.paymentNumber) : '') + '</dd>' : '') +
                    '</dl>' +
                    (inv.paid ? '<p class="pay-warn">Оваа фактура е веќе платена.</p>' : '') +
                '</div>';
            resultBox.hidden = false;
        }

        function findByNumber() {
            const n = parseInt(numberInput.value, 10);
            if (!n) { resultBox.hidden = true; return; }
            resultBox.hidden = false;
            resultBox.innerHTML = '<div class="pay-card"><span class="spinner"></span> Се бара фактура № ' + n + '…</div>';

            fetch('/Documents/FindInvoiceByNumber?number=' + n)
                .then(res => res.json())
                .then(list => {
                    if (!list || list.length === 0) {
                        resultBox.innerHTML = '<div class="pay-card is-missing">Нема фактура со број ' + n + '.</div>';
                        return;
                    }
                    if (list.length === 1) { selectInvoice(list[0]); return; }

                    // Ист број во повеќе години/периоди — корисникот избира
                    resultBox.innerHTML = '<div class="pay-card"><div class="pay-card-head"><strong>Пронајдени ' + list.length + ' фактури со број ' + n + '</strong></div><div class="pay-choices"></div></div>';
                    const box = resultBox.querySelector('.pay-choices');
                    list.forEach(inv => {
                        const b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'pay-choice';
                        b.innerHTML = '<strong>' + esc(inv.customer || '-') + '</strong><span>' + esc(inv.period || inv.date || '') + ' · ' + esc(inv.total) + (inv.paid ? ' · платена' : '') + '</span>';
                        b.addEventListener('click', () => selectInvoice(inv));
                        box.appendChild(b);
                    });
                })
                .catch(() => { resultBox.innerHTML = '<div class="pay-card is-missing">Грешка при пребарување.</div>'; });
        }

        if (numberInput) {
            numberInput.addEventListener('input', () => {
                clearTimeout(numberTimer);
                numberTimer = setTimeout(findByNumber, 350);
            });
            numberInput.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); clearTimeout(numberTimer); findByNumber(); }
            });
        }

        let debounceTimer;
        let numberTimer;
        let selectedPaid = false;
        let customersCache = null; // листата се презема само еднаш по страна

        function getCustomers() {
            if (customersCache) return Promise.resolve(customersCache);
            return fetch('/Customers/GetAllCustomers')
                .then(res => res.json())
                .then(data => (customersCache = data || []));
        }

        // 1. ПРИ ОТВОРАЊЕ НА МОДАЛОТ
        modalElement.addEventListener('show.bs.modal', function () {
            if(customerInput) customerInput.value = "";
            if(customerHiddenId) customerHiddenId.value = "";
            if(customerDatalist) customerDatalist.innerHTML = "";

            invoiceSelect.innerHTML = '<option value="">-- Прво избери станар --</option>';
            invoiceSelect.disabled = true;
            numberInput.value = "";
            resultBox.hidden = true;
            resultBox.innerHTML = "";
            selectedPaid = false;
            setTimeout(() => numberInput.focus(), 300);

            if (paymentDateInput) {
                const today = new Date().toISOString().split('T')[0];
                paymentDateInput.value = today;
            }
        });

        // 2. LIVE SEARCH ЛОГИКА (Се активира при секое пишување)
        if (customerInput && customerDatalist) {
            customerInput.addEventListener("input", function () {
                const currentVal = this.value.trim();

                // Прво проверуваме дали корисникот издиректно КЛИКНАЛ на некоја опција од паѓачкото мени
                const options = customerDatalist.querySelectorAll("option");
                let idFound = "";
                options.forEach(option => {
                    if (option.value === currentVal) {
                        idFound = option.getAttribute("data-id");
                    }
                });

                // АКО Е КЛИКНАТО НА ПОСТОЕЧКА ОПЦИЈА: Го зачувуваме ID-то и ги вчитуваме сметките
                if (idFound) {
                    if (customerHiddenId.value !== idFound) {
                        customerHiddenId.value = idFound;
                        loadUnpaidInvoices(idFound);
                    }
                    return; // Прекини тука, нема потреба од ново пребарување во база
                }

                // АКО КОРИСНИКОТ СЕШТЕ ПИШУВА: Се активира Live Search со Debounce (одложување од 300мс)
                customerHiddenId.value = ""; // Се ресетира ID-то бидејќи уште се пишува
                invoiceSelect.innerHTML = '<option value="">-- Прво избери станар --</option>';
                invoiceSelect.disabled = true;

                clearTimeout(debounceTimer);

                if (currentVal.length < 2) {
                    customerDatalist.innerHTML = ""; // Не пребарувај ако има помалку од 2 букви
                    return;
                }

                debounceTimer = setTimeout(() => {
                    // ПРАЌАЊЕ НА ПРЕБАРУВАЊЕТО ДО БЕКЕНДОТ (Овде претпоставуваме дека GetAllCustomers прифаќа query или ги филтрираме тука)
                    getCustomers()
                        .then(data => {
                            customerDatalist.innerHTML = ""; // Исчисти ги старите резултати

                            // Филтрирање на податоците на фронтенд според тоа што го пишал корисникот
                            const filtered = data.filter(c => {
                                const name = (c.customerInfo || c.info || "").toLowerCase();
                                return name.includes(currentVal.toLowerCase());
                            });

                            // Наполни го паѓачкото мени со новите филтрирани резултати
                            filtered.forEach(c => {
                                let opt = document.createElement('option');
                                opt.value = c.customerInfo || c.info;
                                opt.setAttribute('data-id', c.id);
                                customerDatalist.appendChild(opt);
                            });
                        })
                        .catch(err => console.error("Грешка при Live Search:", err));
                }, 300); // 300 милисекунди пауза по последната стисната буква
            });
        }

        // 3. ФУНКЦИЈА ЗА ВЧИТУВАЊЕ НЕПЛАТЕНИ СМЕТКИ
        function loadUnpaidInvoices(customerId) {
            invoiceSelect.innerHTML = '<option value="">-- Се вчитува... --</option>';
            invoiceSelect.disabled = true;

            fetch(`/Documents/GetUnpaidInvoices?customerId=${customerId}`)
                .then(res => res.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        invoiceSelect.innerHTML = '<option value="">Нема неплатени сметки за овој станар</option>';
                        return;
                    }

                    selectedPaid = false;
                    invoiceSelect.innerHTML = '<option value="">-- Избери сметка --</option>';
                    invoiceSelect.disabled = false;

                    data.forEach(inv => {
                        let opt = document.createElement('option');
                        opt.value = inv.id;
                        opt.textContent = inv.documentText;
                        invoiceSelect.appendChild(opt);
                    });
                })
                .catch(err => {
                    console.error("Грешка при вчитување фактури:", err);
                    invoiceSelect.innerHTML = '<option value="">Грешка при вчитавање</option>';
                });
        }

        // 4. ИСПРАЌАЊЕ НА ФОРМАТА
        form.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!invoiceSelect.value) {
                alert("Внесете број на фактура или изберете партнер и сметка.");
                return;
            }
            if (selectedPaid && !confirm("Оваа фактура е веќе платена. Дали сигурно сакате повторно да ја зачувате?")) {
                return;
            }

            const formData = new FormData(this);

            fetch('/Documents/Pay', {
                method: 'POST',
                body: formData
            })
            .then(res => {
                if (res.ok) {
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) modal.hide();

                    document.body.classList.remove("modal-open");
                    document.querySelectorAll(".modal-backdrop").forEach(x => x.remove());

                    window.location.reload();
                } else {
                    alert("Грешка при извршување на плаќањето.");
                }
            })
            .catch(err => alert("Системска грешка: " + err));
        });
    });
</script>