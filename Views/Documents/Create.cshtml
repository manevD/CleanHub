    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>
            document.addEventListener('DOMContentLoaded', function () {

                // ===== PRICE CALC INIT =====
                const rows = document.querySelectorAll('.item-table tbody tr');
                rows.forEach(row => attachEvents(row));
                updatePriceWithTaxTotal();


                // ===== BUILDING SEARCH =====
                const buildingSearch = document.getElementById("buildingSearch");

                if (buildingSearch) {
                    buildingSearch.addEventListener("input", function () {

                        var buildingSearchValue = this.value;
                        let selectedId = '';

                        const options = document.querySelectorAll('#buildingOptions option');
                        var id = document.querySelector('input[name="id"]').value;

                        options.forEach(option => {
                            if (option.value === buildingSearchValue) {
                                selectedId = option.getAttribute('data-id');
                            }
                        });

                        if (selectedId) {
                            var url = '@Url.Action("Create")' + '?id=' + id + '&buildingId=' + selectedId;
                            window.location.href = url;
                        }
                    });
                }

            });
        </script>
        <script>
            // ================= HELPERS =================

            function parseNumber(val) {
                if (!val) return 0;
                return parseFloat(val.toString().replace(',', '.')) || 0;
            }

            function formatNumber(val) {
                return (val || 0).toFixed(2).replace('.', ',');
            }


            // ================= CALCULATE =================

                       function calculatePrice(row, source) {

                const priceInput = row.querySelector('input[id^="Price_"]');
                const taxInput = row.querySelector('input[id^="Tax_"]');
                const priceWithTaxInput = row.querySelector('input[id^="PriceWithTax_"]');
                const totalInput = row.querySelector('input[id^="Total_"]');
                const priceWithTaxTotal = row.querySelector('input[id^="PriceWithTaxTotal_"]');

                const customerCount = @(Model?.Building?.Customers?.Count ?? 0);

                let total = parseNumber(totalInput?.value);
                let price = parseNumber(priceInput?.value);
                let tax = parseNumber(taxInput?.value);

                if (source === "total" && total > 0) {
                    price = customerCount > 0 ? total / customerCount : total;
                    priceInput.value = formatNumber(price);
                }

                let priceWithTax = tax === 0 ? price : price + (price * tax / 100);
                            if (priceWithTaxInput)
                priceWithTaxInput.value = formatNumber(priceWithTax);

            if (priceWithTaxTotal)
                priceWithTaxTotal.value = formatNumber(priceWithTax);

                updatePriceWithTaxTotal();
            }


            // ================= TOTAL =================

            function updatePriceWithTaxTotal() {

                const rows = document.querySelectorAll('.item-table tbody tr');

                let totalSum = 0;

                rows.forEach(row => {
                    const el = row.querySelector('input[id^="PriceWithTaxTotal_"]');
                    if (!el) return;

                    let val = parseNumber(el.value);
                    totalSum += val;
                });

                document.querySelector('#totalPriceWithTax').innerText =
                    totalSum.toFixed(2).replace('.', ',');
            }


            // ================= EVENTS =================

            function attachEvents(row) {

                const priceInput = row.querySelector('input[id^="Price_"]');
                const totalInput = row.querySelector('input[id^="Total_"]');
                const taxInput = row.querySelector('input[id^="Tax_"]');

                priceInput?.addEventListener('input', () => calculatePrice(row, "price"));
                totalInput?.addEventListener('input', () => calculatePrice(row, "total"));
                taxInput?.addEventListener('input', () => calculatePrice(row, "tax"));

                // 👉 FORMAT само на blur
                [priceInput, totalInput, taxInput].forEach(input => {
                    input?.addEventListener('blur', () => {
                        let val = parseNumber(input.value);
                        input.value = formatNumber(val);
                    });
                });

                calculatePrice(row, "init");
                }


            // ================= ADD ROW =================

            let rowIndex = document.querySelectorAll('.item-table tbody tr').length;

            function addRow() {

                const tbody = document.querySelector(".item-table tbody");

                const newRow = document.createElement("tr");

                newRow.innerHTML = `

                    <td class="description">
                        <input type="hidden"
                               name="Building.BuildingProducts[${rowIndex}].IsNew"
                               value="true" />

                        <input type="text"
                               name="Building.BuildingProducts[${rowIndex}].ArticleNotes"
                               class="form-control form-control-sm article-notes" />
                    </td>

                    <td>
                        <input type="text"
                               name="Building.BuildingProducts[${rowIndex}].UnitOfMeasurement"
                               class="form-control form-control-sm" value="бр."/>
                    </td>

                    <td>
                        <input type="text"
                               name="Building.BuildingProducts[${rowIndex}].Quantity"
                               class="form-control form-control-sm" value="1" />
                    </td>

                    <td>
                        <input type="text"
                               id="Price_${rowIndex}"
                               name="Building.BuildingProducts[${rowIndex}].Price"
                               class="form-control form-control-sm" />
                    </td>

                    <td>
                        <input type="text"
                               id="Tax_${rowIndex}"
                               name="Building.BuildingProducts[${rowIndex}].Tax"
                               value="0"
                               class="form-control form-control-sm" />
                    </td>

                    <td>
                        <input type="text"
                               id="PriceWithTax_${rowIndex}"
                               name="Building.BuildingProducts[${rowIndex}].PriceWithTax"
                               class="form-control form-control-sm"
                               readonly />
                    </td>

                    <td>
                        <input type="text"
                               id="Total_${rowIndex}"
                               name="Building.BuildingProducts[${rowIndex}].Total"
                               class="form-control form-control-sm" />
                    </td>

                    <td>
                        <input type="text"
                               id="PriceWithTaxTotal_${rowIndex}"
                               name="Building.BuildingProducts[${rowIndex}].PriceWithTaxTotal"
                               class="form-control form-control-sm"
                               readonly />
                    </td>
                `;

                tbody.appendChild(newRow);
                attachEvents(newRow);
                rowIndex++;
            }

        </script>
        <script id="showInvoiceExistsModal">
            document.addEventListener("DOMContentLoaded", function () {

                const message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["InvoiceExists"]));

                if (message) {

                    const messageElement = document.getElementById("invoiceExistsMessage");
                    if (messageElement) {
                        messageElement.innerText = message;
                    }

                    const modalElement = document.getElementById("invoiceExistsModal");
                    const modal = new bootstrap.Modal(modalElement);

                    modal.show();
                }

            });
        </script>

        <script>
                         document.addEventListener("DOMContentLoaded", function () {

                const dateInput = document.getElementById("invoiceDate");

                if (!dateInput) return;

                dateInput.addEventListener("change", function () {

                    const dateValue = this.value;
                    if (!dateValue) return;

                    const date = new Date(dateValue);

                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const year = date.getFullYear();

                    const formatted = month + "." + year;

                    document.querySelectorAll(".article-notes").forEach(function (input) {

                        let baseText = input.value.split(" ").slice(0, -1).join(" ");

                        if (baseText === "")
                            baseText = input.value;

                        input.value = baseText + " " + formatted;
                    });

                });

            });
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                           const hidden = document.getElementById("actionTypeHidden");

                       document.querySelectorAll(".submit-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const hidden = document.getElementById("actionTypeHidden");
                    if (hidden) {
                        hidden.value = this.dataset.action;
                    }
                });
            });

            });
        </script>
       
    }