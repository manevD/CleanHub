@model CleanHub.Models.Invoice
<link href="~/layouts/horizontal-light-menu/css/light/loader.css" rel="stylesheet" type="text/css" />
<link href="~/layouts/horizontal-light-menu/css/dark/loader.css" rel="stylesheet" type="text/css" />
<script src="~/layouts/horizontal-light-menu/loader.js"></script>
<!-- BEGIN GLOBAL MANDATORY STYLES -->
<link href="https://fonts.googleapis.com/css?family=Nunito:400,600,700" rel="stylesheet">
<link href="~/src/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/layouts/horizontal-light-menu/css/light/plugins.css" rel="stylesheet" type="text/css" />
<link href="~/layouts/horizontal-light-menu/css/dark/plugins.css" rel="stylesheet" type="text/css" />
<!-- END GLOBAL MANDATORY STYLES -->
<!--  BEGIN CUSTOM STYLE FILE  -->
<link href="~/src/assets/css/light/apps/invoice-preview.css" rel="stylesheet" type="text/css" />
<link href="~/src/assets/css/dark/apps/invoice-preview.css" rel="stylesheet" type="text/css" />
<div class="row invoice layout-top-spacing layout-spacing">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

        <div class="doc-container">

            <div class="row">

                <div class="col-xl-9">

                    <div class="invoice-container">
                        <div class="invoice-inbox">

                            <div id="ct" class="">

                                <div class="invoice-00001">
                                    <div class="content-section">

                                        <div class="inv--head-section inv--detail-section">

                                            <div class="row">

                                                <div class="col-sm-6 col-12 mr-auto">
                                                    <div class="d-flex">
                                                        <img class="company-logo" src="~/src/logo3.png" alt="company">
                                                        <h3 class="in-heading align-self-center">@Model.Company.Name</h3>
                                                    </div>
                                                    <p class="inv-street-addr mt-3">@Model.Company.Address</p>
                                                    <p class="inv-email-address">@Model.Company.Email</p>
                                                    <p class="inv-email-address">@Model.Company.PhoneNumber</p>
                                                </div>

                                                <div class="col-sm-6 text-sm-end">
                                                    <p class="inv-list-number mt-sm-3 pb-sm-2 mt-4"><span class="inv-title">ИСПРАТНИЦА-ФАКТУРА БР: </span> <span class="inv-number">@Model.InvoiceNumber</span></p>
                                                    <p class="inv-created-date mt-sm-5 mt-3"><span class="inv-title">Издадена на : </span> <span class="inv-date">@Model.CreatedDate</span></p>
                                                    <p class="inv-due-date"><span class="inv-title">Месец на плаќање : </span> <span class="inv-date">@Model.DueDate.Date.ToString("MMMM yyyy")</span></p>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="inv--detail-section inv--customer-detail-section">
                                            <div class="row">

                                                <div class="col-xl-8 col-lg-7 col-md-6 col-sm-4 align-self-center">
                                                    <p class="inv-to"></p>
                                                </div>

                                                <div class="col-xl-4 col-lg-5 col-md-6 col-sm-8 col-12 order-sm-0 order-1 text-sm-end">
                                                    <p class="inv-customer-name">@Model.Resident.FirstName  @Model.Resident.LastName</p>
                                                    <p class="inv-street-addr">@Model.Resident.Building.Name </p>
                                                    <p class="inv-email-address">@Model.Resident.Email</p>
                                                    <p class="inv-email-address">@Model.Resident.PhoneNumber</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="inv--product-table-section">
                                            <div class="table-responsive">
                                                <table class="table">
                                                    <thead class="">
                                                        <tr>
                                                            <th scope="col">Артикал</th>
                                                            <th class="text-end" scope="col">Кол</th>
                                                            <th class="text-end" scope="col">Цена</th>
                                                            <th class="text-end" scope="col">Цена со ДДВ</th>
                                                            <th class="text-end" scope="col">Рабат</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>Чистење за месец Март/2024</td>
                                                            <td class="text-end">1</td>
                                                            <td class="text-end">120</td>
                                                            <td class="text-end">120</td>
                                                            <td class="text-end">120</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Управител за месец Март/2024</td>
                                                            <td class="text-end">1</td>
                                                            <td class="text-end">120</td>

                                                            <td class="text-end">230</td>
                                                            <td class="text-end">230</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Резервен фонд за месец Март/2024</td>
                                                            <td class="text-end">1</td>
                                                            <td class="text-end">120</td>
                                                            <td class="text-end">405</td>
                                                            <td class="text-end">405</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Потрошена електр.енер.за 03/2024</td>
                                                            <td class="text-end">1</td>
                                                            <td class="text-end">120</td>
                                                            <td class="text-end">2500</td>
                                                            <td class="text-end">2500</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="inv--total-amounts">

                                            <div class="row mt-4">
                                                <div class="col-sm-5 col-12 order-sm-0 order-1">
                                                </div>
                                                <div class="col-sm-7 col-12 order-sm-1 order-0">
                                                    <div class="text-sm-end">
                                                        <div class="row">
                                                            <div class="col-sm-8 col-7">
                                                                <p class="">Sub Total :</p>
                                                            </div>
                                                            <div class="col-sm-4 col-5">
                                                                <p class="">$3155</p>
                                                            </div>
                                                            <div class="col-sm-8 col-7">
                                                                <p class="">Tax 10% :</p>
                                                            </div>
                                                            <div class="col-sm-4 col-5">
                                                                <p class="">$315</p>
                                                            </div>
                                                            <div class="col-sm-8 col-7">
                                                                <p class=" discount-rate">Shipping :</p>
                                                            </div>
                                                            <div class="col-sm-4 col-5">
                                                                <p class="">$10</p>
                                                            </div>
                                                            <div class="col-sm-8 col-7">
                                                                <p class=" discount-rate">Discount 5% :</p>
                                                            </div>
                                                            <div class="col-sm-4 col-5">
                                                                <p class="">$150</p>
                                                            </div>
                                                            <div class="col-sm-8 col-7 grand-total-title mt-3">
                                                                <h4 class="">Grand Total : </h4>
                                                            </div>
                                                            <div class="col-sm-4 col-5 grand-total-amount mt-3">
                                                                <h4 class="">$3480</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="inv--note">

                                            <div class="row mt-4">
                                                <div class="col-sm-6 col-12 order-sm-0 order-1">
                                                    <p>Примил</p>
                                                </div>
                                                <div class="col-sm-6 col-12 order-sm-1 order-1">
                                                    <p>Потпис Виолета</p>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-xl-3">

                    <div class="invoice-actions-btn">

                        <div class="invoice-action-btn">

                            <div class="row">
                                <div class="col-xl-12 col-md-3 col-sm-6">
                                    <a href="javascript:void(0);" class="btn btn-primary btn-send">Send Invoice</a>
                                </div>
                                <div class="col-xl-12 col-md-3 col-sm-6">
                                    <a href="javascript:void(0);" class="btn btn-secondary btn-print  action-print">Print</a>
                                </div>
                                <div class="col-xl-12 col-md-3 col-sm-6">
                                    <a href="javascript:void(0);" class="btn btn-success btn-download">Download</a>
                                </div>
                                <div class="col-xl-12 col-md-3 col-sm-6">
                                    <a href="./app-invoice-edit.html" class="btn btn-dark btn-edit">Edit</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>@* 
