@model CleanHub.ViewModels.CardsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<hr />

<form asp-action="CustomersReserve" asp-controller="Cards" method="get">

    <div class="row">

        @if (ViewBag.Customers != null)
        {
            <div class="col-lg-2 col-md-3">

                <div class="form-group mb-0">

                    <label for="customerSearch">Партнер</label>

                    <input class="form-control"
                           list="customerOptions"
                           id="customerSearch"
                           name="customerName"
                           placeholder="Пребарувај"
                           value="@ViewBag.SelectedCustomerName" />

                    <input type="hidden"
                           id="customerId"
                           name="customerId"
                           value="@ViewBag.CustomerId" />

                    <datalist id="customerOptions">

                        @foreach (var customer in (IEnumerable<SelectListItem>)ViewBag.Customers)
                        {
                            <option value="@customer.Text"
                                    data-id="@customer.Value">
                            </option>
                        }

                    </datalist>

                </div>

            </div>
        }
        else
        {
            <p>Нема пронајдено партнери!</p>
        }

        <div class="col-lg-2 col-md-3">

            <div class="form-group mb-0">

                <h6>Од</h6>

                <input id="dateFrom"
                       name="dateFrom"
                       type="text"
                       class="form-control flatpickr flatpickr-input active"
                       placeholder="ден.месец.година"
                       value="@ViewBag.DateFrom" />

            </div>

        </div>

        <div class="col-lg-2 col-md-3">

            <div class="form-group mb-0">

                <h6>До</h6>

                <input id="dateTo"
                       name="dateTo"
                       type="text"
                       class="form-control flatpickr flatpickr-input active"
                       placeholder="ден.месец.година"
                       value="@ViewBag.DateTo" />

            </div>

        </div>

    </div>

    <br />

    <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">

        <div class="form-group mb-0">

            <button type="submit"
                    class="btn btn-primary">
                Пребарувај
            </button>

        </div>

    </div>

</form>


<div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">

    <div class="statbox widget box box-shadow">

        <div class="widget-content widget-content-area">

            <table id="customer-reserve"
                   class="table dt-table-hover"
                   style="width:100%">

                <thead>

                    <tr>
                        <th>Бр.</th>
                        <th>Дата</th>
                        <th>Опис</th>
                        <th>Сметка</th>
                        <th>Побарува</th>
                        <th>Должи</th>
                        <th>Функции</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.CustomerFinanfical != null &&
                         Model.CustomerFinanfical.Any())
                    {
                        var counter = 0;

                        @foreach (var invoice in Model.CustomerFinanfical.OrderBy(x => x.DatumF))
                        {
                            counter++;

                            <tr>

                                <td>
                                    @counter
                                </td>

                                <td>
                                    @(invoice.DatumF?.ToString("dd.MM.yyyy"))
                                </td>

                                <td>
                                    @invoice.Description
                                </td>

                                <td>
                                    @invoice.InvoiceId
                                </td>

                                <td>
                                    @invoice.Demands МКД
                                </td>

                                <td>
                                    @invoice.Owes МКД
                                </td>

                                <td>

                                    @if (@invoice.Source == "bookFinancial")
                                    {
                                        <form asp-action="DeleteBookFinancial"
                                              asp-controller="Cards"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Дали сте сигурни дека сакате да го избришете ова плаќање?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@invoice.Id" />
                                            <input type="hidden" name="returnPage" value="CustomersReserve" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Избриши">
                                                Избриши
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                        <tr>

                            <th></th>
                            <th></th>

                            <th>
                                Вкупно
                            </th>

                            <th></th>

                            <th>
                                Побарува :
                                @Model.CustomerDemandsTotal
                            </th>

                            <th>
                                Должи :
                                @Model.CustomerOwesTotal
                            </th>

                            <th></th>

                        </tr>

                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center">
                                Нема пронајдени податоци
                            </td>

                        </tr>
                    }

                </tbody>

                <tfoot>

                    <tr>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th>
                            Побарува :
                            @Model.CustomerDemandsTotal
                        </th>

                        <th>
                            Должи :
                            @Model.CustomerOwesTotal
                        </th>

                        <th></th>

                    </tr>

                </tfoot>

            </table>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const customerSearch =
                document.getElementById('customerSearch');

            const customerId =
                document.getElementById('customerId');

            if (customerSearch && customerId) {

                customerSearch.addEventListener('input', function() {

                    const selectedValue = this.value;

                    const options =
                        document.querySelectorAll('#customerOptions option');

                    let selectedId = '';

                    options.forEach(function(option) {

                        if (option.value === selectedValue) {

                            selectedId =
                                option.getAttribute('data-id');

                        }

                    });

                    customerId.value = selectedId || '';

                });

            }

        });


        $(document).ready(function() {

            $('#customer-reserve').DataTable({

                ordering: false,

                order: [],

                dom:
                    "<'dt--top-section'<'row'<'col-sm-12 col-md-6 d-flex justify-content-md-start justify-content-center'B><'col-sm-12 col-md-6 d-flex justify-content-md-end justify-content-center mt-md-0 mt-3'f>>>" +
                    "<'table-responsive'tr>" +
                    "<'dt--bottom-section d-sm-flex justify-content-sm-between text-center'<'dt--pages-count mb-sm-0 mb-3'i><'dt--pagination'p>>",

                buttons: [
                    {
                        extend: 'copy',
                        className: 'btn'
                    },
                    {
                        extend: 'csv',
                        className: 'btn'
                    },
                    {
                        extend: 'excel',
                        className: 'btn'
                    },
                    {
                        extend: 'print',
                        className: 'btn'
                    }
                ],

                oLanguage: {

                    oPaginate: {

                        sPrevious:
                            '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>',

                        sNext:
                            '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>'

                    },

                    sInfo: "Страна _PAGE_ од _PAGES_",

                    sSearch:
                        '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',

                    sSearchPlaceholder: "Пребарувај...",

                    sLengthMenu: "Results : _MENU_"
                },

                stripeClasses: [],

                lengthMenu: [7, 10, 20, 50],

                pageLength: 10

            });

        });

    </script>
}