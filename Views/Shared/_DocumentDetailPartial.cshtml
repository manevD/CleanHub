@model CleanHub.ViewModels.DocumentViewModel
@{
    double summ = 0;
    double summDemands = 0;
    string result = "0";
    if (Model != null)
    {
        summ = Model.TotalBuildingOwes;
        summDemands = Model.TotalBuildingDemands;
        double difference = (summ - summDemands);
        var message = "Вашата состојба на резервен фонд: ";
        if (summDemands == 0)
        {
            result = "0 МКД";
        }
        else if (summDemands > summ)
        {
            result = message + " Во претплата " + (-difference) + " МКД";
        }
        else
        {
            result = message + " Во минус " + difference +  " МКД";
        }
    }
}

<link href="~/layouts/horizontal-light-menu/css/light/loader.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/src/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/layouts/horizontal-light-menu/css/light/plugins.css" rel="stylesheet" type="text/css" media="all" />
<link href="~/src/assets/css/light/apps/invoice-preview.css" rel="stylesheet" type="text/css" media="all" />

<style>
    .medium-small-text {
        font-size: 12px;
    }
    .horizontal_line {
        width: 100%;
        height: 5px;
        border-top: 5px dotted black;
    }

    .compact-section {
        padding: 3px;
        margin: 3px 0;
    }

    .boxed {
        border: 1px solid #000;
        padding: 10px;
        border-radius: 5px;
        background-color: #f9f9f9;
        margin: 10px 0;
    }

    @@media print {
        body * {
            visibility: hidden;
        }
        .invoice, .invoice * {
            visibility: visible;
        }
        .invoice {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none;
        }
        .invoice-actions-btn {
            display: none;
        }
    }
</style>

<div class="row invoice layout-top-spacing layout-spacing" id="Grid" style="font-size: 0.70rem;">
    <div class="col-xl-12">
        <div class="doc-container">
            <div class="invoice-container">
                <div class="invoice-inbox">
                    <div id="ct">
                        <div class="invoice-00001">
                            <div class="content-section">
                                <div class="inv--head-section inv--detail-section">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="d-flex">
                                                <img class="company-logo" src="~/src/logo3.png" alt="Logo">
                                                <h3 class="in-heading align-self-center">@Model?.Company?.Name</h3>
                                            </div>
                                            <p>@Model?.Company?.Address</p>
                                            <p>@Model?.Company?.Email</p>
                                            <p>@Model?.Company?.PhoneNumber</p>
                                            <p>ЕДБ: @Model?.Company?.VATID</p>
                                            <p>@Model?.Company?.IBAN</p>
                                        </div>
                                        <div class="col-sm-6 text-sm-end">
                                            <p><span>ИСПРАТНИЦА-ФАКТУРА БР: </span><span>@Model?.Number</span></p>
                                            <p><span>Издадена на : </span><span>@Model?.Date?.ToString("dd.MM.yyyy")</span></p>
                                            <p><span>Рок на плаќање до: </span><span>@Model?.DateReceived?.ToString("dd.MM.yyyy")</span></p>
                                            <p>@Model?.Customer?.CustomerInfo</p>
                                            <p>@Model?.Customer?.Adress</p>
                                            <p>@Model?.Customer?.Email</p>
                                            <p>@Model?.Customer?.PhoneNumber</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="inv--detail-section inv--customer-detail-section compact-section medium-small-text">
                                    <table class="table medium-small-text">
                                        <thead>
                                            <tr>
                                                <th>Артикал</th>
                                                <th class="text-end">Ед.М</th>
                                                <th class="text-end">Кол</th>
                                                <th class="text-end" scope="col">Цена</th>
                                                <th class="text-end">Цена ДДВ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model?.Books != null && Model.Books.Any())
                                            {
                                                foreach (var article in Model.Books)
                                                {
                                                    <tr>
                                                        <td>@article.ArticleNotes</td>
                                                        <td class="text-end">@article.UnitOfMeasurement</td>
                                                        <td class="text-end">@article.Quantity</td>
                                                        <td class="text-end">@article.Price!.Value.ToString("F2")</td>
                                                        <td class="text-end">@article.PriceWithTax!.Value.ToString("F2")</td>
                                                    </tr>
                                                }
                                            }
                                            <tr>
                                                <td colspan="4"></td>
                                                <td class="text-end">за наплата: @Model?.TotalOutput</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="inv--additional-notes mt-2">
                                    @Html.Raw(Model?.Company?.InvoiceNotice ?? "")
                                  <br/>
                                    <strong>@result</strong>
                                    @if (@Model!.Customer.Subscription.HasValue && @Model!.Customer.Subscription > 0)
                                    {
                                        <br />
                                        <strong>Вие сте во претплате : @Model.Customer.Subscription МКД</strong>
                                    }
                                </div>
                                <div class="inv--note">
                                    <div class="row mt-4">
                                        <div class="col-sm-6 col-12 order-sm-0 order-1">
                                            <p>Примил</p>
                                        </div>
                                        <div class="col-sm-6 col-12 order-sm-1 order-1 text-sm-end">
                                            <p>Потпис Виолета</p>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="horizontal_line" style="margin-top:60px;"></div>
                                <div class="inv--footer mt-2">
                                    <div class="row">
                                        <div class="col-sm-4 col-12">
                                            <p class="inv-customer-name">@Model?.Customer?.CustomerInfo</p>
                                            <p class="inv-email-address">@Model?.Customer?.Adress</p>
                                        </div>
                                        <div class="col-sm-4 col-12 text-center mt-2">
                                            <p>@Model?.Company?.Name</p>
                                            <p class="inv-street-addr" >@Model?.Company?.Address</p>
                                        </div>
                                        <div class="col-sm-4 col-12 text-sm-end" >
                                            <p class="inv-list-number mt-2">
                                                <span class="inv-title">испратница-фактура бр:</span>
                                                <span>@Model?.Number</span>
                                            </p>
                                            <p class="text-end">вкупно за наплата: @Model?.TotalOutput ден</p>
                                            <b>@Model?.ToDocument</b>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model != null && !Model.IsForPdf )
        {
            @if (!string.IsNullOrEmpty(@Model?.Customer?.Email))
            {
                <div class="invoice-actions-btn">
                    <form asp-action="GeneratePdfTest" asp-controller="Documents">
                        <input type="hidden" asp-for="Id" />
                        <input type="submit" value="Испрати Сметка" class="btn btn-danger" />
                    </form>
                </div>
            }
        }
    </div>
</div>

<script src="~/layouts/horizontal-light-menu/loader.js"></script>
<script src="~/src/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/src/plugins/src/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="~/src/plugins/src/mousetrap/mousetrap.min.js"></script>
<script src="~/src/plugins/src/waves/waves.min.js"></script>
<script src="~/layouts/horizontal-light-menu/app.js"></script>
<script src="~/src/assets/js/apps/invoice-preview.js"></script>