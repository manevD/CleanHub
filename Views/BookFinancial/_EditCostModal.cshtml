@model CleanHub.Entities.BookFinancial

<div class="modal fade" id="editCostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form id="editCostForm">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Измени трошок</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Description">Опис</label>
                        <input asp-for="Description" class="form-control form-control-sm" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Owes">Износ</label>
                        <input asp-for="Owes" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        Зачувај
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
