@model CleanHub.ViewModels.BuildingViewModel

@{
    ViewData["Title"] = "Додај Објект";
}

<div class="tab-content" id="animateLineContent-4">
    <div class="tab-pane fade show active" id="animated-underline-home" role="tabpanel" aria-labelledby="animated-underline-home-tab">
        <div class="row">
            <form asp-action="Create" class="section general-info">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <h6 class="">Информации за Објектот</h6>
                <div class="row">
                    <div class="col-xl-10 col-lg-12 col-md-8 mt-md-0 mt-4">
                        <div class="form">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Име на Објект</label>
                                        <input asp-for="Name" class="form-control form-control-sm" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Резервен фонд</label>
                                        <input asp-for="ReserveFund" class="form-control form-control-sm" />
                                        <span asp-validation-for="ReserveFund" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Жиро Сметка</label>
                                        <input asp-for="BankAccount" class="form-control form-control-sm" />
                                        <span asp-validation-for="BankAccount" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <hr class="my-4">
                <div id="buildingProductsContainer">

                    @for (var i = 0; i < Model.BuildingProducts.Count; i++)
                    {
                        <div class="row product-row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label>Опис</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.ArticleNotes" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.ArticleNotes" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.ArticleNotes" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Ед.М</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.UnitOfMeasurement" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.UnitOfMeasurement" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.UnitOfMeasurement" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Данок</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.Tax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.Tax" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.Tax" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Кол.</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.Quantity" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.Quantity" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Цена без ДДВ</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.Price" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.Price" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Цена</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.PriceWithTax" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Вкупно</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.PriceWithTax" />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm">
                                <div class="form-group">
                                    <label>Вк.по лице</label>
                                    <input asp-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="form-control form-control-sm" value="@Model.BuildingProducts[i].Product.PriceWithTax" readonly />
                                    <span asp-validation-for="@Model.BuildingProducts[i].Product.PriceWithTax" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="form-group d-flex justify-content-between mt-3">
                    <input type="submit" value="Зачувај" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
