@using CleanHub.Entities
@using CleanHub.Entities.Enums
@model IEnumerable<CleanHub.ViewModels.BookFinancialInfoViewModel>
@{
    ViewData["Title"] = "Книжења";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var invoiceId = @ViewBag.InvoiceId;
    var owes = @ViewBag.TotalOwes;
    var demands = @ViewBag.TotalDemands;
    string result = "0";
    if (Model != null && Model.Any())
    {
        var difference = (demands - owes);
        if (demands > owes)
        {
            result = "Во претплата " + difference;
        }
        else
        {
            result = "Во минус " + (-difference);
        }
    }
}

<hr />
<form asp-action="Books" asp-controller="BookFinancial" method="get">
    <div class="row">
        @if (ViewBag.Buildings != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="buildingSearch">Објект</label>
                    <input class="form-control" list="buildingOptions" id="buildingSearch" name="buildingName"
                           placeholder="Пребарувај" value="@ViewBag.SelectedBuildingName">
                    <input type="hidden" id="buildingId" name="buildingId" value="@ViewBag.BuildingId">

                    <datalist id="buildingOptions">
                        @foreach (var building in (IEnumerable<SelectListItem>)ViewBag.Buildings)
                        {
                            <option value="@building.Text" data-id="@building.Value"></option>
                        }
                    </datalist>
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-2 col-md-3">
                <p>Нема пронајдено објекти!</p>
            </div>
        }

        @if (ViewBag.InvoiceTypList != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="invoiceId">Тип на сметка</label>
                    @Html.DropDownList("invoiceId", (IEnumerable<SelectListItem>)ViewBag.InvoiceTypList,
                             new { @class = "form-control", @id = "invoiceId" })
                </div>
            </div>

        }
        else
        {
            <div class="col-lg-2 col-md-3">
                <p>Нема пронајдено тип на сметка!</p>
            </div>
        }

       @*  @if (ViewBag.PaymentStatusList != null)
        {
            <div class="col-lg-2 col-md-3" id="paymentStatusContainer" style="display: none;">
                <div class="form-group mb-0">
                    <label for="paymentStatusId">Статус</label>
                    @Html.DropDownList("paymentStatusId", (IEnumerable<SelectListItem>)ViewBag.PaymentStatusList,
                             new { @class = "form-control", @id = "paymentStatusId" })
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-2 col-md-3">
                <p>Нема пронајдено статус!</p>
            </div>
        } *@

        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <label for="dateFrom">Од</label>
                <input id="dateFrom" name="dateFrom" placeholder="ден.месец.година" type="text" class="form-control flatpickr" value="@ViewBag.DateFrom" />
            </div>
        </div>

        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <label for="dateTo">До</label>
                <input id="dateTo" name="dateTo" placeholder="ден.месец.година" type="text" class="form-control flatpickr" value="@ViewBag.DateTo" />
            </div>
        </div>
    </div>
    </br> <!-- Optional: Trennlinie -->
    <div class="col-lg-2 col-md-3">
        <div class="form-group mb-0">
            <button type="submit" class="btn btn-primary w-100">Пребарувај</button>
        </div>
    </div>
</form>

<div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th data-sorter="false">Дата на издавање</th>
                        <th data-sorter="false">Опис</th>
                        <th data-sorter="false">Побарува</th>
                        <th data-sorter="false">Должи</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var invoice in Model.Where(x=> !x.Description.Contains("салдо")))
                        {
                            <tr role="row">
                                <td>@Html.DisplayFor(modelItem => invoice.FormattedDatumF)</td>
                                <td>@Truncate(invoice.Description, 40)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Demands) МКД</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Owes) МКД</td>
                            </tr>
                        }
                        <tr>
                            <th>Вкупно:</th>
                            <th colspan="">@result</th>
                            <th>@demands МКД</th>
                            <th>@owes МКД</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="" class="text-center">Нема пронајдени податоци</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Вкупно:</th>
                        <th colspan="">@result</th>
                        <th>@demands МКД</th>
                        <th>@owes МКД</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input.Length > maxLength ? input.Substring(0, maxLength) + "..." : input;
    }
}
<script>
    document.getElementById('buildingSearch').addEventListener('input', function () {
        const selectedValue = this.value;
        const options = document.querySelectorAll('#buildingOptions option');
        let selectedId = '';

        // Find the matching option and get its data-id
        options.forEach(option => {
            if (option.value === selectedValue) {
                selectedId = option.getAttribute('data-id');
            }
        });

        // Set the hidden input's value
        document.getElementById('buildingId').value = selectedId || '';
    });

    document.addEventListener("DOMContentLoaded", function () {
        const invoiceDropdown = document.getElementById("invoiceId");
        const paymentStatusContainer = document.getElementById("paymentStatusContainer");

        // Function to toggle visibility
        function togglePaymentStatus() {
            if (invoiceDropdown.value === "1200") {
                paymentStatusContainer.style.display = "block";
            } else {
                paymentStatusContainer.style.display = "none";
            }
        }

        // Initial check on page load
        togglePaymentStatus();

        // Event listener for dropdown change
        invoiceDropdown.addEventListener("change", togglePaymentStatus);
    });
</script>

