@using CleanHub.ViewModels
@model List<CleanHub.ViewModels.BuildingsCardViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<hr />
<form asp-action="Buildings" asp-controller="Cards" method="get" id="filterForm">
    <div class="row">
        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <h6>Од</h6>
                <input id="dateFrom" name="dateFrom" placeholder="ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateFrom" />
            </div>
        </div>
        <div class="col-lg-2 col-md-3">
            <h6>До</h6>
            <div class="form-group mb-0">
                <input id="dateTo" name="dateTo" placeholder=" ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateTo" />
            </div>
        </div>
    </div>
    <br />
    <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
        <div class="form-group mb-0">
            <button type="submit" class="btn btn-primary">Пребарувај</button>
        </div>
    </div>
</form>

<div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">
    </br>
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr role="row">
                        <th>Име</th>
                        <th>Уплата</th>
                        <th>Рез.Фонд</th>
                        <th>Трошок</th>
                        <th>Уплата-Р.Ф</th>
                        <th>Салдо</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var invoice in Model)
                        {
                            <tr role="row">
                                <td>@Html.DisplayFor(modelItem => invoice.Name)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.PayedMoney)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.ReserveFund)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Cost)</td>
                            </tr>
                        }
                        <tr role="row">
                            <td></td>
                            <td>Уплата: @GetTotalPayedMoney(Model)</td>
                            <td>Рез. фонд: @GetTotalReserveFund(Model)</td>
                            <td>Трошок: @GetTotalCost(Model)</td>
                            <td>Уплата-Р.Ф.: @GetPayedMinusReserve(Model)</td>
                            <td>Салдо: @GetSaldo(Model)</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">Нема пронајдени податоци</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                <tr>
                    <th></th>
                    <th>Уплата: @GetTotalPayedMoney(Model)</th>
                    <th>Рез. фонд: @GetTotalReserveFund(Model)</th>
                    <th>Трошок: @GetTotalCost(Model)</th>
                    <th>Уплата-Р.Ф.: @GetPayedMinusReserve(Model)</th>
                    <th>Салдо: @GetSaldo(Model)</th>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@functions {
    double GetTotalPayedMoney(List<BuildingsCardViewModel> models) => models.Sum(x => x.PayedMoney);
    double GetTotalReserveFund(List<BuildingsCardViewModel> models) => models.Sum(x => x.ReserveFund);
    double GetTotalCost(List<BuildingsCardViewModel> models) => models.Sum(x => x.Cost);
    double GetPayedMinusReserve(List<BuildingsCardViewModel> models) => GetTotalPayedMoney(models) - GetTotalReserveFund(models);
    double GetSaldo(List<BuildingsCardViewModel> models) => GetTotalReserveFund(models) - GetTotalCost(models);
}
