@using CleanHub.Entities.Enums
@using CleanHub.Extensions
@using CleanHub.ViewModels
@model List<CleanHub.ViewModels.DocumentViewModel>

@{
    ViewData["Title"] = "Сметки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="font-size:10px;">
    <div class="row">

        <!-- 🔹 SIDEBAR -->
        <div class="col-lg-2 col-md-3">
            <div class="card p-2 h-100" style="position: sticky; top:20px; font-size:10px;">

                <form asp-action="InvoiceFiltered" asp-controller="Documents" method="get" id="filterForm">

                    <h5 class="mb-3" style="font-size:10px;">Филтер</h5>

                    @if (ViewBag.Buildings != null)
                    {
                        <div class="form-group mb-3">
                            <label style="font-size:10px;">Објект</label>
                            <input class="form-control" style="font-size:10px;" list="buildingOptions" id="buildingSearch"
                                   name="buildingName" value="@ViewBag.SelectedBuildingName">

                            <input type="hidden" id="buildingId" name="buildingId" value="@ViewBag.BuildingId">

                            <datalist id="buildingOptions">
                                @foreach (var b in (IEnumerable<SelectListItem>)ViewBag.Buildings)
                                {
                                    <option value="@b.Text" data-id="@b.Value"></option>
                                }
                            </datalist>
                        </div>
                    }

                    @if (ViewBag.PaymentStatusList != null)
                    {
                        <div class="form-group mb-3">
                            <label style="font-size:10px;">Статус</label>
                            @Html.DropDownList("paymentStatusId",
                                 (IEnumerable<SelectListItem>)ViewBag.PaymentStatusList,
                                 new { @class = "form-control", style = "font-size:10px;", id = "paymentStatusId" })
                        </div>
                    }

                    <div class="form-group mb-3">
                        <label style="font-size:10px;">Година</label>
                        <select name="year" class="form-control" style="font-size:10px;">
                            @{
                                var currentYear = DateTime.Now.Year;
                                for (int y = 2019; y <= currentYear; y++)
                                {
                                    <option value="@y" selected="@(ViewBag.Year == y ? "selected" : null)">
                                        @y
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2" style="font-size:10px;">
                        Пребарувај
                    </button>

                    <button type="button" class="btn btn-secondary w-100" id="navigateButton" style="font-size:10px;">
                        Извади сметки
                    </button>

                </form>
            </div>
        </div>

        <!-- 🔹 RIGHT SIDE -->
        <div class="col-lg-10 col-md-9 ps-0 pe-1">

            <!-- ✅ TABLE 2 -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-content widget-content-area">
                    <table class="table table-bordered table-sm table-compact w-100" style="font-size:10px;">
                        <thead>
                            <tr>
                                <th>Партнер</th>
                                
                                <th>Должи</th>
                                <th>Побарува</th>
                                <th>Салдо</th>

                                <th>Јан</th>
                                <th>Фев</th>
                                <th>Мар</th>
                                <th>Апр</th>
                                <th>Мај</th>
                                <th>Јун</th>
                                <th>Јул</th>
                                <th>Авг</th>
                                <th>Сеп</th>
                                <th>Окт</th>
                                <th>Ное</th>
                                <th>Дек</th>

                                <th>Вкупно</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (ViewBag.Customers != null && ViewBag.CustomerBalances != null)
                            {
                                var customers = (IEnumerable<dynamic>)ViewBag.Customers;
                                var balances = (IEnumerable<dynamic>)ViewBag.CustomerBalances;

                                foreach (var c in customers)
                                {
                                    var cusBalance = balances.FirstOrDefault(b => b.Customer.Id == c.Id);
                                    var docs = ViewBag.Docs as List<CleanHub.ViewModels.DocumentViewModel>;

                                    var customerInvoices = docs?
                                        .Where(x => x.CustomerId == c.Id)
                                        .ToList()
                                        ?? new List<CleanHub.ViewModels.DocumentViewModel>();

                                    <tr>
                                        <td>@c.CustomerInfo</td>
                                        <td style="color:red">@cusBalance?.Dolzi</td>
                                        <td style="color:blue">@cusBalance?.Pobaruva</td>
                                        <td style="color:green">@cusBalance?.Saldo</td>

                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            var monthName = new DateTime(ViewBag.Year, m, 1)
                                                            .ToString("MMMM", new System.Globalization.CultureInfo("mk-MK"));

                                            var monthly = customerInvoices
                                                .Where(x =>
                                                    x.ToDocument != null &&
                                                    x.ToDocument.IndexOf(monthName, StringComparison.OrdinalIgnoreCase) >= 0 &&
                                                    x.ToDocument.IndexOf(ViewBag.Year.ToString(), StringComparison.OrdinalIgnoreCase) >= 0 &&
                                                    x.PaymentStatus == 0 // nur wenn PaymentStatus 0
                                                )
                                                .Sum(x => x.TotalOutput ?? 0);

                                            <td>@(monthly == 0 ? "0" : monthly.ToString())</td>
                                        }

                                        <td style="font-weight:bold">
                                            @customerInvoices.Sum(x => x.TotalOutput)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="17" class="text-center">Нема корисници</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ✅ TABLE 1 -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-content widget-content-area">
                    <table id="html5-extension" class="table dt-table-hover w-100" style="font-size:10px;">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Бр.</th>
                                <th>Станар</th>
                                <th>Претплата</th>
                                <th>Вкупно</th>
                                <th>Сметка</th>
                                <th>Статус</th>
                                <th>Опис на плаќање</th>
                                <th>Дата на плаќање</th>
                                <th>Платено на</th>
                                <th>Тип на плаќање</th>
                                <th>Број на плаќање</th>
                                <th>Функции</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                var counter = 0;
                                foreach (var invoice in Model.OrderBy(x => x.Date))
                                {
                                    counter++;
                                    <tr>
                                        <td><input type="checkbox" class="invoice-check" value="@invoice.Id" /></td>
                                        <td>@counter</td>
                                        <td>@invoice.Customer?.CustomerInfo</td>
                                        <td>@invoice.Customer?.Subscription</td>
                                        <td>@invoice.TotalOutput МКД</td>
                                        <td>@invoice.ToDocument</td>

                                        <td>
                                            @switch (invoice.PaymentStatus)
                                            {
                                                case PaymentStatus.Платено:
                                                    <span class="badge badge-light-success">@invoice.PaymentStatus</span>
                                                    break;
                                                case PaymentStatus.Неплатено:
                                                case PaymentStatus.Делумно:
                                                    <span class="badge badge-light-warning">@invoice.PaymentStatus</span>
                                                    break;
                                                case PaymentStatus.Задоцнето:
                                                    <span class="badge badge-light-danger">@invoice.PaymentStatus</span>
                                                    break;
                                            }
                                        </td>

                                        <td>@invoice.PaymentDescription</td>
                                        <td>@invoice.DateReceived?.ToString("dd.MM.yyyy")</td>
                                        <td>@invoice.PaymentDate?.ToString("dd.MM.yyyy")</td>
                                        <td>@invoice.PaymentType.GetEnumDescription()</td>
                                        <td>@invoice.PaymentNumber </td>

                                        <td>
                                            <a asp-action="Details" asp-route-id="@invoice.Id"
                                                   class="badge badge-light-primary">
                                                👁
                                            </a>
                                            @if (invoice.PaymentStatus == PaymentStatus.Неплатено)
                                            {

                                                <a href="#"
                                                       class="badge badge-light-primary set-paid-btn"
                                                       data-id="@invoice.Id">
                                                    Стави како платено
                                                </a>
                                            }
                                           
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center">Нема податоци</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 🔹 ACTIONS -->
            <div class="d-flex gap-3 mt-3" style="font-size:10px;">
                @if (Model != null && Model.Any(x => x.PaymentStatus == PaymentStatus.Неплатено))
                {
                    <form asp-action="SetMultiplePayments" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="selectedInvoices" name="SelectedInvoiceIds" />

                        <button type="button" class="btn btn-dark"
                                data-bs-toggle="modal" data-bs-target="#multiPaymentModal" style="font-size:10px;">
                            Плати селектирани
                        </button>
                        <div class="modal fade" id="multiPaymentModal" tabindex="-1" role="dialog" aria-labelledby="multiPaymentModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Плати повеќе фактури</h5>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label for="paymentType">Тип на плаќање</label>
                                            <select id="paymentType" name="PaymentType" class="form-control form-control-sm">
                                                @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                                                {
                                                    <option value="@((int)paymentType)">@paymentType.GetEnumDescription()</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDate">Дата на плаќање</label>
                                            <input type="date" id="paymentDate" name="PaymentDate" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentNumber">Број на плаќање</label>
                                            <input type="text" id="paymentNumber" name="PaymentNumber" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDescription">Опис</label>
                                            <input type="text" id="paymentDescription" name="PaymentDescription" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary">Плати селектирани</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                <form id="deleteForm" asp-action="DeleteMultipleDocuments" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="selectedInvoicesForDelete" name="SelectedInvoiceIds" />

                    <button type="submit" class="btn btn-danger" style="font-size:10px;">
                        Избриши селектирани
                    </button>
                </form>

                @if (Model != null && Model.Any(x => x.PaymentStatus == PaymentStatus.Платено))
                {
                    <form asp-action="ChangePaymentMultipleDocuments" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="selectedInvoicesMultipleChange" name="SelectedInvoiceIds" />

                        <button type="button" class="btn btn-secondary"
                                data-bs-toggle="modal" data-bs-target="#multiChangeModal" style="font-size:10px;">
                            Измени плаќање
                        </button>
                        <div class="modal fade" id="multiChangeModal" tabindex="-1" role="dialog" aria-labelledby="multiChangeModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Измени плаќање</h5>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label for="paymentType">Тип на плаќање</label>
                                            <select id="paymentType" name="PaymentType" class="form-control form-control-sm">
                                                @foreach (var paymentType in Enum.GetValues(typeof(PaymentType)).Cast<PaymentType>())
                                                {
                                                    <option value="@((int)paymentType)">@paymentType.GetEnumDescription()</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDate">Дата на плаќање</label>
                                            <input type="date" id="paymentDate" name="PaymentDate" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentNumber">Број на плаќање</label>
                                            <input type="text" id="paymentNumber" name="PaymentNumber" class="form-control form-control-sm" />
                                        </div>
                                        <div class="form-group">
                                            <label for="paymentDescription">Опис</label>
                                            <input type="text" id="paymentDescription" name="PaymentDescription" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary"> Измени плаќање</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                }

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener("load", function () {

            // ==========================
            // 1. Filter / Navigation
            // ==========================
            const form = document.getElementById("filterForm");
            const navigateButton = document.getElementById("navigateButton");

            if (form && navigateButton) {
                const searchButton = form.querySelector('button[type="submit"]');
                const originalAction = form.action;

                navigateButton.addEventListener("click", function () {
                    form.action = "/Documents/CombineAndDownloadPdfs"; // ❗ kein Razor mehr
                    form.submit();
                });

                if (searchButton) {
                    searchButton.addEventListener("click", function () {
                        form.action = originalAction;
                    });
                }
            }

            // ==========================
            // 2. Building Search
            // ==========================
            const buildingSearch = document.getElementById('buildingSearch');
            if (buildingSearch) {
                buildingSearch.addEventListener('input', function () {
                    const selected = [...document.querySelectorAll('#buildingOptions option')]
                        .find(o => o.value === this.value);

                    const hidden = document.getElementById('buildingId');
                    if (hidden) hidden.value = selected ? selected.dataset.id : '';
                });
            }

            // ==========================
            // 3. SELECTED CHECKBOXES
            // ==========================
            function getSelectedInvoices() {
                return [...document.querySelectorAll('.invoice-check:checked')]
                    .map(cb => cb.value);
            }

            // ==========================
            // 4. PAY (Плати селектирани)
            // ==========================
            document.querySelectorAll('[data-bs-target="#multiPaymentModal"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    const selected = getSelectedInvoices();
                    const input = document.getElementById('selectedInvoices');

                    if (input) input.value = selected.join(',');

                    if (selected.length === 0) {
                        alert('Немате селектирано фактури!');
                    }
                });
            });

            // ==========================
            // 5. CHANGE PAYMENT
            // ==========================
            document.querySelectorAll('[data-bs-target="#multiChangeModal"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    const selected = getSelectedInvoices();
                    const input = document.getElementById('selectedInvoicesMultipleChange');

                    if (input) input.value = selected.join(',');

                    if (selected.length === 0) {
                        alert('Немате селектирано фактури!');
                    }
                });
            });

            // ==========================
            // 6. DELETE
            // ==========================
            const deleteForm = document.getElementById('deleteForm');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    const selected = getSelectedInvoices();
                    const input = document.getElementById('selectedInvoicesForDelete');

                    if (input) input.value = selected.join(',');

                    if (selected.length === 0) {
                        e.preventDefault();
                        alert('Немате селектирано фактури за бришење!');
                    }
                });
            }

        });

                document.querySelectorAll('.set-paid-btn').forEach(btn => {
            btn.addEventListener('click', function () {

                const id = this.dataset.id;
                const year = document.querySelector('[name="year"]').value;
                const buildingId = document.getElementById('buildingId').value;
                const buildingName = document.getElementById('buildingSearch').value;
                const paymentStatusId = document.getElementById('paymentStatusId').value;

                const url = `/Documents/JustSetDocumentPayedStatus?id=${id}`
                    + `&year=${year}`
                    + `&buildingId=${buildingId}`
                    + `&buildingName=${encodeURIComponent(buildingName)}`
                    + `&paymentStatusId=${paymentStatusId}`;

                window.location.href = url;
            });
        });
    </script>

}
