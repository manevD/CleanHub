@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, Initial-scale=1, maximum-scale=1, shrink-to-fit=no">
    <title>CleanHub </title>

    <link href="~/layouts/horizontal-light-menu/css/light/loader.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <script src="~/layouts/horizontal-light-menu/loader.js" defer></script>

    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="~/src/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/layouts/horizontal-light-menu/css/light/plugins.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flatpickr.min.css" asp-append-version="true" />

    <!-- END GLOBAL MANDATORY STYLES -->
    <!-- BEGIN PAGE LEVEL PLUGINS/CUSTOM STYLES -->

    <link rel="stylesheet" type="text/css" href="~/src/plugins/src/table/datatable/datatables.css" asp-append-version="true">

    <link rel="stylesheet" type="text/css" href="~/src/plugins/css/light/table/datatable/dt-global_style.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/src/plugins/css/light/table/datatable/custom_dt_miscellaneous.css" asp-append-version="true">


    <link href="~/src/assets/css/light/apps/invoice-add.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/src/assets/css/light/scrollspyNav.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link rel="stylesheet" href="~/src/plugins/src/font-icons/fontawesome/css/regular.css" asp-append-version="true">
    <link rel="stylesheet" href="~/src/plugins/src/font-icons/fontawesome/css/fontawesome.css" asp-append-version="true" />
    <link href="~/src/plugins/css/light/filepond/custom-filepond.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/src/assets/css/light/components/carousel.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/src/assets/css/light/components/modal.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/src/plugins/css/light/loaders/custom-loader.css" rel="stylesheet" type="text/css" />

</head>

<body layout="full-width">
    <!-- BEGIN LOADER -->
    <div id="load_screen">
        <div class="loader">
            <div class="loader-content">
                <div class="spinner-grow text-info align-self-center loader-lg">Loading...</div>
            </div>
        </div>
    </div>
    <!--  END LOADER -->
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="header-container container-xxl">

            <partial name="_HeaderNav.cshtml" />
        </div>
    }
<div class="main-container " id="container">

    <div class="overlay"></div>
    <div class="search-overlay"></div>

    <!--  BEGIN SIDEBAR  -->
    <div class="sidebar-wrapper sidebar-theme">
        @if (SignInManager.IsSignedIn(User))
        {
            <partial name="_NavMenu" />
        }
    </div>

    <div id="content" class="main-content">
        <div class="layout-px-spacing">
            <div class="middle-content p-0">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>

    <script src="~/src/plugins/src/global/vendors.min.js" defer></script>
    <script src="~/src/bootstrap/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/src/plugins/src/perfect-scrollbar/perfect-scrollbar.min.js" defer></script>
    <script src="~/src/plugins/src/mousetrap/mousetrap.min.js" defer></script>
    <script src="~/src/plugins/src/waves/waves.min.js" defer></script>
    <script src="~/layouts/horizontal-light-menu/app.js" defer></script>
    <script src="~/src/plugins/src/flatpickr/flatpickr.js" defer></script>
    <script src="~/src/plugins/src/flatpickr/custom-flatpickr.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>

    <!-- Ensure necessary plugins are loaded before custom scripts -->
    <!-- Custom scripts -->

    <script src="~/layouts/horizontal-light-menu/loader.js" defer></script>
    <script src="~/src/plugins/src/filepond/filepond.min.js" defer></script>

    <!-- DataTable scripts -->
    <script src="~/src/plugins/src/table/datatable/custom_miscellaneous.js" defer></script>
    <script src="~/src/plugins/src/table/datatable/datatables.js" defer></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/dataTables.buttons.min.js" defer></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/jszip.min.js" defer></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/buttons.html5.min.js" defer></script>
    <script src="~/src/plugins/src/table/datatable/button-ext/buttons.print.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/filepond.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/FilePondPluginFileValidateType.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/FilePondPluginImageExifOrientation.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/FilePondPluginImagePreview.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/FilePondPluginImageCrop.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/FilePondPluginImageResize.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/FilePondPluginImageTransform.min.js" defer></script>
    <script src="~/src/plugins/src/filepond/filepondPluginFileValidateSize.min.js" defer></script>
    <script src="~/src/assets/js/apps/invoice-add.js" defer></script>

<script>
        // Function to show the loader and redirect after a delay
        function showLoaderAndRedirect(redirectUrl) {
            // Show the loader
            document.getElementById('load_screen').style.display = 'block';

            // Set a delay for the redirect to simulate loading
            setTimeout(function() {
                window.location.href = redirectUrl;
            }, 150); // Adjust time as needed
        }

        // Example: Call this function when redirect is needed
        // showLoaderAndRedirect('/your/redirect/url');
    </script>

    <!-- END PAGE LEVEL SCRIPTS -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
