@using CleanHub.Entities
@using CleanHub.Entities.Enums
@model IEnumerable<CleanHub.Entities.Customer>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<hr />

<form asp-action="BuildingInvoice1200" asp-controller="Cards" method="get">
    <div class="row">

        @if (ViewBag.Buildings != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">

                    <label for="buildingSearch">Објект</label>

                    <input class="form-control"
                           list="buildingOptions"
                           id="buildingSearch"
                           name="buildingName"
                           placeholder="Пребарувај"
                           value="@ViewBag.SelectedBuildingName">

                    <input type="hidden"
                           id="buildingId"
                           name="buildingId"
                           value="@ViewBag.BuildingId">

                    <datalist id="buildingOptions">
                        @foreach (var building in (IEnumerable<SelectListItem>)ViewBag.Buildings)
                        {
                            <option value="@building.Text"
                                    data-id="@building.Value"></option>
                        }
                    </datalist>

                </div>
            </div>
        }
        else
        {
            <p>Нема пронајдено партнери!</p>
        }

    </div>

    <br />

    <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
        <div class="form-group mb-0">
            <button type="submit" class="btn btn-primary">
                Пребарувај
            </button>
        </div>
    </div>
</form>

<div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">

    <br />

    <div class="statbox widget box box-shadow">

        <div class="widget-content widget-content-area">

            <table id="html5-extension"
                   class="table dt-table-hover"
                   style="width:100%">

                <thead>
                    <tr>
                        <th data-sorter="false">Бр.</th>
                        <th data-sorter="false">Партнер</th>
                        <th data-sorter="false">Побарува</th>
                        <th data-sorter="false">Должи</th>
                        <th data-sorter="false">Салдо</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var counter = 0;
                        double sumPobaruva = 0;
                        float sumDolzi = 0;
                        @foreach (var customer in Model.OrderBy(x => x.Id))
                        {
                            var docs = customer.Documents
                                ?? Enumerable.Empty<Document>();
                            var bookFinancials = customer.BookFinancials ?? Enumerable.Empty<BookFinancial>();
                            // Должи
                            var dolzi = docs.Where(x => x.TotalOutput != 0 && x.Date >= new DateOnly(2021, 1, 1))
                                .Sum(x => x.TotalOutput ?? 0);

                            // Побарува
                            var pobaruva = bookFinancials.Sum(x => x.Demands) ;
                            if (bookFinancials.Any(x => x.Owes != 0 && x.DatumF >= new DateOnly(2021, 1, 1)))
                            {
                                dolzi += (float)bookFinancials.Where(x => x.Owes != 0 && x.DatumF >= new DateOnly(2021, 1, 1)).Sum(x => x.Owes);
                            }
                            sumPobaruva += pobaruva;
                            sumDolzi += dolzi;
                            // Салдо
                            var saldo = pobaruva - dolzi;

                            counter++;

                            <tr>

                                <td>@counter</td>

                                <td>
                                    @customer.CustomerInfo
                                </td>

                                <td>
                                    @pobaruva.ToString("0.00") МКД
                                </td>

                                <td>
                                    @dolzi.ToString("0.00") МКД
                                </td>

                                <td style="color:@(saldo < 0 ? "red" : "green");
                                    font-weight:bold;">

                                    @saldo.ToString("+0.00;-0.00;0.00")

                                </td>

                            </tr>
                        }

                        <tr style="font-weight:bold;
                            background:#f1f1f1;">

                            <td>Вкупно</td>

                            <td></td>

                            <td>
                                Побарува :
                                @sumPobaruva.ToString("0.00") МКД
                            </td>

                            <td>
                                Должи :
                                @sumDolzi.ToString("0.00") МКД
                            </td>

                            <td style="color:@((sumPobaruva - sumDolzi) < 0 ? "red" : "green");
                                font-weight:bold;">

                                Разлика :
                                @((sumPobaruva - sumDolzi).ToString("+0.00;-0.00;0.00"))
                            </td>

                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center">
                                Нема пронајдени податоци
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

    document.getElementById('buildingSearch')
        .addEventListener('input', function () {

            const selectedValue = this.value;

            const options = document.querySelectorAll(
                '#buildingOptions option'
            );

            let selectedId = '';

            options.forEach(option => {

                if (option.value === selectedValue) {

                    selectedId =
                        option.getAttribute('data-id');
                }
            });

            document.getElementById('buildingId').value =
                selectedId || '';
        });

</script>