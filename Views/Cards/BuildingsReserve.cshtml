@model CleanHub.ViewModels.CardsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<hr />
<form asp-action="BuildingsReserve" asp-controller="Cards" method="get">
    <div class="row">
        @if (ViewBag.Buildings != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="buildingSearch">Објект</label>
                    <input class="form-control" list="buildingOptions" id="buildingSearch" name="buildingName"
                           placeholder="Пребарувај" value="@ViewBag.SelectedBuildingName">
                    <input type="hidden" id="buildingId" name="buildingId" value="@ViewBag.BuildingId">

                    <datalist id="buildingOptions">
                        @foreach (var building in (IEnumerable<SelectListItem>)ViewBag.Buildings)
                        {
                            <option value="@building.Text" data-id="@building.Value"></option>
                        }
                    </datalist>
                </div>
            </div>
        }
        else
        {
            <p>Нема пронајдено партнери!</p>
        }

        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <h6>Од</h6>
                <input id="dateFrom" name="dateFrom" placeholder="ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateFrom" />
            </div>
        </div>
        <div class="col-lg-2 col-md-3">
            <h6>До</h6>
            <div class="form-group mb-0">
                <input id="dateTo" name="dateTo" placeholder="ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateTo" />
            </div>
        </div>
    </div>
    <br />
    <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
        <div class="form-group mb-0">
            <button type="submit" class="btn btn-primary">Пребарувај</button>
        </div>
    </div>
</form>
<div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">
    </br>
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                <th data-sorter="false">Бр.</th>
                <th data-sorter="false">Опис</th>
                <th data-sorter="false">Побарува</th>
                <th data-sorter="false">Должи</th>
                <th data-sorter="false">Дата на издавање</th>
                </thead>
                <tbody>
                    @if (Model.BuildingFinancial != null && Model.BuildingFinancial.Any())
                    {
                        var counter = 0;
                        @foreach (var invoice in Model.BuildingFinancial.OrderBy(x => x.DatumF))
                        {
                            counter++;
                            <tr role="row">
                                <td>@counter</td>
                                <td>@Truncate(invoice.Description,40)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Demands) МКД</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Owes) МКД</td>
                                <td>@Html.DisplayFor(modelItem => invoice.FormattedDatumF)</td>
                            </tr>
                        }
                        <tr role="row">
                            <td>Вкупно</td>
                            <td></td>
                            <td></td>
                            <td>Должи : @Model.BuildingFinancial.Sum(x=>x.Owes)</td>
                            @if (@Model.CustomerOwesTotal > @Model.CustomerDemandsTotal)
                            {
                                <td>Салдо :- @Model.Total</td>
                            }
                            else
                            {
                                <td>Салдо :@Model.Total</td>
                            }
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">Нема пронајдени податоци</td>
                        </tr>
                    }
                </tbody>
               @*  <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th>Побарува : @Model.CustomerDemandsTotal</th>
                    <th>Должи : @Model.CustomerOwesTotal</th>
                    @if (@Model.CustomerOwesTotal > @Model.CustomerDemandsTotal)
                    {
                        <th>Салдо :- @Model.Total</th>
                    }
                    else
                    {
                        <th>Салдо :@Model.Total</th>
                    }
                </tr>
                </tfoot> *@
            </table>
        </div>
    </div>
</div>
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input.Length > maxLength ? input.Substring(0, maxLength) + "..." : input;
    }
}
<script>
    document.getElementById('buildingSearch').addEventListener('input', function () {
        const selectedValue = this.value;
        const options = document.querySelectorAll('#buildingOptions option');
        let selectedId = '';

        // Find the matching option and get its data-id
        options.forEach(option => {
            if (option.value === selectedValue) {
                selectedId = option.getAttribute('data-id');
            }
        });

        // Set the hidden input's value
        document.getElementById('buildingId').value = selectedId || '';
    });
</script>