@model CleanHub.ViewModels.CustomerCard1200ViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<hr />
<form asp-action="Customers" asp-controller="Cards" method="get">
    <div class="row">
        @if (ViewBag.Customers != null)
        {
            <div class="col-lg-2 col-md-3">
                <div class="form-group mb-0">
                    <label for="customerSearch">Партнер</label>
                    <input class="form-control" list="customerOptions" id="customerSearch" name="customerName" placeholder="Пребарувај">
                    <input type="hidden" id="customerId" name="customerId">
                    <datalist id="customerOptions">
                        @foreach (var customer in (IEnumerable<SelectListItem>)ViewBag.Customers)
                        {
                            <option value="@customer.Text" data-id="@customer.Value"></option>
                        }
                    </datalist>
                </div>
            </div>
        }
        else
        {
            <p>Нема пронајдено партнери!</p>
        }

        <div class="col-lg-2 col-md-3">
            <div class="form-group mb-0">
                <h6>Од</h6>
                <input id="dateFrom" name="dateFrom" placeholder="ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateFrom" />
            </div>
        </div>
        <div class="col-lg-2 col-md-3">
            <h6>До</h6>
            <div class="form-group mb-0">
                <input id="dateTo" name="dateTo" placeholder="ден.месец.година" type="text" class="form-control flatpickr flatpickr-input active" value="@ViewBag.DateTo" />
            </div>
        </div>
    </div>
    <br />
    <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6">
        <div class="form-group mb-0">
            <button type="submit" class="btn btn-primary">Пребарувај</button>
        </div>
    </div>
</form>
<div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <table id="html5-extension" class="table dt-table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Налог</th>
                        <th>Датум</th>
                        <th>Број</th>
                        <th>Опис</th>
                        <th>Вид док.</th>
                        <th>Побарува</th>
                        <th>Должи</th>
                        <th>Салдо</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.CustomerData != null && Model.CustomerData.Any())
                    {
                        @foreach (var invoice in Model.CustomerData)
                        {
                            <tr role="row">
                                <td>@Html.DisplayFor(modelItem => invoice.NumberNalog)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Date)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Number)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Description)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.DocumentTyp)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Demands)</td>
                                <td>@Html.DisplayFor(modelItem => invoice.Owes)</td>
                                <td></td>
                            </tr>
                        }
                        <tr role="row">
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td><strong>Вкупно</strong></td>
                            <td><strong>Побарува : @Model.CustomerDemandsTotal</strong></td>
                            <td><strong>Должи : @Model.CustomerOwesTotal</strong></td>
                            <td>
                                <strong>
                                    Салдо :
                                    @(Model.CustomerOwesTotal > Model.CustomerDemandsTotal ? "-" : "")
                                    @Model.Total
                                </strong>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">Нема пронајдени податоци</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th><strong>Вкупно</strong></th>
                        <th><strong>Побарува : @Model.CustomerDemandsTotal</strong></th>
                        <th><strong>Должи : @Model.CustomerOwesTotal</strong></th>
                        <th>
                            <strong>
                                Салдо :
                                @(Model.CustomerOwesTotal > Model.CustomerDemandsTotal ? "-" : "")
                                @Model.Total
                            </strong>
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('customerSearch').addEventListener('input', function () {
        const selectedValue = this.value;
        const options = document.querySelectorAll('#customerOptions option');
        let selectedId = '';

        // Find the matching option and get its data-id
        options.forEach(option => {
            if (option.value === selectedValue) {
                selectedId = option.getAttribute('data-id');
            }
        });

        // Set the hidden input's value
        document.getElementById('customerId').value = selectedId || '';
    });
</script>